# KubeDash dev environment — single source of truth for shared values.
#
# These match the Flask backend's defaults in backend/app/core/config.py, so
# the app's KUBEDASH_DATABASE_URL / KUBEDASH_REDIS_URL work with zero change.
#
# To change ports (e.g. host already runs Postgres), bump the *_PORT values
# below AND set the matching KUBEDASH_*_URL on the host process.

KUBEDASH_DB_USER=kubedash
KUBEDASH_DB_PASSWORD=kubedash
KUBEDASH_DB_NAME=kubedash

POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686
