      "targets": [{"refId": "A", "expr": "(sum(kubedash_unit_failed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_smoke_failed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_e2e_failed{job=~\"$job\"}) or vector(0))", "legendFormat": "failed", "queryType": "instant", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}}]
