      "targets": [
        {"refId": "A", "expr": "(sum(kubedash_unit_passed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_smoke_passed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_e2e_passed{job=~\"$job\"}) or vector(0))", "legendFormat": "passed", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}},
        {"refId": "B", "expr": "(sum(kubedash_unit_failed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_smoke_failed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_e2e_failed{job=~\"$job\"}) or vector(0))", "legendFormat": "failed", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}},
        {"refId": "C", "expr": "(sum(kubedash_unit_error{job=~\"$job\"}) or vector(0)) + (sum(kubedash_smoke_error{job=~\"$job\"}) or vector(0)) + (sum(kubedash_e2e_error{job=~\"$job\"}) or vector(0))", "legendFormat": "error", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}}
