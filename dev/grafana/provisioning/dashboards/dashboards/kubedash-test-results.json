      "targets": [{"refId": "A", "expr": "(sum(kubedash_unit_error{job=~\"$job\"}) or vector(0)) + (sum(kubedash_smoke_error{job=~\"$job\"}) or vector(0)) + (sum(kubedash_e2e_error{job=~\"$job\"}) or vector(0))", "legendFormat": "error", "queryType": "instant", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}}]
