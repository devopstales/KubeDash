        {"refId": "B", "expr": "max(kubedash_unit_last_success_timestamp_seconds{job=~\"$job\"}) or max(kubedash_smoke_last_success_timestamp_seconds{job=~\"$job\"}) or max(kubedash_e2e_last_success_timestamp_seconds{job=~\"$job\"})", "format": "table", "instant": true, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}}
      ]
