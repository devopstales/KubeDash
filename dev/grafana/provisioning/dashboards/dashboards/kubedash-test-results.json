    {
      "type": "stat",
      "title": "Status",
      "description": "Last run outcome. The query returns 1/2/3 for succeeded/failed/errored; the value mapping turns that into a colored word. No label expansion needed, so it always renders.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {
              "1": {"text": "PASSED", "color": "green"},
              "2": {"text": "FAILED", "color": "red"},
              "3": {"text": "ERROR", "color": "orange"}
            }}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "A", "expr": "(max(kubedash_unit_info{status=\"succeeded\",job=~\"$job\"}) or max(kubedash_smoke_info{status=\"succeeded\",job=~\"$job\"}) or max(kubedash_e2e_info{status=\"succeeded\",job=~\"$job\"}) or vector(0)) + (max(kubedash_unit_info{status=\"failed\",job=~\"$job\"}) or max(kubedash_smoke_info{status=\"failed\",job=~\"$job\"}) or max(kubedash_e2e_info{status=\"failed\",job=~\"$job\"}) or vector(0)) * 1 + (max(kubedash_unit_info{status=\"errored\",job=~\"$job\"}) or max(kubedash_smoke_info{status=\"errored\",job=~\"$job\"}) or max(kubedash_e2e_info{status=\"errored\",job=~\"$job\"}) or vector(0)) * 2", "queryType": "instant", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}}
      ]
    },
    {
      "type": "stat",
      "title": "Passed",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "(sum(kubedash_unit_passed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_smoke_passed{job=~\"$job\"}) or vector(0)) + (sum(kubedash_e2e_passed{job=~\"$job\"}) or vector(0))", "legendFormat": "passed", "queryType": "instant", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}}]
