      "targets": [{"refId": "A", "expr": "(sum(kubedash_unit_skipped{job=~\"$job\"}) or vector(0)) + (sum(kubedash_smoke_skipped{job=~\"$job\"}) or vector(0)) + (sum(kubedash_e2e_skipped{job=~\"$job\"}) or vector(0))", "legendFormat": "skipped", "queryType": "instant", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}}]
