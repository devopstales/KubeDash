        "tags": [
          "api.auth"
        ]
      }
    },
    "/api/v1/auth/local": {
      "post": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/RESPONSE_UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/RESPONSE_DEFAULT_ERROR"
          },
          "302": {
            "$ref": "#/components/responses/RESPONSE_REDIRECT_TO_TOKEN_JWT_REFRESH_TOKEN_JWT_DELIVERY_CONTRACT"
          },
          "401": {
            "$ref": "#/components/responses/RESPONSE_INVALID_CREDENTIALS_WRONG_PASSWORD_OR_UNKNOWN_EMAIL_NO_ENUMERATION"
          },
          "403": {
            "$ref": "#/components/responses/RESPONSE_LOCAL_AUTH_DISABLED"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalLoginIn"
              }
            }
          }
        },
        "summary": "ADR-0021: bootstrap-admin password login, sibling of OIDC. The\nroute gates on auth_source='local' so a row SSO has claimed (or a\npure-SSO row) never answers with a password \u2014 same 401 code, no\nenumeration across auth sources (I-NEW-2).",
        "tags": [
          "api.auth"
        ]
      }
    },
