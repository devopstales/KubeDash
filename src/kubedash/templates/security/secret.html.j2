{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Security</span></li>
          <li class="breadcrumb-item active"><span>Secrets</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Secret List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Name</th>
                      <th>Type</th>
                    </tr>
                  </thead>
                  <tbody id="secrets-tbody">
                    <tr>
                        <td colspan="2" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading secrets...</span>
                        </td>
                    </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'secretsTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    // Get namespace from topbar selector or use default
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value;
        }
        // Fallback to sessionStorage or default
        return sessionStorage.getItem('ns_select') || 'default';
    }
    
    function populateSecretsTable(secrets) {
        const tbody = document.getElementById('secrets-tbody');
        if (!tbody) return;
        
        if (!secrets || secrets.length === 0) {
            tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">No secrets found</td></tr>';
            return;
        }
        
        // Get selected secret from URL
        const urlParams = new URLSearchParams(window.location.search);
        const selectedSecret = urlParams.get('selected');
        const namespace = getSelectedNamespace();
        
        let rows = [];
        secrets.forEach(secret => {
            const isSelected = selectedSecret === secret.name;
            const rowClass = isSelected ? 'selected' : '';
            rows.push(`
                <tr class="${rowClass}">
                    <td>
                        <a href="/security/secret/data?secret_name=${encodeURIComponent(secret.name)}&namespace=${encodeURIComponent(namespace)}" 
                           onclick="sessionStorage.setItem('ns_select', '${escapeHtml(namespace)}'); sessionStorage.setItem('secret_data_name', '${escapeHtml(secret.name)}'); return true;">
                            ${escapeHtml(secret.name)}
                        </a>
                    </td>
                    <td>${escapeHtml(secret.type || 'N/A')}</td>
                </tr>
            `);
        });
        
        tbody.innerHTML = rows.join('');
        
        // Initialize DataTable after populating
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById('dataTable');
                if (table && !$.fn.dataTable.isDataTable('#dataTable')) {
                    $('#dataTable').DataTable({
                        order: [[0, 'asc']],
                        pageLength: 25,
                        responsive: true
                    });
                }
            }
        }, 50);
    }
    
    async function loadSecrets(namespace) {
        try {
            const apiUrl = `/api/v1/security/secrets${namespace ? '?namespace=' + encodeURIComponent(namespace) : ''}`;
            console.log('Fetching secrets from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Secrets API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load secrets');
            }
            
            const secrets = data.data || [];
            populateSecretsTable(secrets);
            
        } catch (error) {
            console.error('Error loading secrets:', error);
            const tbody = document.getElementById('secrets-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="2" class="text-center text-danger">Error loading secrets: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        const namespace = getSelectedNamespace();
        loadSecrets(namespace);
    });
    
    // Reload data when namespace changes (if namespace selector exists)
    document.addEventListener('DOMContentLoaded', function() {
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', function() {
                const namespace = this.value;
                console.log('Namespace changed to:', namespace);
                sessionStorage.setItem('ns_select', namespace);
                loadSecrets(namespace);
            });
        }
    });
</script>
{% endblock %}