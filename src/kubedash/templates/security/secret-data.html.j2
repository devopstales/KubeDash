{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Security</span></li>
          <li class="breadcrumb-item active"><a href="/security/secret">Secrets</a></li>
          <li class="breadcrumb-item active"><span id="secret-name-breadcrumb">Loading...</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Secret Data</h6>
    </div>
    <div class="card-body">
        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="secretInfoTable" width="100%" cellspacing="0">
                        <tbody id="secret-info-tbody">
                            <tr>
                                <td colspan="2" class="text-center">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <span class="ms-2">Loading secret data...</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card-body" id="secret-data-container" style="display: none;">
            <div class="card shadow mb-4">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="secretDataTable" width="100%" cellspacing="0">
                            <tbody id="secret-data-tbody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/datatable_snippet.html.j2" %}
{% include "segments/highlight_snippet.html.j2"%}
{% include "segments/functions_snippet.j2"%}
{% endblock %}

{% block add_tail_js %}
<script>
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // Base64 decode function
    function base64Decode(str) {
        try {
            // Handle null/undefined
            if (!str) return '';
            
            // Convert to string if needed
            str = String(str);
            
            // Replace URL-safe base64 characters if present
            str = str.replace(/-/g, '+').replace(/_/g, '/');
            // Add padding if needed
            while (str.length % 4) {
                str += '=';
            }
            // Decode
            const decoded = atob(str);
            return decoded;
        } catch (e) {
            console.error('Error decoding base64:', e, 'Input:', str);
            return str; // Return original if decoding fails
        }
    }
    
    // Detect language for syntax highlighting
    function detectLanguage(key, value) {
        const keyLower = key.toLowerCase();
        const valueStr = String(value).toLowerCase();
        
        if (keyLower.includes('json') || valueStr.trim().startsWith('{') || valueStr.trim().startsWith('[')) {
            return 'json';
        }
        if (keyLower.includes('yaml') || keyLower.includes('yml') || (valueStr.includes('---') && valueStr.includes(':'))) {
            return 'yaml';
        }
        if (keyLower.includes('xml') || valueStr.trim().startsWith('<')) {
            return 'xml';
        }
        if (keyLower.includes('key') || keyLower.includes('cert') || keyLower.includes('pem') || valueStr.includes('-----begin')) {
            return 'plaintext';
        }
        if (keyLower.includes('script') || valueStr.includes('function') || valueStr.includes('const ') || valueStr.includes('var ')) {
            return 'javascript';
        }
        return null; // Let highlight.js auto-detect
    }
    
    // Get secret name and namespace from URL, sessionStorage, or topbar selector
    function getSecretInfo() {
        const urlParams = new URLSearchParams(window.location.search);
        let secretName = urlParams.get('secret_name');
        let namespace = urlParams.get('namespace');
        
        // Fallback to sessionStorage
        if (!secretName) {
            secretName = sessionStorage.getItem('secret_data_name');
        }
        if (!namespace) {
            namespace = sessionStorage.getItem('ns_select');
        }
        
        // Fallback to topbar selector
        if (!namespace) {
            const topbarSelect = document.getElementById('inputGroupSelect04');
            if (topbarSelect) {
                namespace = topbarSelect.value;
            }
        }
        
        // Final fallback
        if (!namespace) {
            namespace = 'default';
        }
        
        return { secretName, namespace };
    }
    
    function populateSecretInfo(secret, namespace) {
        const tbody = document.getElementById('secret-info-tbody');
        if (!tbody) return;
        
        // Update breadcrumb
        const breadcrumb = document.getElementById('secret-name-breadcrumb');
        if (breadcrumb) {
            breadcrumb.textContent = escapeHtml(secret.name || 'Loading...');
        }
        
        let html = `
            <tr>
                <th>Name:</th>
                <td id="secret-name">${escapeHtml(secret.name || 'N/A')}</td>
            </tr>
            <tr>
                <th>Namespace:</th>
                <td id="secret-namespace">${escapeHtml(namespace || 'N/A')}</td>
            </tr>
            <tr>
                <th>Kind:</th>
                <td>Secret</td>
            </tr>
            <tr>
                <th>Created:</th>
                <td id="secret-created">${escapeHtml(secret.created || 'N/A')}</td>
            </tr>
            <tr>
                <th>Type:</th>
                <td id="secret-type">${escapeHtml(secret.type || 'N/A')}</td>
            </tr>
            <tr>
                <th>Version:</th>
                <td id="secret-version">${escapeHtml(secret.version || 'N/A')}</td>
            </tr>
        `;
        
        // Annotations
        if (secret.annotations && Object.keys(secret.annotations).length > 0) {
            let annotationsHtml = '<table class="table table-bordered" id="annotationTable" width="100%" cellspacing="0"><thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(secret.annotations)) {
                if (key !== "kubectl.kubernetes.io/last-applied-configuration") {
                    annotationsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(value)}</td></tr>`;
                }
            }
            annotationsHtml += '</tbody></table>';
            html += `<tr><th>Annotations:</th><td id="secret-annotations-container">${annotationsHtml}</td></tr>`;
        } else {
            html += `<tr><th>Annotations:</th><td><span class="text-muted">No annotations</span></td></tr>`;
        }
        
        // Labels
        if (secret.labels && Object.keys(secret.labels).length > 0) {
            let labelsHtml = '<table class="table table-bordered" id="labelsTable" width="100%" cellspacing="0"><thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(secret.labels)) {
                labelsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(value)}</td></tr>`;
            }
            labelsHtml += '</tbody></table>';
            html += `<tr><th>Labels:</th><td id="secret-labels-container">${labelsHtml}</td></tr>`;
        } else {
            html += `<tr><th>Labels:</th><td><span class="text-muted">No labels</span></td></tr>`;
        }
        
        tbody.innerHTML = html;
        
        // Populate secret data
        const dataContainer = document.getElementById('secret-data-container');
        const dataTbody = document.getElementById('secret-data-tbody');
        if (secret.data && Object.keys(secret.data).length > 0) {
            let dataHtml = '';
            for (const [key, encodedValue] of Object.entries(secret.data)) {
                // Decode base64
                const decodedValue = base64Decode(encodedValue);
                // Create unique ID for each code block
                const codeId = `secret-data-${escapeHtml(key).replace(/[^a-zA-Z0-9]/g, '-')}`;
                // Escape HTML but keep newlines for proper code formatting
                const escapedValue = escapeHtml(decodedValue);
                // Try to detect language based on key or content
                let language = detectLanguage(key, decodedValue);
                const langAttr = language ? ` class="language-${language}"` : '';
                
                dataHtml += `
                    <tr>
                        <th>${escapeHtml(key)}:</th>
                        <td>
                            <button type="button" class="btn btn-just-icon btn-xs" onclick='showSecret("${codeId}")'>
                                <i id="${codeId}_icon" class="material-icons">visibility_off</i> 
                            </button>
                        </td>
                        <td>
                            <pre id="${codeId}" class="textshadow"><code${langAttr}>${escapedValue}</code></pre>
                        </td>
                    </tr>
                `;
            }
            dataTbody.innerHTML = dataHtml;
            dataContainer.style.display = 'block';
            
            // Apply highlight.js to all code blocks after a short delay to ensure DOM is ready
            setTimeout(function() {
                if (typeof hljs !== 'undefined') {
                    // Highlight all code blocks in the secret data table
                    const codeBlocks = dataTbody.querySelectorAll('code');
                    codeBlocks.forEach(function(block) {
                        hljs.highlightElement(block);
                    });
                }
            }, 100);
        } else {
            dataContainer.style.display = 'none';
        }
    }
    
    async function loadSecretData() {
        try {
            const { secretName, namespace } = getSecretInfo();
            
            console.log('Secret info:', { secretName, namespace });
            console.log('URL params:', new URLSearchParams(window.location.search).toString());
            console.log('SessionStorage secret_data_name:', sessionStorage.getItem('secret_data_name'));
            console.log('SessionStorage ns_select:', sessionStorage.getItem('ns_select'));
            
            if (!secretName) {
                throw new Error('Secret name not found. Please select a secret from the list page.');
            }
            
            const apiUrl = `/api/v1/security/secrets/${encodeURIComponent(secretName)}?namespace=${encodeURIComponent(namespace)}`;
            console.log('Fetching secret data from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error(`Secret '${secretName}' not found in namespace '${namespace}'`);
                }
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            console.log('Secret API response:', result);
            
            if (result.error) {
                throw new Error(result.message || 'Failed to load secret');
            }
            
            const secret = result.data || {};
            populateSecretInfo(secret, namespace);
            
        } catch (error) {
            console.error('Error loading secret data:', error);
            const tbody = document.getElementById('secret-info-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="2" class="text-center text-danger">Error loading secret: ' + escapeHtml(error.message) + '</td></tr>';
            }
            const breadcrumb = document.getElementById('secret-name-breadcrumb');
            if (breadcrumb) {
                breadcrumb.textContent = 'Error';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadSecretData();
        
        // Reload data when namespace changes (if namespace selector exists)
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', function() {
                const namespace = this.value;
                console.log('Namespace changed to:', namespace);
                sessionStorage.setItem('ns_select', namespace);
                loadSecretData();
            });
        }
    });
</script>
{% endblock %}
