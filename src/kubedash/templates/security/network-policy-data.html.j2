{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Security</span></li>
          <li class="breadcrumb-item active"><a href="/security/network-policy">Network Policies</a></li>
          <li class="breadcrumb-item active"><span id="policy-name-breadcrumb">Loading...</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Policy Data</h6>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs" id="nav-tab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="nav-policy-tab" data-bs-toggle="tab" href="#nav-policy" role="tab" aria-controls="nav-policy" aria-selected="true">Policy</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="nav-ingress-tab" data-bs-toggle="tab" href="#nav-ingress" role="tab" aria-controls="nav-ingress" aria-selected="false">Ingress</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="nav-egress-tab" data-bs-toggle="tab" href="#nav-egress" role="tab" aria-controls="nav-egress" aria-selected="false">Egress</a>
            </li>
        </ul>
        <div class="tab-content" id="nav-tabContent">
            <!-- Policy Tab -->
            <div class="tab-pane fade show active" id="nav-policy" role="tabpanel" aria-labelledby="nav-policy-tab">
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="policyInfoTable" width="100%" cellspacing="0">
                                <tbody id="policy-info-tbody">
                                    <tr>
                                        <td colspan="2" class="text-center">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <span class="ms-2">Loading policy data...</span>
                                    </td>
                                </tr>
                                            </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Ingress Tab -->
            <div class="tab-pane fade" id="nav-ingress" role="tabpanel" aria-labelledby="nav-ingress-tab">
                <div class="card shadow mb-4">
                    <div class="card-body">
                         <div class="table-responsive">
                            <table class="table table-bordered" id="ingressInfoTable" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Src Namespace</th>
                                        <th>Src Pods</th>
                                        <th>Src Subnet</th>
                                        <th>Src Exception</th>
                                        <th>Dst Namespace</th>
                                        <th>Dst Pods</th>
                                        <th>Dst Port</th>
                                    </tr>
                                </thead>
                                <tbody id="ingress-rules-tbody">
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <span class="ms-2">Loading ingress rules...</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                         </div>
                    </div>
                </div>
            </div>
            <!-- Egress Tab -->
            <div class="tab-pane fade" id="nav-egress" role="tabpanel" aria-labelledby="nav-egress-tab">
                <div class="card shadow mb-4">
                    <div class="card-body">
                         <div class="table-responsive">
                            <table class="table table-bordered" id="egressInfoTable" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Src Namespace</th>
                                        <th>Src Pods</th>
                                        <th>Dst Namespace</th>
                                        <th>Dst Pods</th>
                                        <th>Dst Subnet</th>
                                        <th>Dst Exception</th>
                                        <th>Dst Port</th>
                                    </tr>
                                </thead>
                                <tbody id="egress-rules-tbody">
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <span class="ms-2">Loading egress rules...</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                         </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // Format labels as badges
    function formatLabels(labels) {
        if (!labels || Object.keys(labels).length === 0) {
            return '<span class="text-muted">Any</span>';
        }
        let html = '';
        const keys = Object.keys(labels);
        keys.forEach((key, index) => {
            html += `<span class="badge text-bg-tag text-bg-secondary">${escapeHtml(key)}: ${escapeHtml(labels[key])}</span>`;
            if (index < keys.length - 1) {
                html += '<br>';
            }
        });
        return html;
    }
    
    // Format pod selector (handles both K8s and Cilium formats)
    function formatPodSelector(podSelector) {
        if (!podSelector) {
            return '<span class="text-muted">Any</span>';
        }
        
        // Handle Cilium format (endpointSelector with matchLabels)
        let labels = null;
        if (podSelector.matchLabels) {
            labels = podSelector.matchLabels;
        } else if (podSelector.match_labels) {
            labels = podSelector.match_labels;
        }
        
        if (!labels || Object.keys(labels).length === 0) {
            return '<span class="text-muted">Any</span>';
        }
        
        return formatLabels(labels);
    }
    
    // Get policy name and namespace from URL, sessionStorage, or topbar selector
    function getPolicyInfo() {
        const urlParams = new URLSearchParams(window.location.search);
        let policyName = urlParams.get('policy_name');
        let namespace = urlParams.get('namespace');
        let kind = urlParams.get('kind');
        
        // Fallback to sessionStorage
        if (!policyName) {
            policyName = sessionStorage.getItem('policy_data_name');
        }
        if (!namespace) {
            namespace = sessionStorage.getItem('ns_select');
        }
        if (!kind) {
            kind = sessionStorage.getItem('policy_kind');
        }
        
        // Fallback to topbar selector
        if (!namespace) {
            const topbarSelect = document.getElementById('inputGroupSelect04');
            if (topbarSelect) {
                namespace = topbarSelect.value;
            }
        }
        
        // Final fallback
        if (!namespace) {
            namespace = 'default';
        }
        if (!kind) {
            kind = 'NetworkPolicy';
        }
        
        return { policyName, namespace, kind };
    }
    
    function populatePolicyInfo(policy, namespace) {
        const tbody = document.getElementById('policy-info-tbody');
        if (!tbody) return;
        
        // Update breadcrumb
        const breadcrumb = document.getElementById('policy-name-breadcrumb');
        if (breadcrumb) {
            breadcrumb.textContent = escapeHtml(policy.name || 'Loading...');
        }
        
        const policyKind = policy.kind || 'NetworkPolicy';
        const policyNamespace = policy.namespace || namespace;
        
        let html = `
            <tr>
                <th>Kind:</th>
                <td>${escapeHtml(policyKind)}</td>
            </tr>
            <tr>
                <th>Name:</th>
                <td>${escapeHtml(policy.name || 'N/A')}</td>
            </tr>
        `;
        
        // Only show namespace if it's not a cluster-wide policy
        if (policyKind !== 'CiliumClusterwideNetworkPolicy' && policyNamespace) {
            html += `
                <tr>
                    <th>Namespace:</th>
                    <td>${escapeHtml(policyNamespace)}</td>
                </tr>
            `;
        }
        
        // Annotations
        if (policy.annotations && Object.keys(policy.annotations).length > 0) {
            let annotationsHtml = '<table class="table table-bordered" id="annotationTable" width="100%" cellspacing="0"><thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(policy.annotations)) {
                if (key !== "kubectl.kubernetes.io/last-applied-configuration") {
                    annotationsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(value)}</td></tr>`;
                }
            }
            annotationsHtml += '</tbody></table>';
            html += `<tr><th>Annotations:</th><td>${annotationsHtml}</td></tr>`;
        } else {
            html += `<tr><th>Annotations:</th><td><span class="text-muted">No annotations</span></td></tr>`;
        }
        
        // Labels
        if (policy.labels && Object.keys(policy.labels).length > 0) {
            let labelsHtml = '<table class="table table-bordered" id="labelsTable" width="100%" cellspacing="0"><thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(policy.labels)) {
                labelsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(value)}</td></tr>`;
            }
            labelsHtml += '</tbody></table>';
            html += `<tr><th>Labels:</th><td>${labelsHtml}</td></tr>`;
        } else {
            html += `<tr><th>Labels:</th><td><span class="text-muted">No labels</span></td></tr>`;
        }
        
        // Selectors (pod selector or endpoint selector for Cilium)
        const selector = policy.pod_selector || policy.endpointSelector;
        if (selector) {
            const selectorLabel = policyKind.includes('Cilium') ? 'Endpoint Selector:' : 'Pod Selector:';
            const selectorHtml = formatPodSelector(selector);
            html += `<tr><th>${selectorLabel}</th><td>${selectorHtml}</td></tr>`;
        } else {
            const selectorLabel = policyKind.includes('Cilium') ? 'Endpoint Selector:' : 'Pod Selector:';
            html += `<tr><th>${selectorLabel}</th><td><span class="text-muted">Any</span></td></tr>`;
        }
        
        // Policy Types
        if (policy.policy_types && policy.policy_types.length > 0) {
            html += `<tr><th>Policy Types:</th><td>${escapeHtml(policy.policy_types.join(', '))}</td></tr>`;
        }
        
        tbody.innerHTML = html;
    }
    
    function populateIngressRules(policy) {
        const tbody = document.getElementById('ingress-rules-tbody');
        if (!tbody) return;
        
        // Handle both 'ingress_rules' and 'imgress_rules' (typo in backend)
        // Also handle Cilium format which uses 'ingress' directly
        const ingressRules = policy.ingress_rules || policy.imgress_rules || policy.ingress || [];
        
        if (!ingressRules || ingressRules.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No ingress communication is allowed</td></tr>';
            return;
        }
        
        let rows = [];
        const namespace = policy.namespace || 'default';
        const podSelector = policy.pod_selector || policy.endpointSelector;
        const isCilium = policy.kind && policy.kind.includes('Cilium');
        
        ingressRules.forEach(rule => {
            // Cilium uses 'fromEndpoints' instead of '_from' or 'from'
            const fromList = rule._from || rule.from || rule.fromEndpoints || [];
            
            if (fromList.length === 0) {
                // Fallback for empty '_from' rules
                rows.push(`
                    <tr>
                        <td>Any</td>
                        <td>Any</td>
                        <td>Any</td>
                        <td>None</td>
                        <td>${escapeHtml(namespace)}</td>
                        <td>${formatPodSelector(podSelector)}</td>
                        <td>Any</td>
                    </tr>
                `);
            } else {
                fromList.forEach(src => {
                    // Source Namespace
                    let srcNamespace = 'Any';
                    if (src.namespace_selector && src.namespace_selector.match_labels) {
                        srcNamespace = formatLabels(src.namespace_selector.match_labels);
                    } else if (src.pod_selector && src.pod_selector.match_labels) {
                        srcNamespace = escapeHtml(namespace);
                    }
                    
                    // Source Pods
                    let srcPods = 'Any';
                    if (src.pod_selector && src.pod_selector.match_labels) {
                        srcPods = formatLabels(src.pod_selector.match_labels);
                    } else if (src.namespace_selector && src.namespace_selector.match_labels) {
                        srcPods = 'Any';
                    }
                    
                    // Source Subnet and Exception
                    let srcSubnet = 'Any';
                    let srcException = 'None';
                    if (src.ip_block) {
                        srcSubnet = escapeHtml(src.ip_block.cidr || 'Any');
                        if (src.ip_block._except && src.ip_block._except.length > 0) {
                            srcException = src.ip_block._except.map(e => escapeHtml(e)).join('<br>');
                        }
                    }
                    
                    // Destination Ports
                    let dstPort = 'Any';
                    if (rule.ports && rule.ports.length > 0) {
                        dstPort = rule.ports.map(p => {
                            // Handle both K8s format (object with protocol/port) and Cilium format (object with protocol/ports array)
                            const protocol = (p.protocol || 'TCP').toUpperCase();
                            if (p.ports && Array.isArray(p.ports)) {
                                // Cilium format: ports is an array
                                return `${protocol}: ${p.ports.join(', ')}`;
                            } else {
                                const port = p.port || 'Any';
                                return `${protocol}: ${port}`;
                            }
                        }).join('<br>');
                    }
                    
                    rows.push(`
                        <tr>
                            <td>${srcNamespace}</td>
                            <td>${srcPods}</td>
                            <td>${srcSubnet}</td>
                            <td>${srcException}</td>
                            <td>${escapeHtml(namespace)}</td>
                            <td>${formatPodSelector(podSelector)}</td>
                            <td>${dstPort}</td>
                        </tr>
                    `);
                });
            }
        });
        
        tbody.innerHTML = rows.join('');
    }
    
    function populateEgressRules(policy) {
        const tbody = document.getElementById('egress-rules-tbody');
        if (!tbody) return;
        
        // Handle Cilium format which uses 'egress' directly
        const egressRules = policy.egress_rules || policy.egress || [];
        const namespace = policy.namespace || 'default';
        const podSelector = policy.pod_selector || policy.endpointSelector;
        const isCilium = policy.kind && policy.kind.includes('Cilium');
        
        if (!egressRules || egressRules.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td>${escapeHtml(namespace)}</td>
                    <td>${formatPodSelector(podSelector)}</td>
                    <td>Any</td>
                    <td>Any</td>
                    <td>Any</td>
                    <td>None</td>
                    <td>Any</td>
                </tr>
            `;
            return;
        }
        
        let rows = [];
        
        egressRules.forEach(rule => {
            // Cilium uses 'toEndpoints' instead of 'to'
            const toList = rule.to || rule.toEndpoints || [];
            
            if (toList.length === 0) {
                // Fallback for empty 'to' rules
                rows.push(`
                    <tr>
                        <td>${escapeHtml(namespace)}</td>
                        <td>${formatPodSelector(podSelector)}</td>
                        <td>Any</td>
                        <td>Any</td>
                        <td>Any</td>
                        <td>None</td>
                        <td>Any</td>
                    </tr>
                `);
            } else {
                toList.forEach(dst => {
                    // Destination Namespace
                    let dstNamespace = 'Any';
                    if (dst.namespace_selector && dst.namespace_selector.match_labels) {
                        dstNamespace = formatLabels(dst.namespace_selector.match_labels);
                    } else if (dst.pod_selector && dst.pod_selector.match_labels) {
                        dstNamespace = escapeHtml(namespace);
                    }
                    
                    // Destination Pods
                    let dstPods = 'Any';
                    if (dst.pod_selector && dst.pod_selector.match_labels) {
                        dstPods = formatLabels(dst.pod_selector.match_labels);
                    } else if (dst.namespace_selector && dst.namespace_selector.match_labels) {
                        dstPods = 'Any';
                    }
                    
                    // Destination Subnet and Exception
                    let dstSubnet = 'Any';
                    let dstException = 'None';
                    if (dst.ip_block) {
                        dstSubnet = escapeHtml(dst.ip_block.cidr || 'Any');
                        if (dst.ip_block._except && dst.ip_block._except.length > 0) {
                            dstException = dst.ip_block._except.map(e => escapeHtml(e)).join('<br>');
                        }
                    }
                    
                    // Destination Ports
                    let dstPort = 'Any';
                    if (rule.ports && rule.ports.length > 0) {
                        dstPort = rule.ports.map(p => {
                            const protocol = (p.protocol || 'TCP').toUpperCase();
                            const port = p.port || 'Any';
                            return `${protocol}: ${port}`;
                        }).join('<br>');
                    }
                    
                    rows.push(`
                        <tr>
                            <td>${escapeHtml(namespace)}</td>
                            <td>${formatPodSelector(podSelector)}</td>
                            <td>${dstNamespace}</td>
                            <td>${dstPods}</td>
                            <td>${dstSubnet}</td>
                            <td>${dstException}</td>
                            <td>${dstPort}</td>
                        </tr>
                    `);
                });
            }
        });
        
        tbody.innerHTML = rows.join('');
    }
    
    async function loadPolicyData() {
        try {
            const { policyName, namespace, kind } = getPolicyInfo();
            
            console.log('Policy info:', { policyName, namespace, kind });
            console.log('URL params:', new URLSearchParams(window.location.search).toString());
            console.log('SessionStorage policy_data_name:', sessionStorage.getItem('policy_data_name'));
            console.log('SessionStorage ns_select:', sessionStorage.getItem('ns_select'));
            
            if (!policyName) {
                throw new Error('Policy name not found. Please select a policy from the list page.');
            }
            
            let apiUrl = `/api/v1/security/network-policies/${encodeURIComponent(policyName)}?namespace=${encodeURIComponent(namespace)}`;
            if (kind) {
                apiUrl += `&kind=${encodeURIComponent(kind)}`;
            }
            console.log('Fetching policy data from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error(`NetworkPolicy '${policyName}' not found in namespace '${namespace}'`);
                }
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            console.log('Policy API response:', result);
            
            if (result.error) {
                throw new Error(result.message || 'Failed to load policy');
            }
            
            const policy = result.data || {};
            const policyNamespace = policy.namespace || namespace;
            populatePolicyInfo(policy, policyNamespace);
            populateIngressRules(policy);
            populateEgressRules(policy);
            
        } catch (error) {
            console.error('Error loading policy data:', error);
            const tbody = document.getElementById('policy-info-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="2" class="text-center text-danger">Error loading policy: ' + escapeHtml(error.message) + '</td></tr>';
            }
            const breadcrumb = document.getElementById('policy-name-breadcrumb');
            if (breadcrumb) {
                breadcrumb.textContent = 'Error';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadPolicyData();
        
        // Reload data when namespace changes (if namespace selector exists)
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', function() {
                const namespace = this.value;
                console.log('Namespace changed to:', namespace);
                sessionStorage.setItem('ns_select', namespace);
                loadPolicyData();
            });
        }
    });
</script>
{% endblock %}
