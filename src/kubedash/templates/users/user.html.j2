{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>User Management</span></li>
          <li class="breadcrumb-item active"><span>Users</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
  <!-- Button trigger modal add -->
  {% if session['user_role'] == "Admin" %}
  <div class="col">
    <button class="header-toggler" type="button" data-bs-toggle="modal" data-bs-target="#modaladd">
      <i class="material-icons">person_add</i>
    </button>
  </div>
  {% endif %}
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<!-- DataTales Example -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">User List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Username</th>
                      <th>Email</th>
                      <th>Permission</th>
                      <th>Type</th>
                      <th>Action</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                      <th>Username</th>
                      <th>Email</th>
                      <th>Permission</th>
                      <th>Type</th>
                      <th>Action</th>
                    </tr>
                </tfoot>
                <tbody id="users-tbody">
                    <tr>
                        <td colspan="5" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading users...</span>
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>


<!-- Modal Add User -->
<div class="modal fade" id="modaladd" tabindex="-1" role="dialog" aria-labelledby="modaladdLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modaladdLabel">Create User</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form action="/user/add" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <div class="form-group">
                  <label>Name:</label>
                  <input class="form-control user" name="username" type="text" placeholder="Type your username">
                </div>
                <div class="form-group">
                  <label>Email:</label>
                  <input class="form-control user" name="email" type="text" placeholder="Type your email">
                </div>
                <div class="form-group">
                  <label>Password:</label>
                  <input type="password" name="password" id="PassEntry" class="form-control user" placeholder="Type your password" readonly>
                  <div id="password-strength-status"></div>
                  <ul id="passwordCriterion" class="pswd_info">
                    <li data-criterion="length" class="invalid">6-15 characters</li>
                    <li data-criterion="capital" class="invalid">Uppercase letter (A-Z)</li>
                    <li data-criterion="small" class="invalid">Lowercase letter (a-z)</li>
                    <li data-criterion="number" class="invalid">Number (0-9)</li>
                    <li data-criterion="special" class="invalid">Special character</li>
                  </ul>
                </div>
                <div class="form-group">
                  <label>Permission:</label>
                  <select class="form-select" aria-label="Select role" name="role">
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>Type:</label>
                  <select class="form-select" aria-label="Select role" name="type" id="add-user-type">
                    <option value="Local">Local</option>
                    <!-- K8s contexts will be populated from API -->
                  </select>
                </div>
                <div class="modal-footer">
                  <div class="form-group mt-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="btnAddUser" disabled>Add User</button>
                  </div>
                </div>
              </form>
            </div>
        </div>
  </div>
</div>
<!-- Modal Add User -->

<!-- Modal Edit User -->
<div class="modal fade" id="modaledit" tabindex="-1" role="dialog" aria-labelledby="modaleditLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modaleditLabel">Update Information</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="edit-user-form" action="/user/list" method="POST">
          <input type="hidden" name="csrf_token" id="edit-csrf-token" value="{{ csrf_token() }}">
          <input type="hidden" name="username" id="edit-username">
          <div class="form-group">
            <label>Name:</label>
            <input class="form-control" id="edit-username-display" type="text" readonly>
          </div>
          <div class="form-group">
            <label>Dashboard Role:</label>
            <select class="form-select" aria-label="Select role" name="role" id="edit-role">
              <option value="User">User</option>
              <option value="Admin">Admin</option>
            </select>
          </div>
          <div class="form-group">
            <label>Type:</label>
            <select class="form-select" aria-label="Select role" name="type" id="edit-type">
              <!-- Options will be populated from API -->
            </select>
          </div>
          <div class="form-group">
            <div class="modal-footer mt-2">
              <div class="form-group">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary" >Save changes</button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<!-- Modal Edit User -->
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
<link rel="stylesheet" href="{{ url_for('static',filename='/vendor/check-strength-password/password-strength.css') }}">
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    // IMMEDIATE: Prevent datatables-demo.js from initializing on loading row
    // Override jQuery ready to intercept datatables-demo.js initialization
    (function() {
        // Store original jQuery ready
        const originalReady = typeof $ !== 'undefined' ? $.fn.ready : null;
        
        // Override when jQuery loads
        function setupOverride() {
            if (typeof $ !== 'undefined' && $.fn && !window._datatableOverrideSetup) {
                window._datatableOverrideSetup = true;
                
                // Intercept DataTable calls on #dataTable
                const originalDataTable = $.fn.DataTable;
                $.fn.DataTable = function(options) {
                    const table = this[0];
                    if (table && table.id === 'dataTable') {
                        const tbody = table.querySelector('tbody');
                        if (tbody) {
                            const rows = tbody.querySelectorAll('tr');
                            const hasColspanRow = Array.from(rows).some(row => {
                                const cells = row.querySelectorAll('td');
                                return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                            });
                            if (hasColspanRow) {
                                console.log('Blocked DataTable initialization on loading row');
                                return this; // Return jQuery object, don't initialize
                            }
                        }
                    }
                    return originalDataTable.apply(this, arguments);
                };
                
                // Copy static methods
                Object.setPrototypeOf($.fn.DataTable, originalDataTable);
                Object.keys(originalDataTable).forEach(key => {
                    $.fn.DataTable[key] = originalDataTable[key];
                });
            }
        }
        
        // Try immediately and on intervals
        setupOverride();
        setTimeout(setupOverride, 0);
        setTimeout(setupOverride, 50);
        setTimeout(setupOverride, 100);
    })();
    
    // Also destroy any auto-initialized DataTable instances as backup
    (function() {
        function checkAndDestroyAutoInit() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById('dataTable');
                if (table && $.fn.DataTable.isDataTable(table)) {
                    const tbody = table.querySelector('tbody');
                    if (tbody) {
                        const rows = tbody.querySelectorAll('tr');
                        const hasColspanRow = Array.from(rows).some(row => {
                            const cells = row.querySelectorAll('td');
                            return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                        });
                        if (hasColspanRow) {
                            console.log('Destroying auto-initialized DataTable on loading row');
                            try {
                                $(table).DataTable().destroy();
                            } catch(e) {
                                console.error('Error destroying DataTable:', e);
                            }
                        }
                    }
                }
            }
        }
        
        if (typeof $ !== 'undefined') {
            checkAndDestroyAutoInit();
        }
        setTimeout(checkAndDestroyAutoInit, 50);
        setTimeout(checkAndDestroyAutoInit, 100);
        setTimeout(checkAndDestroyAutoInit, 200);
        setTimeout(checkAndDestroyAutoInit, 500);
        setTimeout(checkAndDestroyAutoInit, 1000);
    })();
    
    // Session data - rendered server-side using Flask tojson filter
    const current_user_role = {{ session.get('user_role', '')|tojson }};
    const current_username = {{ session.get('user_name', session.get('username', ''))|tojson }};
    const csrf_token = {{ csrf_token()|tojson }};
    
    // API URL
    const users_api_url = '/api/v1/users';
    
    // Global variables
    let usersData = [];
    let k8sContexts = [];
    let availableRoles = [];
    let usersTable = null;
    
    // Helper function to escape HTML
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    // Populate K8s contexts in select elements
    function populateK8sContexts(contexts) {
        k8sContexts = contexts || [];
        const addSelect = document.getElementById('add-user-type');
        const editSelect = document.getElementById('edit-type');
        
        if (addSelect) {
            // Keep Local option, add contexts
            const localOption = addSelect.querySelector('option[value="Local"]');
            addSelect.innerHTML = '';
            if (localOption) {
                addSelect.appendChild(localOption);
            }
            k8sContexts.forEach(context => {
                const option = document.createElement('option');
                option.value = context;
                option.textContent = context;
                addSelect.appendChild(option);
            });
        }
        
        if (editSelect) {
            // Will be populated when editing a user
        }
    }
    
    // Populate users table
    function populateUsersTable(users) {
        const tbody = document.getElementById('users-tbody');
        const table = document.getElementById('dataTable');
        
        // Destroy any existing DataTable instance first (in case it was auto-initialized)
        if (table && typeof $ !== 'undefined' && $.fn.DataTable && $.fn.DataTable.isDataTable(table)) {
            console.log('Destroying existing DataTable before populating');
            $(table).DataTable().destroy();
        }
        
        // Show loading state while processing
        tbody.innerHTML = `
            <tr>
                <td colspan="5" class="text-center">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="ms-2">Processing users...</span>
                </td>
            </tr>
        `;
        
        if (!users || users.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No users found</td></tr>';
            // Don't initialize DataTable on empty/colspan rows - it will show the empty message
            // DataTables will show its own empty message when initialized later if needed
            return;
        }
        
        usersData = users;
        
        tbody.innerHTML = users.map(user => {
            const isAdmin = current_user_role === 'Admin';
            const canEdit = isAdmin && user.username !== 'admin';
            const canViewSelf = user.username === current_username && user.username !== 'admin';
            
            let usernameCell = escapeHtml(user.username);
            if (canEdit || canViewSelf) {
                // Use data attribute instead of inline JavaScript to prevent XSS
                const safeUsername = escapeHtml(user.username);
                usernameCell = `<form action="/user/privilege" method="POST" class="inline-form" data-username="${safeUsername}">
                    <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                    <input type="hidden" name="username" value="${safeUsername}"/>
                    <a href="#" class="form-submit-link">${safeUsername}</a>
                </form>`;
            }

            let actionCell = '';
            if (canEdit) {
                // Use data attributes to prevent XSS in onclick handlers
                const safeUsername = escapeHtml(user.username);
                const safeRole = escapeHtml(user.role || '');
                const safeUserType = escapeHtml(user.user_type || '');
                actionCell = `<div class="d-flex flex-row">
                    <form action="/user/delete" method="POST">
                        <button type="button" class="btn btn-success btn-just-icon btn-xs edit-btn" data-username="${safeUsername}" data-role="${safeRole}" data-user-type="${safeUserType}">
                            <i class="material-icons">edit</i>
                        </button>
                        ${user.username !== current_username ? `
                        <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                        <input type="hidden" name="username" value="${safeUsername}"/>
                        <button type="submit" rel="tooltip" class="btn btn-danger btn-just-icon btn-sm" value="upvote">
                            <i class="material-icons">delete</i>
                        </button>
                        ` : ''}
                    </form>
                    <form action="/user/privilege/edit" method="POST" class="inline-form" data-username="${safeUsername}">
                        <input type="hidden" name="csrf_token" value="${csrf_token}">
                        <input type="hidden" name="username" value="${escapeHtml(user.username)}"/>
                        <button type="submit" rel="tooltip" class="btn btn-secondary btn-just-icon btn-sm" value="upvote">
                            <i class="material-icons">workspace_premium</i>
                        </button>
                    </form> 
                </div>`;
            }
            
            return `
                <tr>
                    <td>${usernameCell}</td>
                    <td>${escapeHtml(user.email || '')}</td>
                    <td>${escapeHtml(user.role || '')}</td>
                    <td>${escapeHtml(user.user_type || '')}</td>
                    <td>${actionCell}</td>
                </tr>
            `;
        }).join('');
        
        // Small delay to ensure DOM is updated before initializing DataTables
        setTimeout(() => {
            // Verify rows have correct structure (5 columns each, no colspan rows)
            const rows = tbody.querySelectorAll('tr');
            let validRows = true;
            let hasDataRows = false;
            
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                // Check if row has colspan (loading/empty message row)
                const hasColspan = Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                
                if (hasColspan) {
                    // This is a loading/empty row, skip it
                    return;
                }
                
                // This is a data row, check it has 5 columns
                if (cells.length !== 5) {
                    validRows = false;
                    console.warn('Row has incorrect number of columns:', cells.length, 'expected 5');
                } else {
                    hasDataRows = true;
                }
            });
            
            // Only initialize if we have valid data rows (not just loading/empty rows)
            if (!hasDataRows) {
                console.log('No data rows found, skipping DataTable initialization');
                return;
            }
            
            if (!validRows) {
                console.error('Cannot initialize DataTable: rows have incorrect structure');
                return;
            }
            
            // Initialize or reinitialize DataTable
            if ($.fn.DataTable && $(table).length) {
                if ($.fn.DataTable.isDataTable(table)) {
                    const savedRows = tbody.innerHTML;
                    $(table).DataTable().destroy();
                    tbody.innerHTML = savedRows;
                }
                
                // Filter out colspan rows and count only data rows
                const dataRows = Array.from(tbody.querySelectorAll('tr')).filter(row => {
                    const cells = row.querySelectorAll('td');
                    return !Array.from(cells).some(cell => cell.hasAttribute('colspan')) && cells.length === 5;
                });
                
                const currentRowCount = dataRows.length;
                console.log('Initializing DataTable with', currentRowCount, 'data rows');
                
                if (currentRowCount > 0) {
                    // Verify again after destroy/restore
                    const verifyRows = Array.from(tbody.querySelectorAll('tr')).filter(row => {
                        const cells = row.querySelectorAll('td');
                        return !Array.from(cells).some(cell => cell.hasAttribute('colspan')) && cells.length === 5;
                    });
                    
                    if (verifyRows.length > 0) {
                        usersTable = $(table).DataTable({
                            responsive: true,
                            pageLength: 25
                        });
                        console.log('DataTable initialized successfully');
                    } else {
                        console.error('Cannot initialize DataTable: no valid rows after destroy/restore');
                    }
                } else {
                    console.warn('No valid data rows found, skipping DataTable initialization');
                }
            }
        }, 50);
    }
    
    // Open edit modal with user data
    function openEditModal(username, role, userType) {
        document.getElementById('edit-username').value = username;
        document.getElementById('edit-username-display').value = username;
        document.getElementById('edit-role').value = role || 'User';
        
        // Populate type select
        const editTypeSelect = document.getElementById('edit-type');
        editTypeSelect.innerHTML = '';
        const currentOption = document.createElement('option');
        currentOption.value = userType || 'Local';
        currentOption.textContent = userType || 'Local';
        editTypeSelect.appendChild(currentOption);
        
        k8sContexts.forEach(context => {
            if (context !== userType) {
                const option = document.createElement('option');
                option.value = context;
                option.textContent = context;
                editTypeSelect.appendChild(option);
            }
        });
        
        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('modaledit'));
        modal.show();
    }
    
    // Load users data using fetch() - following Flask fetch pattern
    document.addEventListener('DOMContentLoaded', async function() {
        // Wait for jQuery and DataTables
        let retries = 0;
        while ((typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') && retries < 10) {
            await new Promise(resolve => setTimeout(resolve, 100));
            retries++;
        }
        
        if (typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') {
            console.error('jQuery or DataTables not loaded');
            return;
        }
        
        // CRITICAL: Destroy any auto-initialized DataTable instance from datatables-demo.js
        // This prevents initialization on the loading row with colspan
        const table = document.getElementById('dataTable');
        if (table) {
            // Check if DataTable was auto-initialized on a loading row
            if ($.fn.DataTable && $.fn.DataTable.isDataTable(table)) {
                const tbody = table.querySelector('tbody');
                if (tbody) {
                    const rows = tbody.querySelectorAll('tr');
                    const hasColspanRow = Array.from(rows).some(row => {
                        const cells = row.querySelectorAll('td');
                        return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                    });
                    if (hasColspanRow) {
                        console.log('Destroying auto-initialized DataTable instance on loading row');
                        $(table).DataTable().destroy();
                    }
                } else {
                    // No tbody or empty, destroy anyway
                    console.log('Destroying auto-initialized DataTable instance (no valid tbody)');
                    $(table).DataTable().destroy();
                }
            }
        }
        
        try {
            console.log('Fetching users from:', users_api_url);
            const response = await fetch(users_api_url);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Users API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load users');
            }
            
            // Extract data
            const users = data.data || [];
            k8sContexts = data.metadata?.k8s_contexts || [];
            availableRoles = data.metadata?.available_roles || [];
            
            // Populate K8s contexts in select elements
            populateK8sContexts(k8sContexts);

            // Populate users table
            populateUsersTable(users);

        } catch (error) {
            console.error('Error loading users:', error);
            const tbody = document.getElementById('users-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading users: ' + error.message + '</td></tr>';
            }
        }
    });

    // Event delegation for inline forms and buttons (CSP-compliant)
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('form-submit-link')) {
            e.preventDefault();
            const form = e.target.closest('form');
            if (form) {
                const username = form.dataset.username;
                if (username) sessionStorage.setItem('privilege_username', username);
                form.submit();
            }
        }
        if (e.target.classList.contains('edit-btn')) {
            const username = e.target.dataset.username;
            const role = e.target.dataset.role;
            const userType = e.target.dataset.userType;
            if (typeof openEditModal === 'function') {
                openEditModal(username, role, userType);
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            const username = form.dataset.username;
            if (username) {
                // Determine which key to use based on form action
                if (form.action.includes('/privilege/edit')) {
                    sessionStorage.setItem('privilege_edit_username', username);
                } else {
                    sessionStorage.setItem('privilege_username', username);
                }
            }
        }
    });
</script>
<script nonce="{{ csp_nonce }}" src="{{ url_for('static',filename='/vendor/check-strength-password/password-strength.js') }}"></script>
<script nonce="{{ csp_nonce }}">
(function() {
    const passEntry = document.getElementById('PassEntry');
    const btnAddUser = document.getElementById('btnAddUser');
    const statusEl = document.getElementById('password-strength-status');

    if (!passEntry || !btnAddUser) return;

    let isPasswordUnlocked = false;

    // Click to unlock password field
    passEntry.addEventListener('click', function() {
        if (!isPasswordUnlocked) {
            passEntry.removeAttribute('readonly');
            passEntry.focus();
            isPasswordUnlocked = true;
        }
    });

    passEntry.addEventListener('input', function() {
        const pwd = passEntry.value;

        // Run strength check using existing library
        let total = 0;
        if (typeof checkPasswordStrength === 'function') {
            total = checkPasswordStrength('', pwd);
        }

        // Strong = all 5 criteria met (length, capital, small, number, special)
        const isStrong = total >= 5;

        btnAddUser.disabled = !isStrong;

        // Update status text for button
        if (isStrong) {
            statusEl.textContent = 'Password is strong — you can add the user.';
            statusEl.style.color = '#229954';
        } else if (pwd.length > 0) {
            statusEl.textContent = 'Password not strong enough yet.';
            statusEl.style.color = '#ec3f41';
        } else {
            statusEl.textContent = '';
        }
    });

    // Reset on modal close
    document.getElementById('modaladd')?.addEventListener('hidden.bs.modal', function() {
        passEntry.setAttribute('readonly', '');
        passEntry.value = '';
        isPasswordUnlocked = false;
        btnAddUser.disabled = true;
        statusEl.textContent = '';
        document.querySelectorAll('#passwordCriterion li').forEach(li => {
            li.classList.remove('valid');
            li.classList.add('invalid');
        });
    });
})();
</script>
{% endblock %}
