{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Other Resources</span></li>
          <li class="breadcrumb-item"><a href="/other-resource/limit-range">Limit Range</a></li>
          <li class="breadcrumb-item active"><span id="limit-range-name-breadcrumb">Loading...</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Limit Range Data</h6>
    </div>
    <div class="card-body">
        <div class="tab-content" id="nav-tabContent">
            <!-- policy -->
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="policyInfoTable" width="100%" cellspacing="0">
                                <tr>
                                    <th>Name:</th>
                                    <td id="limit-range-name">Loading...</td>
                                </tr>
                                <tr>
                                    <th>Created:</th>
                                    <td id="limit-range-created">Loading...</td>
                                </tr>
                                <tr>
                                    <th>Namespace:</th>
                                    <td id="limit-range-namespace">Loading...</td>
                                </tr>
                                <tr>
                                    <th>Annotations:</th>
                                    <td id="limit-range-annotations-container">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </td>
                                </tr>
                               <tr>
                                    <th>Labels:</th>
                                    <td id="limit-range-labels-container">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Container Limits:</h6>
    </div>
    <div class="card-body">
        <div class="tab-content" id="nav-tabContent">
            <!-- policy -->
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="limitsTable" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Resource</th>
                                        <th>Minimum</th>
                                        <th>Maximum</th>
                                        <th>Default Limit</th>
                                        <th>Default Request</th>
                                        <th>Minimum Limit Request Ratio</th>
                                    </tr>
                                </thead>
                                <tbody id="limits-tbody">
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // Get Limit Range name and namespace from URL, sessionStorage, or topbar selector
    function getLimitRangeInfo() {
        const urlParams = new URLSearchParams(window.location.search);
        let limitRangeName = urlParams.get('limit_name');
        let namespace = urlParams.get('namespace');
        
        // Fallback to sessionStorage
        if (!limitRangeName) {
            limitRangeName = sessionStorage.getItem('limit_range_data_name');
        }
        if (!namespace) {
            namespace = sessionStorage.getItem('ns_select');
        }
        
        // Fallback to topbar selector
        if (!namespace) {
            const topbarSelect = document.getElementById('inputGroupSelect04');
            if (topbarSelect && topbarSelect.value) {
                namespace = topbarSelect.value;
                // Store it in sessionStorage for consistency
                sessionStorage.setItem('ns_select', namespace);
            }
        }
        
        // Final fallback
        if (!namespace) {
            namespace = 'default';
        }
        
        return { limitRangeName, namespace };
    }
    
    function populateLimitRangeInfo(limitRange) {
        if (!limitRange) {
            document.getElementById('limit-range-name').textContent = 'N/A';
            document.getElementById('limit-range-created').textContent = 'N/A';
            document.getElementById('limit-range-namespace').textContent = 'N/A';
            return;
        }
        
        // Update breadcrumb
        const breadcrumb = document.getElementById('limit-range-name-breadcrumb');
        if (breadcrumb) {
            breadcrumb.textContent = limitRange.name || 'N/A';
        }
        
        // Basic info
        document.getElementById('limit-range-name').textContent = escapeHtml(limitRange.name || 'N/A');
        document.getElementById('limit-range-created').textContent = escapeHtml(limitRange.created || 'N/A');
        document.getElementById('limit-range-namespace').textContent = escapeHtml(limitRange.namespace || 'N/A');
        
        // Annotations
        const annotationsContainer = document.getElementById('limit-range-annotations-container');
        if (limitRange.annotations && Object.keys(limitRange.annotations).length > 0) {
            let annotationsHtml = '<table class="table table-bordered" id="annotationTable" width="100%" cellspacing="0">';
            annotationsHtml += '<thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(limitRange.annotations)) {
                annotationsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(String(value))}</td></tr>`;
            }
            annotationsHtml += '</tbody></table>';
            annotationsContainer.innerHTML = annotationsHtml;
        } else {
            annotationsContainer.innerHTML = '<span class="text-muted">None</span>';
        }
        
        // Labels
        const labelsContainer = document.getElementById('limit-range-labels-container');
        if (limitRange.labels && Object.keys(limitRange.labels).length > 0) {
            let labelsHtml = '<table class="table table-bordered" id="labelsTable" width="100%" cellspacing="0">';
            labelsHtml += '<thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(limitRange.labels)) {
                labelsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(String(value))}</td></tr>`;
            }
            labelsHtml += '</tbody></table>';
            labelsContainer.innerHTML = labelsHtml;
        } else {
            labelsContainer.innerHTML = '<span class="text-muted">None</span>';
        }
        
        // Limits
        populateLimits(limitRange.limits || []);
    }
    
    function populateLimits(limits) {
        const tbody = document.getElementById('limits-tbody');
        
        if (!limits || limits.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No limits defined</td></tr>';
            return;
        }
        
        let rowsHtml = '';
        
        for (const limit of limits) {
            // Handle both snake_case and camelCase
            const min = limit.min || {};
            const max = limit.max || {};
            const defaultLimit = limit.default || limit.defaultLimit || {};
            const defaultRequest = limit.default_request || limit.defaultRequest || {};
            const maxLimitRequestRatio = limit.max_limit_request_ratio || limit.maxLimitRequestRatio || {};
            
            // CPU row
            const cpuMin = min.cpu || 'None';
            const cpuMax = max.cpu || 'None';
            const cpuDefaultLimit = defaultLimit.cpu || 'None';
            const cpuDefaultRequest = defaultRequest.cpu || 'None';
            const cpuMaxRatio = maxLimitRequestRatio.cpu || 'None';
            
            rowsHtml += `
                <tr>
                    <td>cpu</td>
                    <td>${escapeHtml(String(cpuMin))}</td>
                    <td>${escapeHtml(String(cpuMax))}</td>
                    <td>${escapeHtml(String(cpuDefaultLimit))}</td>
                    <td>${escapeHtml(String(cpuDefaultRequest))}</td>
                    <td>${escapeHtml(String(cpuMaxRatio))}</td>
                </tr>
            `;
            
            // Memory row
            const memMin = min.memory || 'None';
            const memMax = max.memory || 'None';
            const memDefaultLimit = defaultLimit.memory || 'None';
            const memDefaultRequest = defaultRequest.memory || 'None';
            const memMaxRatio = maxLimitRequestRatio.memory || 'None';
            
            rowsHtml += `
                <tr>
                    <td>memory</td>
                    <td>${escapeHtml(String(memMin))}</td>
                    <td>${escapeHtml(String(memMax))}</td>
                    <td>${escapeHtml(String(memDefaultLimit))}</td>
                    <td>${escapeHtml(String(memDefaultRequest))}</td>
                    <td>${escapeHtml(String(memMaxRatio))}</td>
                </tr>
            `;
        }
        
        tbody.innerHTML = rowsHtml;
    }
    
    async function loadLimitRangeData() {
        const { limitRangeName, namespace } = getLimitRangeInfo();
        
        if (!limitRangeName) {
            console.error('No Limit Range name provided');
            document.getElementById('limit-range-name-breadcrumb').textContent = 'Error';
            document.getElementById('limit-range-name').textContent = 'Error: Limit Range name not provided';
            return;
        }
        
        // Update breadcrumb
        document.getElementById('limit-range-name-breadcrumb').textContent = limitRangeName;
        
        try {
            const apiUrl = `/api/v1/other-resources/limit-ranges/${encodeURIComponent(limitRangeName)}?namespace=${encodeURIComponent(namespace)}`;
            console.log('Fetching Limit Range from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error(`Limit Range '${limitRangeName}' not found in namespace '${namespace}'`);
                }
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Limit Range API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load Limit Range');
            }
            
            const limitRange = data.data || {};
            populateLimitRangeInfo(limitRange);
            
        } catch (error) {
            console.error('Error loading Limit Range:', error);
            document.getElementById('limit-range-name').textContent = 'Error: ' + escapeHtml(error.message);
            document.getElementById('limit-range-created').textContent = 'N/A';
            document.getElementById('limit-range-namespace').textContent = 'N/A';
        }
    }
    
    // Initialize namespace selector with sessionStorage value on page load
    document.addEventListener('DOMContentLoaded', function() {
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            const savedNamespace = sessionStorage.getItem('ns_select');
            if (savedNamespace && namespaceSelect.querySelector(`option[value="${savedNamespace}"]`)) {
                namespaceSelect.value = savedNamespace;
            }
        }
    });
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadLimitRangeData();
    });
</script>
{% endblock %}
