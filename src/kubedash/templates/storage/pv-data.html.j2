{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Storage</span></li>
          <li class="breadcrumb-item"><a href="/storage/pv">PV</a></li>
          <li class="breadcrumb-item active"><span id="pv-name-breadcrumb">Loading...</span></li>

        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Persistent Volume Data</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="podInfoTable" width="100%" cellspacing="0">
                <tr>
                    <th>Status:</th>
                    <td id="pv-status">Loading...</td>
                </tr>
                <tr>
                    <th>Name:</th>
                    <td id="pv-name">Loading...</td>
                </tr>
                <tr>
                    <th>Created:</th>
                    <td id="pv-created">Loading...</td>
                </tr>
                <tr id="pv-deleted-row" style="display: none;">
                    <th>Deleted:</th>
                    <td id="pv-deleted">-</td>
                </tr>
                <tr>
                    <th>Annotations:</th>
                    <td id="pv-annotations-container">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th>Labels:</th>
                    <td id="pv-labels-container">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th>StorageClass:</th>
                    <td id="pv-storageclass">Loading...</td>
                </tr>
                <tr>
                    <th>Persistent Volume Claim:</th>
                    <td id="pv-volumeclaim">Loading...</td>
                </tr>
                <tr>
                    <th>PVC Namespace:</th>
                    <td id="pv-pvc-namespace">Loading...</td>
                </tr>
                <tr>
                    <th>Access Mode:</th>
                    <td id="pv-access-modes">Loading...</td>
                </tr>
                <tr>
                    <th>Volume Mode:</th>
                    <td id="pv-volume-mode">Loading...</td>
                </tr>
                <tr>
                    <th>Reclaim Policy:</th>
                    <td id="pv-reclaim-policy">Loading...</td>
                </tr>
                <tr>
                    <th>Capacity:</th>
                    <td id="pv-capacity">Loading...</td>
                </tr>
                <tr id="pv-host-path-row" style="display: none;">
                    <th>Local Path:</th>
                    <td id="pv-host-path">-</td>
                </tr>
                <tr id="pv-csi-driver-row" style="display: none;">
                    <th>CSI Driver:</th>
                    <td id="pv-csi-driver">-</td>
                </tr>
                <tr id="pv-fs-type-row" style="display: none;">
                    <th>Filesystem Type:</th>
                    <td id="pv-fs-type">-</td>
                </tr>
            </table>
        </div>
        <div class="card-body" id="pv-volume-attributes-container" style="display: none;">
            <div class="card shadow mb-4">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="pvVolumeAttributesTable" width="100%" cellspacing="0">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% include "segments/components/highlight_snippet.html.j2"%}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // Detect language for syntax highlighting
    function detectLanguage(key, value) {
        if (!value) return null;
        
        const keyLower = key.toLowerCase();
        const valueStr = String(value).trim();
        
        // Check key name patterns
        if (keyLower.endsWith('.json') || keyLower.endsWith('json')) {
            return 'json';
        }
        if (keyLower.endsWith('.yaml') || keyLower.endsWith('.yml') || keyLower.endsWith('yaml') || keyLower.endsWith('yml')) {
            return 'yaml';
        }
        if (keyLower.endsWith('.xml')) {
            return 'xml';
        }
        if (keyLower.endsWith('.sh') || keyLower.endsWith('.bash')) {
            return 'bash';
        }
        if (keyLower.endsWith('.py')) {
            return 'python';
        }
        if (keyLower.endsWith('.js') || keyLower.endsWith('.javascript')) {
            return 'javascript';
        }
        if (keyLower.endsWith('.properties') || keyLower.endsWith('.ini') || keyLower.endsWith('.conf')) {
            return 'properties';
        }
        
        // Check content patterns
        if (valueStr.startsWith('{') && valueStr.endsWith('}')) {
            try {
                JSON.parse(valueStr);
                return 'json';
            } catch (e) {
                // Not valid JSON
            }
        }
        
        if (valueStr.startsWith('---') || (valueStr.includes(':') && valueStr.includes('\n'))) {
            // Likely YAML
            return 'yaml';
        }
        
        // Check for shell script patterns
        if (valueStr.startsWith('#!') || valueStr.includes('#!/bin/')) {
            return 'bash';
        }
        
        // Default to plain text
        return null;
    }
    
    // Get PV name from URL, sessionStorage, or form
    function getPVInfo() {
        // Try to get from URL parameters first
        const urlParams = new URLSearchParams(window.location.search);
        let pvName = urlParams.get('selected') || urlParams.get('pv_name');
        let namespace = urlParams.get('namespace');
        
        // Fallback to sessionStorage (set by form submission)
        if (!pvName) {
            pvName = sessionStorage.getItem('pv_data_name');
        }
        if (!namespace) {
            namespace = sessionStorage.getItem('ns_select');
        }
        
        // Fallback to topbar selector
        if (!namespace) {
            const topbarSelect = document.getElementById('inputGroupSelect04');
            if (topbarSelect) {
                namespace = topbarSelect.value;
            }
        }
        
        // Final fallback
        if (!namespace) {
            namespace = 'default';
        }
        
        return { pvName, namespace };
    }
    
    function populatePVInfo(pv) {
        if (!pv) {
            document.getElementById('pv-name').textContent = 'N/A';
            document.getElementById('pv-status').textContent = 'N/A';
            document.getElementById('pv-created').textContent = 'N/A';
            return;
        }
        
        // Basic info
        document.getElementById('pv-name').textContent = escapeHtml(pv.name || 'N/A');
        document.getElementById('pv-created').textContent = escapeHtml(pv.created || 'N/A');
        
        // Status with badge
        const status = pv.status || 'Unknown';
        let statusBadge = '';
        if (status === 'Bound') {
            statusBadge = '<span class="badge text-bg-success text-bg-tag">' + escapeHtml(status) + '</span>';
        } else if (status === 'Terminating') {
            statusBadge = '<span class="badge text-bg-danger text-bg-tag">' + escapeHtml(status) + '</span>';
        } else {
            statusBadge = '<span class="badge text-bg-warning text-bg-tag">' + escapeHtml(status) + '</span>';
        }
        document.getElementById('pv-status').innerHTML = statusBadge;
        
        // Update breadcrumb
        const breadcrumb = document.getElementById('pv-name-breadcrumb');
        if (breadcrumb) {
            breadcrumb.textContent = escapeHtml(pv.name || 'Loading...');
        }
        
        // Deleted
        if (pv.deleted) {
            document.getElementById('pv-deleted').textContent = escapeHtml(pv.deleted);
            document.getElementById('pv-deleted-row').style.display = '';
        } else {
            document.getElementById('pv-deleted-row').style.display = 'none';
        }
        
        // Annotations
        const annotationsContainer = document.getElementById('pv-annotations-container');
        if (pv.annotations && Object.keys(pv.annotations).length > 0) {
            let annotationsHtml = '<table class="table table-bordered" id="annotationTable" width="100%" cellspacing="0"><thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(pv.annotations)) {
                if (key !== "kubectl.kubernetes.io/last-applied-configuration") {
                    annotationsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(value)}</td></tr>`;
                }
            }
            annotationsHtml += '</tbody></table>';
            annotationsContainer.innerHTML = annotationsHtml;
        } else {
            annotationsContainer.innerHTML = '<span class="text-muted">No annotations</span>';
        }
        
        // Labels
        const labelsContainer = document.getElementById('pv-labels-container');
        if (pv.labels && Object.keys(pv.labels).length > 0) {
            let labelsHtml = '<table class="table table-bordered" id="labelsTable" width="100%" cellspacing="0"><thead><tr><th width="50%">Key</th><th width="50%">Value</th></tr></thead><tbody>';
            for (const [key, value] of Object.entries(pv.labels)) {
                labelsHtml += `<tr><td width="50%">${escapeHtml(key)}</td><td width="50%">${escapeHtml(value)}</td></tr>`;
            }
            labelsHtml += '</tbody></table>';
            labelsContainer.innerHTML = labelsHtml;
        } else {
            labelsContainer.innerHTML = '<span class="text-muted">No labels</span>';
        }
        
        // StorageClass
        const namespace = sessionStorage.getItem('ns_select') || 'default';
        if (pv.storage_class_name) {
            document.getElementById('pv-storageclass').innerHTML = `
                <form action="/storage/storage-class" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(namespace)}'); return true;">
                    <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                    <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                    <input type="hidden" name="selected" value="${escapeHtml(pv.storage_class_name)}" />
                    <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(pv.storage_class_name)}</a>
                </form>
            `;
        } else {
            document.getElementById('pv-storageclass').textContent = '-';
        }
        
        // VolumeClaim
        if (pv.volume_claim_name) {
            const pvcNamespace = pv.volume_claim_namespace || namespace;
            document.getElementById('pv-volumeclaim').innerHTML = `
                <form action="/storage/pvc" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(pvcNamespace)}'); return true;">
                    <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                    <input type="hidden" name="ns_select" value="${escapeHtml(pvcNamespace)}" />
                    <input type="hidden" name="selected" value="${escapeHtml(pv.volume_claim_name)}" />
                    <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(pv.volume_claim_name)}</a>
                </form>
            `;
        } else {
            document.getElementById('pv-volumeclaim').textContent = '-';
        }
        
        document.getElementById('pv-pvc-namespace').textContent = escapeHtml(pv.volume_claim_namespace || '-');
        document.getElementById('pv-access-modes').textContent = escapeHtml(pv.access_modes || '-');
        document.getElementById('pv-volume-mode').textContent = escapeHtml(pv.volume_mode || '-');
        document.getElementById('pv-reclaim-policy').textContent = escapeHtml(pv.reclaim_policy || '-');
        document.getElementById('pv-capacity').textContent = escapeHtml(pv.capacity || '-');
        
        // Host path
        if (pv.host_path) {
            document.getElementById('pv-host-path').textContent = escapeHtml(pv.host_path);
            document.getElementById('pv-host-path-row').style.display = '';
        } else {
            document.getElementById('pv-host-path-row').style.display = 'none';
        }
        
        // CSI driver
        if (pv.csi_driver) {
            document.getElementById('pv-csi-driver').textContent = escapeHtml(pv.csi_driver);
            document.getElementById('pv-csi-driver-row').style.display = '';
        } else {
            document.getElementById('pv-csi-driver-row').style.display = 'none';
        }
        
        // Filesystem type
        if (pv.fs_type) {
            document.getElementById('pv-fs-type').textContent = escapeHtml(pv.fs_type);
            document.getElementById('pv-fs-type-row').style.display = '';
        } else {
            document.getElementById('pv-fs-type-row').style.display = 'none';
        }
        
        // Volume attributes
        const attributesContainer = document.getElementById('pv-volume-attributes-container');
        const attributesTable = document.getElementById('pvVolumeAttributesTable');
        if (pv.volume_attributes && Object.keys(pv.volume_attributes).length > 0) {
            let attributesHtml = '';
            for (const [key, value] of Object.entries(pv.volume_attributes)) {
                // Create unique ID for each code block
                const codeId = `pv-attr-${escapeHtml(key).replace(/[^a-zA-Z0-9]/g, '-')}`;
                // Escape HTML but keep newlines for proper code formatting
                const escapedValue = escapeHtml(value);
                // Try to detect language based on key or content
                let language = detectLanguage(key, value);
                const langAttr = language ? ` class="language-${language}"` : '';
                attributesHtml += `<tr><th>${escapeHtml(key)}:</th><td><pre><code id="${codeId}"${langAttr}>${escapedValue}</code></pre></td></tr>`;
            }
            attributesTable.innerHTML = attributesHtml;
            attributesContainer.style.display = 'block';
            
            // Apply highlight.js to all code blocks after a short delay
            setTimeout(function() {
                if (typeof hljs !== 'undefined') {
                    const codeBlocks = attributesTable.querySelectorAll('code');
                    codeBlocks.forEach(function(block) {
                        hljs.highlightElement(block);
                    });
                }
            }, 100);
        } else {
            attributesContainer.style.display = 'none';
        }
    }
    
    async function loadPVData() {
        try {
            const { pvName, namespace } = getPVInfo();
            
            console.log('PV info:', { pvName, namespace });
            
            if (!pvName) {
                throw new Error('PV name not found. Please select a PV from the list page.');
            }
            
            const apiUrl = `/api/v1/storage/pvs/${encodeURIComponent(pvName)}`;
            console.log('Fetching PV data from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error(`PV '${pvName}' not found`);
                }
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            console.log('PV API response:', result);
            
            if (result.error) {
                throw new Error(result.message || 'Failed to load PV');
            }
            
            const pv = result.data;
            if (!pv) {
                throw new Error('No PV data received');
            }
            
            populatePVInfo(pv);
            
        } catch (error) {
            console.error('Error loading PV data:', error);
            document.getElementById('pv-name').textContent = 'Error';
            document.getElementById('pv-status').textContent = 'Error';
            document.getElementById('pv-created').textContent = 'Error';
            document.getElementById('pv-annotations-container').innerHTML = 
                '<span class="text-danger">Error loading PV: ' + escapeHtml(error.message) + '</span>';
            document.getElementById('pv-labels-container').innerHTML = '';
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadPVData();
    });
</script>
{% endblock %}