{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Storage</span></li>
          <li class="breadcrumb-item">Volume Snapshots</li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Volume Snapshot List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Usable</th>
                      <th>Name</th>
                      <th>SnapshotClass</th>
                      <th>VolumeClaim</th>
                      <th>Restore Size</th>
                    </tr>
                  </thead>
                  <tbody id="volumesnapshots-tbody">
                    <tr>
                        <td colspan="5" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading volume snapshots...</span>
                        </td>
                      </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'volumesnapshotsTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    // Get namespace from topbar selector or use default
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value;
        }
        // Fallback to sessionStorage or default
        return sessionStorage.getItem('ns_select') || 'default';
    }
    
    function populateVolumeSnapshotsTable(snapshots) {
        const tbody = document.getElementById('volumesnapshots-tbody');
        
        if (!snapshots || snapshots.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center">No volume snapshots found</td></tr>';
            return;
        }
        
        // Get selected snapshot from URL
        const urlParams = new URLSearchParams(window.location.search);
        const selectedSnapshot = urlParams.get('selected');
        const namespace = getSelectedNamespace();
        
        const rows = snapshots.map(snapshot => {
            const name = escapeHtml(snapshot.name || '');
            const status = snapshot.status;
            const snapshotClass = escapeHtml(snapshot.volume_snapshot_class || '-');
            const pvc = escapeHtml(snapshot.pvc || '-');
            const restoreSize = escapeHtml(snapshot.restore_size || '-');
            const snapshotNamespace = snapshot.namespace || namespace;
            
            const isSelected = selectedSnapshot === snapshot.name;
            const rowClass = isSelected ? 'selected' : '';
            
            // Status badge
            let statusBadge = '';
            if (status === true || status === 'True' || status === 'true') {
                statusBadge = '<span class="badge text-bg-success text-bg-tag">Ready</span>';
            } else {
                statusBadge = '<span class="badge text-bg-danger text-bg-tag">Not Ready</span>';
            }
            
            // SnapshotClass link
            let snapshotClassCell = '<td>-</td>';
            if (snapshotClass && snapshotClass !== '-') {
                snapshotClassCell = `
                    <td>
                        <form action="/storage/snapshot-class" method="POST" class="data-form" data-ns="${escapeHtml(namespace)}" data-name="${snapshotClass}" data-storage-key="snapshotclass_data_name">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                            <input type="hidden" name="selected" value="${snapshotClass}" />
                            <a href="#" class="form-submit-link">${snapshotClass}</a>
                        </form>
                    </td>
                `;
            }

            // PVC link
            let pvcCell = '<td>-</td>';
            if (pvc && pvc !== '-') {
                pvcCell = `
                    <td>
                        <form action="/storage/pvc" method="POST" class="data-form" data-ns="${escapeHtml(snapshotNamespace)}" data-name="${pvc}" data-storage-key="pvc_data_name">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(snapshotNamespace)}" />
                            <input type="hidden" name="selected" value="${pvc}" />
                            <a href="#" class="form-submit-link">${pvc}</a>
                        </form>
                    </td>
                `;
            }
            
            return `
                <tr class="${rowClass}">
                    <td>${statusBadge}</td>
                    <td>
                        <form action="/storage/volumesnapshot/data" method="POST" class="data-form" data-ns="${escapeHtml(snapshotNamespace)}" data-name="${name}" data-storage-key="volumesnapshot_data_name">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(snapshotNamespace)}" />
                            <input type="hidden" name="selected" value="${name}" />
                            <a href="#" class="form-submit-link">${name}</a>
                        </form>
                    </td>
                    ${snapshotClassCell}
                    ${pvcCell}
                    <td>${restoreSize}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    $('#dataTable').DataTable({
                        responsive: true,
                        order: [[1, 'asc']],
                        pageLength: 25
                    });
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    async function loadVolumeSnapshots(namespace) {
        try {
            const apiUrl = `/api/v1/storage/volume-snapshots${namespace ? '?namespace=' + encodeURIComponent(namespace) : ''}`;
            console.log('Fetching volume snapshots from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Volume Snapshots API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load volume snapshots');
            }
            
            const snapshots = data.data || [];
            populateVolumeSnapshotsTable(snapshots);
            
        } catch (error) {
            console.error('Error loading volume snapshots:', error);
            const tbody = document.getElementById('volumesnapshots-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading volume snapshots: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        const namespace = getSelectedNamespace();
        loadVolumeSnapshots(namespace);
    });
    
    // Event delegation for form submissions
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                const ns = form.dataset.ns || '';
                const name = form.dataset.name || '';
                const storageKey = form.dataset.storageKey || '';
                if (ns) sessionStorage.setItem('ns_select', ns);
                if (name && storageKey) sessionStorage.setItem(storageKey, name);
                form.submit();
            }
        }
    });

    // Reload data when namespace changes (if namespace selector exists)
    document.addEventListener('DOMContentLoaded', function() {
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', function() {
                const namespace = this.value;
                console.log('Namespace changed to:', namespace);
                sessionStorage.setItem('ns_select', namespace);
                loadVolumeSnapshots(namespace);
            });
        }
    });

    // Event delegation for form submission links (CSP-compliant)
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('form-submit-link')) {
            e.preventDefault();
            const form = e.target.closest('form');
            if (form) {
                form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            const inputs = form.querySelectorAll('input[type="hidden"]');
            inputs.forEach(input => {
                if (input.name && input.value) {
                    sessionStorage.setItem(input.name, input.value);
                }
            });
        }
    });
</script>
{% endblock %}
