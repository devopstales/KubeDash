{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Storage</span></li>
          <li class="breadcrumb-item active"><span>SnapshotClass</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Snapshot Classes List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Name</th>
                      <th>Default</th>
                      <th>Deletion Policy</th>
                      <th>Driver</th>
                    </tr>
                  </thead>
                  <tbody id="snapshotclasses-tbody">
                    <tr>
                        <td colspan="4" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading snapshot classes...</span>
                        </td>
                      </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'snapshotclassesTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    function populateSnapshotClassesTable(snapshotClasses) {
        const tbody = document.getElementById('snapshotclasses-tbody');
        
        if (!snapshotClasses || snapshotClasses.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center">No snapshot classes found</td></tr>';
            return;
        }
        
        // Get selected snapshot class from URL
        const urlParams = new URLSearchParams(window.location.search);
        const selectedSC = urlParams.get('selected') || urlParams.get('sc_name');
        
        const rows = snapshotClasses.map(sc => {
            const name = escapeHtml(sc.name || '');
            const deletionPolicy = escapeHtml(sc.deletion_policy || '-');
            const driver = escapeHtml(sc.driver || '-');
            
            const isSelected = selectedSC === sc.name;
            const rowClass = isSelected ? 'selected' : '';
            
            // Check if this is the default snapshot class
            let isDefault = '';
            if (sc.annotations) {
                for (const [key, value] of Object.entries(sc.annotations)) {
                    if (key === 'snapshot.storage.kubernetes.io/is-default-class' && value === 'true') {
                        isDefault = escapeHtml(value);
                        break;
                    }
                }
            }
            
            return `
                <tr class="${rowClass}">
                    <td>
                        <form action="/storage/snapshot-class/data" method="POST" class="data-form" data-ns="" data-name="${name}" data-storage-key="snapshotclass_data_name">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="sc_name" value="${name}" />
                            <input type="hidden" name="selected" value="${name}" />
                            <a href="#" class="form-submit-link">${name}</a>
                        </form>
                    </td>
                    <td>${isDefault || '-'}</td>
                    <td>${deletionPolicy}</td>
                    <td>${driver}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    const dataTable = $('#dataTable').DataTable({
                        responsive: true,
                        order: [[0, 'asc']],
                        pageLength: 25
                    });
                    
                    // Navigate to selected row if present
                    if (selectedSC) {
                        let foundRowIndex = -1;
                        dataTable.rows().every(function(rowIdx) {
                            const rowNode = this.node();
                            const rowName = $(rowNode).find('input[name="selected"]').val();
                            if (rowName === selectedSC) {
                                foundRowIndex = rowIdx;
                                return false; // break
                            }
                            return true;
                        });
                        
                        if (foundRowIndex >= 0) {
                            const pageLength = dataTable.page.len();
                            const targetPage = Math.floor(foundRowIndex / pageLength);
                            dataTable.page(targetPage).draw('page');
                        }
                    }
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    async function loadSnapshotClasses() {
        try {
            const apiUrl = '/api/v1/storage/snapshot-classes';
            console.log('Fetching snapshot classes from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Snapshot Classes API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load snapshot classes');
            }
            
            const snapshotClasses = data.data || [];
            populateSnapshotClassesTable(snapshotClasses);
            
        } catch (error) {
            console.error('Error loading snapshot classes:', error);
            const tbody = document.getElementById('snapshotclasses-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Error loading snapshot classes: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Event delegation for form submissions
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                const name = form.dataset.name || '';
                const storageKey = form.dataset.storageKey || '';
                if (name && storageKey) sessionStorage.setItem(storageKey, name);
                form.submit();
            }
        }
    });

    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadSnapshotClasses();
    });

    // Event delegation for form submission links (CSP-compliant)
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            const inputs = form.querySelectorAll('input[type="hidden"]');
            inputs.forEach(input => {
                if (input.name && input.value) {
                    sessionStorage.setItem(input.name, input.value);
                }
            });
        }
    });
</script>
{% endblock %}
