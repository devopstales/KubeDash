{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Storage</span></li>
          <li class="breadcrumb-item active"><span>PV</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Persistent Volume List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Status</th>
                      <th>Name</th>
                      <th>StorageClass</th>
                      <th>VolumeClaim</th>
                      <th>Capacity</th>
                      <th>Usage</th>
                    </tr>
                  </thead>
                  <tbody id="pvs-tbody">
                    <tr>
                        <td colspan="6" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading persistent volumes...</span>
                        </td>
                      </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'pvsTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    function populatePVsTable(pvs, metrics) {
        const tbody = document.getElementById('pvs-tbody');
        
        if (!pvs || pvs.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center">No persistent volumes found</td></tr>';
            return;
        }
        
        // Create a lookup map for metrics by PV name
        const metricsMap = {};
        if (metrics && typeof metrics === 'object') {
            Object.keys(metrics).forEach(pvName => {
                metricsMap[pvName] = metrics[pvName];
            });
        }
        
        // Get selected PV from URL
        const urlParams = new URLSearchParams(window.location.search);
        const selectedPV = urlParams.get('selected');
        const namespace = getSelectedNamespace();
        
        const rows = pvs.map(pv => {
            const name = escapeHtml(pv.name || '');
            const status = pv.status || 'Unknown';
            const storageClass = escapeHtml(pv.storage_class_name || '-');
            const volumeClaim = escapeHtml(pv.volume_claim_name || '-');
            const capacity = escapeHtml(pv.capacity || '-');
            
            const isSelected = selectedPV === pv.name;
            const rowClass = isSelected ? 'selected' : '';
            
            // Status badge
            let statusBadge = '';
            if (status === 'Bound') {
                statusBadge = '<span class="badge text-bg-success text-bg-tag">' + escapeHtml(status) + '</span>';
            } else if (status === 'Terminating') {
                statusBadge = '<span class="badge text-bg-danger text-bg-tag">' + escapeHtml(status) + '</span>';
            } else {
                statusBadge = '<span class="badge text-bg-warning text-bg-tag">' + escapeHtml(status) + '</span>';
            }
            
            // StorageClass link
            let storageClassCell = '<td>-</td>';
            if (storageClass && storageClass !== '-') {
                storageClassCell = `
                    <td>
                        <form action="/storage/storage-class" method="POST" class="data-form" data-ns="${escapeHtml(namespace)}" data-name="${storageClass}" data-storage-key="storageclass_data_name">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                            <input type="hidden" name="selected" value="${storageClass}" />
                            <a href="#" class="form-submit-link">${storageClass}</a>
                        </form>
                    </td>
                `;
            }

            // VolumeClaim link
            let volumeClaimCell = '<td>-</td>';
            if (volumeClaim && volumeClaim !== '-') {
                const claimNs = pv.volume_claim_namespace || namespace;
                volumeClaimCell = `
                    <td>
                        <form action="/storage/pvc" method="POST" class="data-form" data-ns="${escapeHtml(claimNs)}" data-name="${volumeClaim}" data-storage-key="pvc_data_name">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(claimNs)}" />
                            <input type="hidden" name="selected" value="${volumeClaim}" />
                            <a href="#" class="form-submit-link">${volumeClaim}</a>
                        </form>
                    </td>
                `;
            }
            
            // Usage metrics
            let usageHtml = '<td>-</td>';
            const pvMetrics = metricsMap[pv.name];
            if (pvMetrics && pvMetrics.percentageUsed !== undefined) {
                const usagePercent = Math.round(pvMetrics.percentageUsed || 0);
                // Determine progress bar color based on usage
                let progressBarClass = 'bg-success';
                if (usagePercent >= 90) {
                    progressBarClass = 'bg-danger';
                } else if (usagePercent >= 75) {
                    progressBarClass = 'bg-warning';
                }
                
                usageHtml = `
                    <td>
                        <div class="progress position-relative" style="height: 20px;">
                            <div class="progress-bar ${progressBarClass}" role="progressbar" style="width: ${usagePercent}%" aria-valuenow="${usagePercent}" aria-valuemin="0" aria-valuemax="100"></div>
                            <small class="justify-content-center d-flex position-absolute w-100">${usagePercent}%</small>
                        </div>
                    </td>
                `;
            }
            
            return `
                <tr class="${rowClass}">
                    <td>${statusBadge}</td>
                    <td>
                        <form action="/storage/pv/data" method="POST" class="data-form" data-ns="${escapeHtml(namespace)}" data-name="${name}" data-storage-key="pv_data_name">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                            <input type="hidden" name="selected" value="${name}" />
                            <a href="#" class="form-submit-link">${name}</a>
                        </form>
                    </td>
                    ${storageClassCell}
                    ${volumeClaimCell}
                    <td>${capacity}</td>
                    ${usageHtml}
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    const dataTable = $('#dataTable').DataTable({
                        responsive: true,
                        order: [[1, 'asc']],
                        pageLength: 25
                    });
                    
                    // Navigate to selected row if present
                    const urlParams = new URLSearchParams(window.location.search);
                    const selectedPV = urlParams.get('selected');
                    if (selectedPV) {
                        let foundRowIndex = -1;
                        dataTable.rows().every(function(rowIdx) {
                            const rowNode = this.node();
                            const rowName = $(rowNode).find('input[name="selected"]').val();
                            if (rowName === selectedPV) {
                                foundRowIndex = rowIdx;
                                return false; // break
                            }
                            return true;
                        });
                        
                        if (foundRowIndex >= 0) {
                            const pageLength = dataTable.page.len();
                            const targetPage = Math.floor(foundRowIndex / pageLength);
                            dataTable.page(targetPage).draw('page');
                        }
                    }
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    // Get namespace from topbar selector or use default
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value;
        }
        // Fallback to sessionStorage or default
        return sessionStorage.getItem('ns_select') || 'default';
    }
    
    async function loadPVs(namespace) {
        try {
            // Fetch PVs and metrics in parallel
            const [pvsResponse, metricsResponse] = await Promise.all([
                fetch(`/api/v1/storage/pvs${namespace ? '?namespace=' + encodeURIComponent(namespace) : ''}`),
                fetch(`/api/v1/storage/pvs/metrics${namespace ? '?namespace=' + encodeURIComponent(namespace) : ''}`)
            ]);
            
            if (!pvsResponse.ok) {
                throw new Error(`HTTP error! status: ${pvsResponse.status}`);
            }
            
            const pvsData = await pvsResponse.json();
            console.log('PVs API response:', pvsData);
            
            if (pvsData.error) {
                throw new Error(pvsData.message || 'Failed to load persistent volumes');
            }
            
            let metrics = null;
            if (metricsResponse.ok) {
                const metricsData = await metricsResponse.json();
                console.log('PV Metrics API response:', metricsData);
                metrics = metricsData.data || null;
            } else {
                console.warn('Failed to load PV metrics:', metricsResponse.status);
            }
            
            const pvs = pvsData.data || [];
            populatePVsTable(pvs, metrics);
            
        } catch (error) {
            console.error('Error loading PVs:', error);
            const tbody = document.getElementById('pvs-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading persistent volumes: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        const namespace = getSelectedNamespace();
        loadPVs(namespace);
    });
    
    // Event delegation for form submissions
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                const ns = form.dataset.ns || '';
                const name = form.dataset.name || '';
                const storageKey = form.dataset.storageKey || '';
                if (ns) sessionStorage.setItem('ns_select', ns);
                if (name && storageKey) sessionStorage.setItem(storageKey, name);
                form.submit();
            }
        }
    });

    // Reload data when namespace changes (if namespace selector exists)
    document.addEventListener('DOMContentLoaded', function() {
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', function() {
                const namespace = this.value;
                console.log('Namespace changed to:', namespace);
                sessionStorage.setItem('ns_select', namespace);
                loadPVs(namespace);
            });
        }
    });

    // Event delegation for form submission links (CSP-compliant)
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            const inputs = form.querySelectorAll('input[type="hidden"]');
            inputs.forEach(input => {
                if (input.name && input.value) {
                    sessionStorage.setItem(input.name, input.value);
                }
            });
        }
    });
</script>
{% endblock %}
