{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Storage</span></li>
          <li class="breadcrumb-item active"><span>StorageClass</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Storage Classes List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Name</th>
                      <th>Default</th>
                      <th>Reclaim Policy</th>
                      <th>Volume Binding Mode</th>
                    </tr>
                  </thead>
                  <tbody id="storageclasses-tbody">
                    <tr>
                        <td colspan="4" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading storage classes...</span>
                        </td>
                      </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script>
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'storageclassesTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    function populateStorageClassesTable(storageClasses) {
        const tbody = document.getElementById('storageclasses-tbody');
        
        if (!storageClasses || storageClasses.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center">No storage classes found</td></tr>';
            return;
        }
        
        // Get selected storage class from URL
        const urlParams = new URLSearchParams(window.location.search);
        const selectedSC = urlParams.get('selected') || urlParams.get('sc_name');
        
        const rows = storageClasses.map(sc => {
            const name = escapeHtml(sc.name || '');
            const reclaimPolicy = escapeHtml(sc.reclaim_policy || '-');
            const volumeBindingMode = escapeHtml(sc.volume_binding_mode || '-');
            
            const isSelected = selectedSC === sc.name;
            const rowClass = isSelected ? 'selected' : '';
            
            // Check if this is the default storage class
            let isDefault = '';
            if (sc.annotations) {
                for (const [key, value] of Object.entries(sc.annotations)) {
                    if (key === 'storageclass.kubernetes.io/is-default-class' && value === 'true') {
                        isDefault = escapeHtml(value);
                        break;
                    }
                }
            }
            
            return `
                <tr class="${rowClass}">
                    <td>
                        <form action="/storage/storage-class/data" method="POST" onsubmit="sessionStorage.setItem('storageclass_data_name', '${name}'); return true;">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="sc_name" value="${name}" />
                            <a href="javascript:;" onclick="parentNode.submit();">${name}</a>
                        </form>
                    </td>
                    <td>${isDefault || '-'}</td>
                    <td>${reclaimPolicy}</td>
                    <td>${volumeBindingMode}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    $('#dataTable').DataTable({
                        responsive: true,
                        order: [[0, 'asc']],
                        pageLength: 25
                    });
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    async function loadStorageClasses() {
        try {
            const apiUrl = '/api/v1/storage/storage-classes';
            console.log('Fetching storage classes from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Storage Classes API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load storage classes');
            }
            
            const storageClasses = data.data || [];
            populateStorageClassesTable(storageClasses);
            
        } catch (error) {
            console.error('Error loading storage classes:', error);
            const tbody = document.getElementById('storageclasses-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Error loading storage classes: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadStorageClasses();
    });
</script>
{% endblock %}