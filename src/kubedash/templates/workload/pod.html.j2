{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Workloads</span></li>
          <li class="breadcrumb-item active"><span>Pods</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Pod List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Status</th>
                      <th>Name</th>
                      <th>Pod IP</th>
                      <th>Owner</th>
                      {% if has_report %}
                      <th>Report</th>
                      <th>Critical</th>
                      <th>High</th>
                      <th>Medium</th>
                      <th>Low</th>
                      {% endif %}
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="pods-tbody">
                    <tr>
                        <td colspan="5" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading pods...</span>
                        </td>
                      </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'podsTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    // Get namespace from topbar selector or use default
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value;
        }
        // Fallback to sessionStorage or default
        return sessionStorage.getItem('ns_select') || 'default';
    }
    
    function populatePodsTable(pods) {
        const tbody = document.getElementById('pods-tbody');
        
        if (!pods || pods.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center">No pods found</td></tr>';
            return;
        }
        
        // Get selected pod from URL
        const urlParams = new URLSearchParams(window.location.search);
        const selectedPod = urlParams.get('selected');
        const namespace = getSelectedNamespace();
        
        const rows = pods.map(pod => {
            const name = escapeHtml(pod.name || '');
            const status = pod.status || 'Unknown';
            const podIp = escapeHtml(pod.pod_ip || '');
            const owner = pod.owner || '';
            
            const isSelected = selectedPod === pod.name;
            const rowClass = isSelected ? 'selected' : '';
            
            // Status badge
            let statusBadge = '';
            if (status === 'Running') {
                statusBadge = '<span class="badge text-bg-success">' + escapeHtml(status) + '</span>';
            } else if (status === 'Terminated' || status === 'CrashLoopBackOff') {
                statusBadge = '<span class="badge text-bg-danger">' + escapeHtml(status) + '</span>';
            } else if (status === 'Pending') {
                statusBadge = '<span class="badge text-bg-warning">' + escapeHtml(status) + '</span>';
            } else if (status === 'Succeeded') {
                statusBadge = '<span class="badge text-bg-secondary">' + escapeHtml(status) + '</span>';
            } else {
                statusBadge = '<span class="badge text-bg-info">' + escapeHtml(status) + '</span>';
            }
            
            // Owner link
            let ownerCell = '<td>-</td>';
            if (owner) {
                const ownerParts = owner.split('/');
                if (ownerParts.length >= 2) {
                    const ownerKind = ownerParts[0].toLowerCase();
                    const ownerName = escapeHtml(ownerParts[1]);
                    ownerCell = `
                        <td>
                            <form action="/workload/${ownerKind}" method="POST" class="inline-form" data-namespace-session-key="ns_select" data-namespace-value="${escapeHtml(namespace)}">
                                <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                                <input type="hidden" name="selected" value="${ownerName}" />
                                <a href="#" class="form-submit-link">${escapeHtml(owner)}</a>
                            </form>
                        </td>
                    `;
                } else {
                    ownerCell = '<td>' + escapeHtml(owner) + '</td>';
                }
            }
            
            return `
                <tr class="${rowClass}">
                    <td>${statusBadge}</td>
                    <td>
                        <form action="/workload/pods/data" method="POST" class="inline-form" data-session-key="pod_data_name" data-session-value="${name}" data-namespace-session-key="pod_data_namespace" data-namespace-value="${escapeHtml(namespace)}">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                            <input type="hidden" name="po_name" value="${name}" />
                            <input type="hidden" name="selected" value="${name}" />
                            <a href="#" class="form-submit-link">${name}</a>
                        </form>
                    </td>
                    <td>${podIp}</td>
                    ${ownerCell}
                    <td>
                        <form action="/workload/pods/delete" method="POST">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="pod_name" value="${name}"/>
                            <button type="submit" rel="tooltip" class="btn btn-danger btn-just-icon btn-sm" value="upvote">
                                <i class="material-icons">delete</i>
                            </button>
                        </form>
                    </td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    const dataTable = $('#dataTable').DataTable({
                        responsive: true,
                        order: [[1, 'asc']],
                        pageLength: 25
                    });
                    
                    // Navigate to selected row if present
                    if (selectedPod) {
                        let foundRowIndex = -1;
                        dataTable.rows().every(function(rowIdx) {
                            const rowNode = this.node();
                            const rowName = $(rowNode).find('input[name="selected"]').val();
                            if (rowName === selectedPod) {
                                foundRowIndex = rowIdx;
                                return false; // break
                            }
                            return true;
                        });
                        
                        if (foundRowIndex >= 0) {
                            const pageLength = dataTable.page.len();
                            const targetPage = Math.floor(foundRowIndex / pageLength);
                            dataTable.page(targetPage).draw('page');
                        }
                    }
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    async function loadPods(namespace) {
        try {
            const apiUrl = `/api/v1/workloads/pods${namespace ? '?namespace=' + encodeURIComponent(namespace) : ''}`;
            console.log('Fetching pods from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Pods API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load pods');
            }
            
            const pods = data.data || [];
            populatePodsTable(pods);
            
        } catch (error) {
            console.error('Error loading pods:', error);
            const tbody = document.getElementById('pods-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading pods: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        const namespace = getSelectedNamespace();
        loadPods(namespace);
    });
    
    // Reload data when namespace changes (if namespace selector exists)
    document.addEventListener('DOMContentLoaded', function() {
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', function() {
                const namespace = this.value;
                console.log('Namespace changed to:', namespace);
                sessionStorage.setItem('ns_select', namespace);
                loadPods(namespace);
            });
        }
    });

    // Event delegation for inline forms (CSP-compliant)
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('form-submit-link')) {
            e.preventDefault();
            const formId = e.target.dataset.formId;
            if (formId) {
                document.getElementById(formId)?.submit();
            } else {
                const form = e.target.closest('form');
                if (form) form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            e.preventDefault();
            const form = e.target;
            const sessionKey = form.dataset.sessionKey;
            const sessionValue = form.dataset.sessionValue;
            const nsSessionKey = form.dataset.namespaceSessionKey;
            const nsSessionValue = form.dataset.namespaceValue;
            if (sessionKey && sessionValue) sessionStorage.setItem(sessionKey, sessionValue);
            if (nsSessionKey && nsSessionValue) sessionStorage.setItem(nsSessionKey, nsSessionValue);
            form.submit();
        }
    });
</script>
{% endblock %}