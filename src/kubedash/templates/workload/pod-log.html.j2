{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Workloads</span></li>
          <li class="breadcrumb-item"><span>Pods</span></li>
          <li class="breadcrumb-item">
            <div class="d-flex">
              <form action="/workload/pods/data" method="POST" class="form-post inline-form" data-namespace-session-key="ns_select" data-namespace-value="{{ session['ns_select'] }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="ns_select" value="{{ session['ns_select'] }}" />
                <input type="hidden" name="po_name" value="{{ po_name }}" />
                <a href="#" class="form-submit-link">{{ po_name }}</a>
              </form>
            </div>
          </li>
          <li class="breadcrumb-item active"><span>Logs</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header terminal-header">
      <div class="d-flex align-items-center w-100">
        <!-- Left: Container selector -->
        <div class="d-inline-flex align-items-center">
          <label for="containers" class="me-2 mb-0 terminal-label">Container:</label>
          <form name="add" method="POST" class="mb-0">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="po_name" value="{{ po_name }}">
            <div class="d-flex align-items-center">
              <select name="container_select" class="form-select form-select-sm me-2" id="containers" aria-label="Select Container" style="min-width: 200px;">
                <option value="" selected disabled>Loading containers...</option>
              </select>
            </div>
          </form>
        </div>
        <!-- Spacer -->
        <div class="ms-auto"></div>
        <!-- Right: Action buttons -->
        <div class="d-inline-flex align-items-center gap-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" id="copyLogsBtn" title="Copy logs to clipboard">
            <i class="cil-clipboard"></i> Copy
          </button>
          <button type="button" class="btn btn-sm btn-outline-primary" id="downloadLogsBtn" title="Download logs">
            <i class="cil-cloud-download"></i> Download
          </button>
        </div>
      </div>
    </div>

    <!-- Terminal body -->
    <div id="terminal" class="terminalBody"></div>

    <!-- Status bar -->
    <div class="card-footer terminal-status-bar">
      <div class="d-flex align-items-center w-100">
        <div class="d-inline-flex align-items-center">
          <span class="status-dot" id="statusDot"></span>
          <span class="status-text" id="statusText">Connecting...</span>
        </div>
        <div class="ms-auto d-inline-flex align-items-center gap-3">
          <span class="status-info">Pod: <strong id="statusPod">{{ po_name }}</strong></span>
          <span class="status-info">NS: <strong id="statusNs">{{ session['ns_select'] }}</strong></span>
          <span class="status-info">Container: <strong id="statusContainer">—</strong></span>
          <span class="status-info" id="lineCount" style="display: none;">Lines: <strong id="lineCountValue">0</strong></span>
        </div>
      </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% include "segments/components/socket_snippet.html.j2" %}
<link href="{{ url_for('static',filename='/css/terminal.css') }}" rel="stylesheet">
{% endblock %}

{% block add_tail_js %}
    <script nonce="{{ csp_nonce }}">
      const term = new Terminal({
        cursorBlink: false,
        cursorStyle: "bar",
        macOptionIsMeta: true,
        scrollback: 10000,
        theme: {
          background: "#000000",
        },
      });

      const fit = new FitAddon.FitAddon();
      term.loadAddon(fit);
      term.loadAddon(new WebLinksAddon.WebLinksAddon());
      term.loadAddon(new SearchAddon.SearchAddon());

      term.open(document.getElementById("terminal"));
      fit.fit();

      window.addEventListener("resize", () => { fit.fit(); });

      const socket = io.connect('/log');
      const statusDot = document.getElementById("statusDot");
      const statusText = document.getElementById("statusText");
      const containersSelect = document.getElementById("containers");
      const statusContainer = document.getElementById("statusContainer");
      const lineCount = document.getElementById("lineCount");
      const lineCountValue = document.getElementById("lineCountValue");

      const podName = "{{ po_name | e }}";
      const namespace = "{{ session['ns_select'] | e }}";
      const initialContainer = "{{ container_select | default('', true) | e }}";

      let socketConnected = false;
      let selectedContainer = "";
      let totalLines = 0;

      function setStatus(state, text) {
        statusDot.className = "status-dot " + state;
        statusText.textContent = text;
      }

      function sendLogRequest(containerName) {
        if (!containerName) return;
        selectedContainer = containerName;
        statusContainer.textContent = containerName;
        totalLines = 0;
        lineCount.style.display = "none";
        if (socketConnected) {
          socket.send(podName, containerName);
          term.reset();
        }
      }

      function buildContainerOptions(containers, initContainers) {
        containersSelect.innerHTML = "";

        if ((!containers || containers.length === 0) && (!initContainers || initContainers.length === 0)) {
          const option = document.createElement("option");
          option.value = "";
          option.textContent = "No containers found";
          option.disabled = true;
          option.selected = true;
          containersSelect.appendChild(option);
          return;
        }

        if (initContainers && initContainers.length > 0) {
          const initGroup = document.createElement("optgroup");
          initGroup.label = "Init containers";
          initContainers.forEach((name) => {
            const option = document.createElement("option");
            option.value = name;
            option.textContent = name;
            initGroup.appendChild(option);
          });
          containersSelect.appendChild(initGroup);
        }

        if (containers && containers.length > 0) {
          const mainGroup = document.createElement("optgroup");
          mainGroup.label = "Containers";
          containers.forEach((name) => {
            const option = document.createElement("option");
            option.value = name;
            option.textContent = name;
            mainGroup.appendChild(option);
          });
          containersSelect.appendChild(mainGroup);
        }
      }

      async function loadContainers() {
        try {
          const url = `/api/v1/workloads/pods/${encodeURIComponent(podName)}/containers?namespace=${encodeURIComponent(namespace)}`;
          const response = await fetch(url, { headers: { "Accept": "application/json" } });
          if (!response.ok) {
            throw new Error(`Container fetch failed: ${response.status}`);
          }
          const payload = await response.json();
          const containers = (payload.data && payload.data.containers) || [];
          const initContainers = (payload.data && payload.data.init_containers) || [];

          buildContainerOptions(containers, initContainers);

          const desired = initialContainer || (containers[0] || initContainers[0] || "");
          if (desired) {
            containersSelect.value = desired;
            sendLogRequest(desired);
          }
        } catch (error) {
          containersSelect.innerHTML = "";
          const option = document.createElement("option");
          option.value = "";
          option.textContent = "Failed to load containers";
          option.disabled = true;
          option.selected = true;
          containersSelect.appendChild(option);
          console.error(error);
        }
      }

      socket.on("connect", () => {
        socketConnected = true;
        setStatus("connected", "Connected");
        if (selectedContainer) {
          socket.send(podName, selectedContainer);
          term.reset();
        }
      });

      socket.on('response', function(msg) {
        term.write(msg.data + "\r\n");
        totalLines++;
        if (totalLines % 100 === 0) {
          lineCount.style.display = "inline";
          lineCountValue.textContent = totalLines.toLocaleString();
        }
      });

      socket.on("disconnect", () => {
        setStatus("disconnected", "Disconnected");
      });

      containersSelect.addEventListener("change", (event) => {
        sendLogRequest(event.target.value);
      });

      // Copy logs to clipboard
      document.getElementById("copyLogsBtn").addEventListener("click", () => {
        const text = term.buffer.active.getLength() > 0
          ? Array.from({length: term.rows}, (_, i) =>
              term.buffer.active.getLine(i)?.translateToString(true) || "").join("\n")
          : "";
        navigator.clipboard.writeText(text).then(() => {
          showToast("success", "Logs copied to clipboard", "Success");
        }).catch(() => {
          showToast("error", "Failed to copy logs", "Error");
        });
      });

      // Download logs
      document.getElementById("downloadLogsBtn").addEventListener("click", () => {
        const text = Array.from({length: term.buffer.active.getLength()}, (_, i) =>
          term.buffer.active.getLine(i)?.translateToString(true) || "").join("\n");
        const blob = new Blob([text], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${namespace}_${podName}_logs.txt`;
        a.click();
        URL.revokeObjectURL(url);
        showToast("success", `Logs downloaded for ${podName}`, "Success");
      });

      loadContainers();

      // Event delegation for inline forms (CSP-compliant)
      document.addEventListener('click', function(e) {
          const link = e.target.closest('.form-submit-link');
        if (link) {
              e.preventDefault();
              const formId = link.dataset.formId;
              if (formId) {
                  document.getElementById(formId)?.submit();
              } else {
                  const form = link.closest('form');
                  if (form) form.submit();
              }
          }
      });

      document.addEventListener('submit', function(e) {
          if (e.target.classList.contains('inline-form')) {
              e.preventDefault();
              const form = e.target;
              const nsSessionKey = form.dataset.namespaceSessionKey;
              const nsSessionValue = form.dataset.namespaceValue;
              if (nsSessionKey && nsSessionValue) sessionStorage.setItem(nsSessionKey, nsSessionValue);
              form.submit();
          }
      });
    </script>
{% endblock %}
