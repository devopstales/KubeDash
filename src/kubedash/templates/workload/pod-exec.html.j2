{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Workloads</span></li>
          <li class="breadcrumb-item"><span>Pods</span></li>
          <li class="breadcrumb-item">
            <div class="d-flex">
              <form action="/workload/pods/data" method="POST" class="form-post inline-form" data-namespace-session-key="ns_select" data-namespace-value="{{ session['ns_select'] }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="ns_select" value="{{ session['ns_select'] }}" />
                <input type="hidden" name="po_name" value="{{ po_name }}" />
                <a href="#" class="form-submit-link">{{ po_name }}</a>
              </form>
            </div>
          </li>
          <li class="breadcrumb-item active"><span>Shell</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card">
    <div id="filter-menu" class="card-header">
      <div class="row justify-content-between">
        <div class="col-3">
          <span>Status: <span id="status">connecting...</span></span>
        </div>
        <form name="add" method="POST" class="col-3">
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
          <input type="hidden" name="po_name" value="{{ po_name }}">
          <div class="input-group">
              <select name="container_select" class="form-select" id="containers" aria-label="Select Container">
                <option value="" selected disabled>Loading containers...</option>
              </select>
              <button type="submit" class="btn btn-primary" type="button">Submit</button>
              <button type="button" class="btn btn-outline-secondary" id="disconnectBtn" title="Disconnect from shell">Disconnect</button>
          </div>
        </form>
      </div>
    </div>
    <div id="terminal" class="card-body terminalBody"></div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% include "segments/components/socket_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
    <script nonce="{{ csp_nonce }}">
        const term = new Terminal({
          cursorBlink: true,
          macOptionIsMeta: true,
          scrollback: 10000,
        });

        term.attachCustomKeyEventHandler(customKeyEventHandler);
        // https://github.com/xtermjs/xterm.js/issues/2941
        const fit = new FitAddon.FitAddon();
        term.loadAddon(fit);
        term.loadAddon(new WebLinksAddon.WebLinksAddon());
        term.loadAddon(new SearchAddon.SearchAddon());

        term.open(document.getElementById('terminal'));
        fit.fit();

        term.onKey(e => {
            socket.emit("exec-input", {"input": e.key})
        });

        // Paste: use paste event so it works on Windows (Ctrl+V), Linux (Ctrl+Shift+V), macOS (Cmd+V), and context menu.
        // Only send to server; do not term.write() — the server echoes input back, so we'd get double output.
        term.element.addEventListener("paste", function(e) {
          const text = (e.clipboardData || window.clipboardData).getData("text/plain");
          if (text && socket && socket.connected) {
            socket.emit("exec-input", { input: text });
          }
          e.preventDefault();
        });

        const socket = io.connect('/exec');
        const status = document.getElementById("status");
        const containersSelect = document.getElementById("containers");
        const podName = "{{ po_name | e }}";
        const namespace = "{{ session['ns_select'] | e }}";
        const initialContainer = "{{ container_select | default('', true) | e }}";

        let socketConnected = false;
        let selectedContainer = "";

        function sendExecRequest(containerName) {
          if (!containerName) {
            return;
          }
          selectedContainer = containerName;
          if (socketConnected) {
            socket.send(podName, containerName);
            term.reset();
          }
        }

        function buildContainerOptions(containers, initContainers) {
          containersSelect.innerHTML = "";

          if ((!containers || containers.length === 0) && (!initContainers || initContainers.length === 0)) {
            const option = document.createElement("option");
            option.value = "";
            option.textContent = "No containers found";
            option.disabled = true;
            option.selected = true;
            containersSelect.appendChild(option);
            return;
          }

          if (initContainers && initContainers.length > 0) {
            const initGroup = document.createElement("optgroup");
            initGroup.label = "Init containers";
            initContainers.forEach((name) => {
              const option = document.createElement("option");
              option.value = name;
              option.textContent = name;
              initGroup.appendChild(option);
            });
            containersSelect.appendChild(initGroup);
          }

          if (containers && containers.length > 0) {
            const mainGroup = document.createElement("optgroup");
            mainGroup.label = "Containers";
            containers.forEach((name) => {
              const option = document.createElement("option");
              option.value = name;
              option.textContent = name;
              mainGroup.appendChild(option);
            });
            containersSelect.appendChild(mainGroup);
          }
        }

        async function loadContainers() {
          try {
            const url = `/api/v1/workloads/pods/${encodeURIComponent(podName)}/containers?namespace=${encodeURIComponent(namespace)}`;
            const response = await fetch(url, { headers: { "Accept": "application/json" } });
            if (!response.ok) {
              throw new Error(`Container fetch failed: ${response.status}`);
            }
            const payload = await response.json();
            const containers = (payload.data && payload.data.containers) || [];
            const initContainers = (payload.data && payload.data.init_containers) || [];

            buildContainerOptions(containers, initContainers);

            const desired = initialContainer || (containers[0] || initContainers[0] || "");
            if (desired) {
              containersSelect.value = desired;
              sendExecRequest(desired);
            }
          } catch (error) {
            containersSelect.innerHTML = "";
            const option = document.createElement("option");
            option.value = "";
            option.textContent = "Failed to load containers";
            option.disabled = true;
            option.selected = true;
            containersSelect.appendChild(option);
            console.error(error);
          }
        }

        socket.on("connect", () => {
          socketConnected = true;
          status.innerHTML = '<span class="connected">connected</span>';
          if (selectedContainer) {
            socket.send(podName, selectedContainer);
            term.reset();
          }
        });

        socket.on("response", function(msg){
            term.write(msg.output)
        });

        socket.on("closed", function(msg){
          status.innerHTML =
            '<span class="disconnected">disconnected</span>';
          if (msg && msg.message) {
            term.writeln("\r\n" + (msg.message || "Stream ended."));
          }
        });

        socket.on("disconnect", () => {
          status.innerHTML =
            '<span class="disconnected">disconnected</span>';
        });

        containersSelect.addEventListener("change", (event) => {
          sendExecRequest(event.target.value);
        });

        document.getElementById("disconnectBtn").addEventListener("click", () => {
          if (socket && socket.connected) {
            socket.emit("stop");
          }
        });

        loadContainers();

        // Event delegation for inline forms (CSP-compliant)
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('form-submit-link')) {
                e.preventDefault();
                const formId = e.target.dataset.formId;
                if (formId) {
                    document.getElementById(formId)?.submit();
                } else {
                    const form = e.target.closest('form');
                    if (form) form.submit();
                }
            }
        });

        document.addEventListener('submit', function(e) {
            if (e.target.classList.contains('inline-form')) {
                e.preventDefault();
                const form = e.target;
                const nsSessionKey = form.dataset.namespaceSessionKey;
                const nsSessionValue = form.dataset.namespaceValue;
                if (nsSessionKey && nsSessionValue) sessionStorage.setItem(nsSessionKey, nsSessionValue);
                form.submit();
            }
        });

        /**
         * Handle copy and paste key shortcuts. We must do paste here for Cmd+V/Ctrl+V
         * because preventing default stops the browser from firing the paste event.
         * Context-menu paste still uses the "paste" event listener.
         */
        function customKeyEventHandler(e) {
          if (e.type !== "keydown") {
            return true;
          }
          const key = e.key.toLowerCase();
          // Paste: Ctrl+V (Windows/Linux), Cmd+V (macOS), Ctrl+Shift+V — do it here so it works when we preventDefault
          if (key === "v" && (e.ctrlKey || e.metaKey)) {
            e.preventDefault();
            if (navigator.clipboard && navigator.clipboard.readText) {
              navigator.clipboard.readText().then(function(toPaste) {
                if (toPaste && socket && socket.connected) {
                  socket.emit("exec-input", { input: toPaste });
                }
              }).catch(function() {});
            }
            return false;
          }
          // Copy: Ctrl+C / Cmd+C when there is selection
          if ((e.ctrlKey || e.metaKey) && !e.shiftKey && (key === "c" || key === "x")) {
            const toCopy = term.getSelection();
            if (toCopy) {
              const clip = (navigator.clipboard && navigator.clipboard.writeText) ? navigator.clipboard : null;
              if (clip) {
                clip.writeText(toCopy).catch(function() {});
              } else if (window.clipboardData) {
                window.clipboardData.setData("Text", toCopy);
              }
              term.focus();
              e.preventDefault();
              return false;
            }
          }
          // Ctrl+Shift+C / Ctrl+Shift+X: copy selection (alternate when Ctrl+C is SIGINT)
          if (e.ctrlKey && e.shiftKey && (key === "c" || key === "x")) {
            const toCopy = term.getSelection();
            if (toCopy) {
              const clip = (navigator.clipboard && navigator.clipboard.writeText) ? navigator.clipboard : null;
              if (clip) {
                clip.writeText(toCopy).catch(function() {});
              } else if (window.clipboardData) {
                window.clipboardData.setData("Text", toCopy);
              }
              term.focus();
              e.preventDefault();
              return false;
            }
          }
          return true;
        }
    </script>
{% endblock %}