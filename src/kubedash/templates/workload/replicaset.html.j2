{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Workloads</span></li>
          <li class="breadcrumb-item active"><span>ReplicaSets</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">ReplicaSet List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Name</th>
                      <th>Desired</th>
                      <th>Current</th>
                      <th>Ready</th>
                      <th>Owner</th>
                    </tr>
                  </thead>
                  <tbody id="replicasets-tbody">
                    <tr>
                        <td colspan="5" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading replicasets...</span>
                        </td>
                    </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'replicasetsTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    // Get namespace from topbar selector or use default
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value;
        }
        // Fallback to sessionStorage or default
        return sessionStorage.getItem('ns_select') || 'default';
    }
    
    function populateReplicaSetsTable(replicasets) {
        const tbody = document.getElementById('replicasets-tbody');
        
        if (!replicasets || replicasets.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center">No replicasets found</td></tr>';
            return;
        }
        
        // Get selected replicaset from URL
        const urlParams = new URLSearchParams(window.location.search);
        const selectedReplicaSet = urlParams.get('selected');
        const namespace = getSelectedNamespace();
        
        const rows = replicasets.map(replicaset => {
            const name = escapeHtml(replicaset.name || '');
            const desired = replicaset.desired || 0;
            const current = replicaset.current || 0;
            const ready = replicaset.ready || 0;
            const owner = replicaset.owner || '';
            
            const isSelected = selectedReplicaSet === replicaset.name;
            const rowClass = isSelected ? 'selected' : '';
            
            // Owner link
            let ownerCell = '<td>-</td>';
            if (owner) {
                const ownerParts = owner.split('/');
                if (ownerParts.length >= 2) {
                    const ownerKind = ownerParts[0].toLowerCase();
                    const ownerName = escapeHtml(ownerParts[1]);
                    ownerCell = `
                        <td>
                            <form action="/workload/${ownerKind}" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(namespace)}'); return true;">
                                <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                                <input type="hidden" name="selected" value="${ownerName}" />
                                <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(owner)}</a>
                            </form>
                        </td>
                    `;
                } else {
                    ownerCell = '<td>' + escapeHtml(owner) + '</td>';
                }
            }
            
            return `
                <tr class="${rowClass}">
                    <td>${name}</td>
                    <td>${desired}</td>
                    <td>${current}</td>
                    <td>${ready}</td>
                    ${ownerCell}
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    $('#dataTable').DataTable({
                        responsive: true,
                        order: [[0, 'asc']],
                        pageLength: 25
                    });
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    async function loadReplicaSets(namespace) {
        try {
            const apiUrl = `/api/v1/workloads/replicasets${namespace ? '?namespace=' + encodeURIComponent(namespace) : ''}`;
            console.log('Fetching replicasets from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('ReplicaSets API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load replicasets');
            }
            
            const replicasets = data.data || [];
            populateReplicaSetsTable(replicasets);
            
        } catch (error) {
            console.error('Error loading replicasets:', error);
            const tbody = document.getElementById('replicasets-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading replicasets: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        const namespace = getSelectedNamespace();
        loadReplicaSets(namespace);
    });
    
    // Reload data when namespace changes (if namespace selector exists)
    document.addEventListener('DOMContentLoaded', function() {
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', function() {
                const namespace = this.value;
                console.log('Namespace changed to:', namespace);
                sessionStorage.setItem('ns_select', namespace);
                loadReplicaSets(namespace);
            });
        }
    });
</script>
{% endblock %}