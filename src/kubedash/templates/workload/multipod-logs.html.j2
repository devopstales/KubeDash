{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Workloads</span></li>
          <li class="breadcrumb-item"><span id="workload-kind-breadcrumb">{{ workload_kind | title }}</span></li>
          <li class="breadcrumb-item active"><span id="workload-name-breadcrumb">{{ workload_name }}</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card log-viewer-card"
     data-workload-kind="{{ workload_kind | e }}"
     data-workload-name="{{ workload_name | e }}"
     data-namespace="{{ session['ns_select'] | e }}"
     data-feature-enabled="{{ feature_enabled | default('true', true) | e }}">
    
    <!-- Workload Header -->
    <div class="card-header multipod-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="m-0" id="workload-title">
                    {{ workload_kind | title }}: {{ workload_name }}
                </h5>
                <small class="text-muted" id="namespace-display">Namespace: {{ session['ns_select'] }}</small>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <div class="pod-count-badge">
                    <span id="pod-count">0</span> pods
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div id="log-toolbar" class="log-toolbar">
      <div class="toolbar-row">
        <div class="toolbar-group">
          <label class="toolbar-checkbox">
            <input type="checkbox" id="auto-scroll-toggle" checked />
            Auto-scroll
          </label>
        </div>

        <div class="toolbar-group">
          <label class="toolbar-checkbox">
            <input type="checkbox" id="timestamp-toggle" checked />
            Timestamps
          </label>
        </div>

        <div class="toolbar-group">
          <label for="level-filter" class="toolbar-label">Level</label>
          <div id="level-filter" class="level-filter-dropdown">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-coreui-toggle="dropdown" aria-expanded="false">
              All Levels
            </button>
            <ul class="dropdown-menu level-filter-menu">
              <li><label class="dropdown-item level-checkbox-label"><input type="checkbox" class="level-cb" value="ERROR" checked /> <span class="level-badge level-error">ERROR</span></label></li>
              <li><label class="dropdown-item level-checkbox-label"><input type="checkbox" class="level-cb" value="WARN" checked /> <span class="level-badge level-warn">WARN</span></label></li>
              <li><label class="dropdown-item level-checkbox-label"><input type="checkbox" class="level-cb" value="INFO" checked /> <span class="level-badge level-info">INFO</span></label></li>
              <li><label class="dropdown-item level-checkbox-label"><input type="checkbox" class="level-cb" value="DEBUG" checked /> <span class="level-badge level-debug">DEBUG</span></label></li>
              <li><label class="dropdown-item level-checkbox-label"><input type="checkbox" class="level-cb" value="FATAL" checked /> <span class="level-badge level-fatal">FATAL</span></label></li>
              <li class="dropdown-divider"></li>
              <li><label class="dropdown-item level-checkbox-label"><input type="checkbox" class="level-cb" value="UNKNOWN" checked /> Unknown</label></li>
            </ul>
          </div>
        </div>

        <div class="toolbar-group">
          <label class="toolbar-checkbox">
            <input type="checkbox" id="auto-discovery-toggle" checked />
            Auto-discover pods
          </label>
        </div>

        <div class="toolbar-group toolbar-flex-grow">
          <div class="search-bar">
            <input type="text" id="search-input" class="form-control form-control-sm" placeholder="Search logs..." />
            <span id="search-match-count" class="search-match-count"></span>
            <button type="button" id="search-prev" class="btn btn-sm btn-outline-secondary" title="Previous match" disabled>&#9650;</button>
            <button type="button" id="search-next" class="btn btn-sm btn-outline-secondary" title="Next match" disabled>&#9660;</button>
            <button type="button" id="search-clear" class="btn btn-sm btn-outline-secondary" title="Clear search" disabled>&times;</button>
          </div>
        </div>

        <div class="toolbar-group">
          <button type="button" id="export-btn" class="btn btn-sm btn-outline-secondary" title="Export logs">Export</button>
          <div class="dropdown d-inline">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-coreui-toggle="dropdown" aria-expanded="false" id="export-format-dropdown">
              Text
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item export-format-link" href="#" data-format="text">Text (.log)</a></li>
              <li><a class="dropdown-item export-format-link" href="#" data-format="json">JSON (.jsonl)</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Pod Selector -->
    <div id="pod-selector" class="pod-selector">
        <div class="pod-selector-header">
            <span class="pod-selector-title">Pods</span>
            <button type="button" id="show-all-pods" class="btn btn-sm btn-link active">All Pods</button>
        </div>
        <div id="pod-list" class="pod-list">
            <div class="text-muted p-2">Loading pods...</div>
        </div>
    </div>

    <!-- Log Content -->
    <div id="log-content" class="log-content" tabindex="0"></div>

    <!-- Status Bar -->
    <div id="log-status-bar" class="log-status-bar">
      <div class="status-left">
        <span id="connection-status" class="status-indicator status-connecting">Initializing...</span>
        <span id="buffer-usage" class="buffer-usage"></span>
      </div>
      <div class="status-right">
        <span id="line-count" class="line-count"></span>
        <button type="button" id="reconnect-btn" class="btn btn-sm btn-link status-reconnect" style="display: none;">Reconnect</button>
      </div>
    </div>
</div>

<!-- Hidden export form for triggering downloads -->
<a id="download-link" style="display: none;"></a>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% include "segments/components/socket_snippet.html.j2" %}
<style nonce="{{ csp_nonce }}">
.log-viewer-card {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 200px);
  min-height: 400px;
}

.multipod-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.multipod-header h5 {
  color: white;
  font-weight: 600;
}

.multipod-header .text-muted {
  color: rgba(255, 255, 255, 0.8) !important;
}

.pod-count-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 600;
}

.pod-count-badge #pod-count {
  font-size: 18px;
  margin-right: 4px;
}

.log-toolbar {
  display: flex;
  gap: 8px;
  padding: 8px 12px;
  border-bottom: 1px solid var(--border-color, #303b4a);
  background: var(--surface-color, #1e2a3a);
  flex-wrap: wrap;
  align-items: flex-end;
}

.toolbar-row {
  display: flex;
  gap: 12px;
  width: 100%;
  align-items: flex-end;
  flex-wrap: wrap;
}

.toolbar-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.toolbar-flex-grow {
  flex: 1;
  min-width: 200px;
}

.toolbar-label {
  font-size: 11px;
  color: var(--text-muted, #8a96a3);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.toolbar-checkbox {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  cursor: pointer;
  padding-top: 18px;
}

.toolbar-checkbox input[type="checkbox"] {
  margin: 0;
}

.level-filter-dropdown {
  position: relative;
}

.level-filter-menu {
  min-width: 140px;
  padding: 4px 0;
}

.level-checkbox-label {
  padding: 2px 12px;
  cursor: pointer;
}

.level-checkbox-label input {
  margin-right: 6px;
}

.level-badge {
  font-weight: 600;
  font-size: 11px;
  padding: 1px 5px;
  border-radius: 3px;
}

.level-error { color: #f85149; }
.level-warn { color: #d29922; }
.level-info { color: #58a6ff; }
.level-debug { color: #8b949e; }
.level-fatal { color: #f47067; }

.search-bar {
  display: flex;
  align-items: center;
  gap: 4px;
}

.search-match-count {
  font-size: 12px;
  color: var(--text-muted, #8a96a3);
  white-space: nowrap;
  min-width: 60px;
}

/* Pod Selector Styles */
.pod-selector {
  border-bottom: 1px solid var(--border-color, #303b4a);
  background: var(--surface-color, #1e2a3a);
}

.pod-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 12px;
  border-bottom: 1px solid var(--border-color, #303b4a);
}

.pod-selector-title {
  font-weight: 600;
  font-size: 13px;
}

.pod-list {
  max-height: 150px;
  overflow-y: auto;
  padding: 4px 0;
}

.pod-list-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  cursor: pointer;
  transition: background 0.2s;
}

.pod-list-item:hover {
  background: rgba(255, 255, 255, 0.05);
}

.pod-list-item.active {
  background: rgba(102, 126, 234, 0.2);
}

.pod-color-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

.pod-list-item-name {
  flex: 1;
  font-family: 'Cascadia Code', 'Fira Code', monospace;
  font-size: 12px;
}

.pod-list-item-status {
  font-size: 11px;
  color: var(--text-muted, #8a96a3);
}

.log-content {
  flex: 1;
  overflow-y: auto;
  font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Courier New', monospace;
  font-size: 13px;
  line-height: 1.5;
  background: #0d1117;
  color: #c9d1d9;
  padding: 8px;
  scroll-behavior: smooth;
}

.log-line {
  display: flex;
  gap: 8px;
  padding: 1px 4px;
  border-radius: 2px;
  white-space: pre-wrap;
  word-break: break-word;
}

.log-line:hover {
  background: rgba(255, 255, 255, 0.05);
}

.log-line.hidden-by-filter {
  display: none;
}

.log-timestamp {
  color: #8b949e;
  user-select: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.log-timestamp.hidden {
  display: none;
}

.log-pod-name {
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.log-message {
  flex: 1;
}

.log-level-error .log-message { color: #f85149; }
.log-level-warn .log-message  { color: #d29922; }
.log-level-fatal .log-message { color: #f47067; }
.log-level-info .log-message  { color: #58a6ff; }
.log-level-debug .log-message { color: #8b949e; }

.search-match {
  background: rgba(187, 128, 9, 0.4);
  border-radius: 2px;
}

.search-match-current {
  background: rgba(187, 128, 9, 0.7);
  outline: 2px solid #d29922;
}

.log-status-bar {
  display: flex;
  justify-content: space-between;
  padding: 4px 12px;
  font-size: 12px;
  color: var(--text-muted, #8a96a3);
  border-top: 1px solid var(--border-color, #303b4a);
  background: var(--surface-color, #1e2a3a);
}

.status-left, .status-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.status-indicator::before {
  content: '';
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.status-connecting::before { background: #d29922; animation: pulse 1s infinite; }
.status-streaming::before { background: #3fb950; }
.status-disconnected::before { background: #8b949e; }
.status-error::before { background: #f85149; }
.status-completed::before { background: #58a6ff; }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.buffer-usage.warning {
  color: #d29922;
  font-weight: 600;
}

.buffer-usage.critical {
  color: #f85149;
  font-weight: 600;
}

/* Responsive layout for tablets */
@media (max-width: 992px) {
  .log-toolbar {
    padding: 6px 8px;
  }

  .toolbar-row {
    gap: 8px;
  }

  .toolbar-flex-grow {
    width: 100%;
    order: -1;
  }

  .search-bar {
    width: 100%;
  }

  #search-input {
    flex: 1;
  }
}
</style>
{% endblock %}

{% block add_tail_js %}
    <script src="{{ url_for('static', filename='js/log_viewer/log_level_detector.js') }}"></script>
    <script src="{{ url_for('static', filename='js/log_viewer/log_buffer.js') }}"></script>
    <script src="{{ url_for('static', filename='js/log_viewer/log_filter.js') }}"></script>
    <script src="{{ url_for('static', filename='js/log_viewer/log_renderer.js') }}"></script>
    <script src="{{ url_for('static', filename='js/log_viewer/log_search.js') }}"></script>
    <script src="{{ url_for('static', filename='js/log_viewer/log_exporter.js') }}"></script>
    <script src="{{ url_for('static', filename='js/log_viewer/multi_pod_aggregator.js') }}"></script>
    <script nonce="{{ csp_nonce }}">
    (function() {
      'use strict';

      let aggregator = null;
      let logSearch = null;
      let exportFormat = 'text';

      document.addEventListener('DOMContentLoaded', function() {
        const card = document.querySelector('.log-viewer-card');
        if (!card) return;

        const workloadKind = card.dataset.workloadKind;
        const workloadName = card.dataset.workloadName;
        const namespace = card.dataset.namespace;
        const container = document.getElementById('log-content');

        if (!container || !workloadKind || !workloadName) {
          console.error('Missing required parameters for multi-pod log viewer');
          return;
        }

        // Initialize MultiPodAggregator
        aggregator = new MultiPodAggregator({
          container: container,
          namespace: namespace,
          workloadKind: workloadKind,
          workloadName: workloadName,
          maxLines: 10000,
          autoDiscovery: true,
          autoDiscoveryInterval: 30000,
          onStateChange: updateConnectionState,
          onBufferUpdate: updateBufferDisplay
        });

        // Create search instance
        logSearch = new LogSearch(aggregator.mergedBuffer, aggregator.renderer);
        aggregator.setSearch(logSearch);

        // Initialize the aggregator
        aggregator.initialize(workloadKind, workloadName, namespace);

        // Wire up toolbar controls
        wireToolbar();
      });

      function wireToolbar() {
        const autoScrollToggle = document.getElementById('auto-scroll-toggle');
        const timestampToggle = document.getElementById('timestamp-toggle');
        const searchInput = document.getElementById('search-input');
        const searchMatchCount = document.getElementById('search-match-count');
        const searchPrev = document.getElementById('search-prev');
        const searchNext = document.getElementById('search-next');
        const searchClear = document.getElementById('search-clear');
        const exportBtn = document.getElementById('export-btn');
        const autoDiscoveryToggle = document.getElementById('auto-discovery-toggle');

        // Auto-scroll toggle
        if (autoScrollToggle) {
          autoScrollToggle.addEventListener('change', (e) => {
            if (aggregator) aggregator.setAutoScroll(e.target.checked);
          });
        }

        // Timestamp toggle
        if (timestampToggle) {
          timestampToggle.addEventListener('change', (e) => {
            if (aggregator) aggregator.setTimestampVisibility(e.target.checked);
          });
        }

        // Level filter
        const levelCheckboxes = document.querySelectorAll('.level-cb');
        levelCheckboxes.forEach(cb => {
          cb.addEventListener('change', () => {
            if (!aggregator) return;
            const activeLevels = [];
            levelCheckboxes.forEach(c => {
              if (c.checked) activeLevels.push(c.value);
            });
            aggregator.setLevels(activeLevels);
          });
        });

        // Auto-discovery toggle
        if (autoDiscoveryToggle) {
          autoDiscoveryToggle.addEventListener('change', (e) => {
            if (aggregator) aggregator.setAutoDiscovery(e.target.checked);
          });
        }

        // Search
        let searchTimeout = null;
        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
              const query = e.target.value.trim();
              if (query && logSearch) {
                logSearch.search(query);
                searchMatchCount.textContent = `${logSearch.matches.length} matches`;
                searchClear.disabled = false;
                searchPrev.disabled = logSearch.matches.length === 0;
                searchNext.disabled = logSearch.matches.length === 0;
              } else if (logSearch) {
                logSearch.clear();
                searchMatchCount.textContent = '';
                searchClear.disabled = true;
                searchPrev.disabled = true;
                searchNext.disabled = true;
              }
            }, 300);
          });
        }

        if (searchPrev) {
          searchPrev.addEventListener('click', () => {
            if (logSearch) {
              logSearch.prevMatch();
              updateSearchMatchCount();
            }
          });
        }

        if (searchNext) {
          searchNext.addEventListener('click', () => {
            if (logSearch) {
              logSearch.nextMatch();
              updateSearchMatchCount();
            }
          });
        }

        if (searchClear) {
          searchClear.addEventListener('click', () => {
            if (logSearch) {
              logSearch.clear();
              searchInput.value = '';
              searchMatchCount.textContent = '';
              searchClear.disabled = true;
              searchPrev.disabled = true;
              searchNext.disabled = true;
            }
          });
        }

        // Export
        if (exportBtn) {
          exportBtn.addEventListener('click', () => {
            if (!aggregator) return;
            const entries = aggregator.mergedBuffer.getFilteredLines(aggregator.filter);
            const filename = generateExportFilename();
            if (exportFormat === 'json') {
              LogExporter.exportAsJson(entries, { filename });
            } else {
              LogExporter.exportAsText(entries, { filename, timestamps: true, tsFormat: 'iso' });
            }
          });
        }

        const formatDropdown = document.getElementById('export-format-dropdown');
        if (formatDropdown) {
          formatDropdown.querySelectorAll('.export-format-link').forEach(link => {
            link.addEventListener('click', (e) => {
              e.preventDefault();
              exportFormat = e.target.dataset.format;
              formatDropdown.textContent = exportFormat === 'json' ? 'JSON' : 'Text';
            });
          });
        }
      }

      function updateSearchMatchCount() {
        const searchMatchCount = document.getElementById('search-match-count');
        if (logSearch && logSearch.matches.length > 0) {
          searchMatchCount.textContent = `${logSearch.currentMatchIndex + 1}/${logSearch.matches.length}`;
        } else {
          searchMatchCount.textContent = '0 matches';
        }
      }

      function updateConnectionState(state) {
        const statusEl = document.getElementById('connection-status');
        const reconnectBtn = document.getElementById('reconnect-btn');
        const stateLabels = {
          connecting: 'Connecting...',
          streaming: 'Streaming',
          disconnected: 'Disconnected',
          error: 'Connection Error',
          completed: 'Completed'
        };
        statusEl.className = `status-indicator status-${state}`;
        statusEl.textContent = stateLabels[state] || state;
        if (reconnectBtn) {
          reconnectBtn.style.display = (state === 'disconnected' || state === 'error') ? 'inline' : 'none';
        }
      }

      function updateBufferDisplay(buffer) {
        const util = buffer.getUtilization();
        const bufferUsageEl = document.getElementById('buffer-usage');
        const lineCountEl = document.getElementById('line-count');
        const podCountEl = document.getElementById('pod-count');

        if (bufferUsageEl) {
          const pct = Math.round(util.usage * 100);
          bufferUsageEl.textContent = `${util.current} / ${util.max} lines`;
          bufferUsageEl.className = 'buffer-usage';
          if (util.usage > 0.9) bufferUsageEl.classList.add('critical');
          else if (util.usage > 0.8) bufferUsageEl.classList.add('warning');
        }

        if (lineCountEl) {
          lineCountEl.textContent = `Total: ${util.totalReceived} | Evicted: ${util.evicted}`;
        }

        if (podCountEl && aggregator) {
          podCountEl.textContent = Object.keys(aggregator.viewers).length;
        }
      }

      function generateExportFilename() {
        const workloadName = document.querySelector('.log-viewer-card').dataset.workloadName;
        const now = new Date();
        const ts = now.toISOString().replace(/[:.]/g, '-').substring(0, 19);
        return `${workloadName || 'workload'}-logs-${ts}.log`;
      }
    })();
    </script>
{% endblock %}
