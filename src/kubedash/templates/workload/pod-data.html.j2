{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Workloads</span></li>
          <li class="breadcrumb-item"><a href="/workload/pods">Pod</a></li>
          <li class="breadcrumb-item active"><span id="pod-name-breadcrumb">Loading...</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
    <div id="pod-actions-container" class="container-fluid d-flex justify-content-end py-2 px-2" style="display: none;">
        <form id="pod-exec-form" action="/workload/pods/exec" method="POST" class="form-post me-2">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="ns_select" id="pod-exec-namespace" />
            <input type="hidden" name="po_name" id="pod-exec-name" />
            <a class="card-link" data-bs-toggle="collapse" href="javascript:;" onclick="document.getElementById('pod-exec-form').submit();">
                <i class="material-icons">input</i>
            </a>
        </form>
        <form id="pod-logs-form" action="/workload/pods/logs" method="POST" class="form-post">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="ns_select" id="pod-logs-namespace" />
            <input type="hidden" name="po_name" id="pod-logs-name" />
            <a class="card-link" data-bs-toggle="collapse" href="javascript:;" onclick="document.getElementById('pod-logs-form').submit();">
                <i class="material-icons">list</i>
            </a>
        </form>
    </div>
{% include "segments/topmenu.html.j2" %}
{% endblock %}

