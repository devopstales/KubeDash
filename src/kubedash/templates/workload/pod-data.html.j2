{% block add_tail_js %}
    <script>
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // Get pod name and namespace from URL, sessionStorage, or form
    function getPodInfo() {
        const urlParams = new URLSearchParams(window.location.search);
        let podName = urlParams.get('po_name');
        let namespace = urlParams.get('namespace');
        
        if (!podName) {
            podName = sessionStorage.getItem('pod_data_name');
        }
        if (!namespace) {
            namespace = sessionStorage.getItem('pod_data_namespace');
        }
        
        // Fallback to topbar selector
        if (!namespace) {
            const topbarSelect = document.getElementById('inputGroupSelect04');
            if (topbarSelect) {
                namespace = topbarSelect.value;
            }
        }
        
        // Final fallback
        if (!namespace) {
            namespace = sessionStorage.getItem('ns_select') || 'default';
        }
        
        return { podName, namespace };
    }
    
    function populatePodData(podData) {
        const { podName, namespace } = getPodInfo();
        
        // Update breadcrumb
        const breadcrumb = document.getElementById('pod-name-breadcrumb');
        if (breadcrumb) {
            breadcrumb.textContent = podData.name || podName || 'Pod';
        }
        
        // Update pod info table
        document.getElementById('pod-namespace').textContent = escapeHtml(podData.namespace || namespace || '');
        document.getElementById('pod-name').textContent = escapeHtml(podData.name || '');
        
        // Status badge
        const status = podData.status || 'Unknown';
        let statusBadge = '';
        if (status === 'Running') {
            statusBadge = '<span class="badge text-bg-success">' + escapeHtml(status) + '</span>';
        } else if (status === 'Pending') {
            statusBadge = '<span class="badge text-bg-warning">' + escapeHtml(status) + '</span>';
        } else if (status === 'Succeeded') {
            statusBadge = '<span class="badge text-bg-secondary">' + escapeHtml(status) + '</span>';
        } else if (status === 'Terminated' || status === 'CrashLoopBackOff') {
            statusBadge = '<span class="badge text-bg-danger">' + escapeHtml(status) + '</span>';
        } else {
            statusBadge = '<span class="badge text-bg-secondary">' + escapeHtml(status) + '</span>';
        }
        document.getElementById('pod-status').innerHTML = statusBadge;
        
        document.getElementById('pod-restarts').textContent = podData.restarts || '0';
        document.getElementById('pod-created').textContent = escapeHtml(podData.created || '');
        
        // Node link
        const node = podData.node || '';
        if (node) {
            document.getElementById('pod-node').innerHTML = `
                <form action="/cluster/node" method="POST" onsubmit="sessionStorage.setItem('node_data_name', '${escapeHtml(node)}'); return true;">
                    <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                    <input type="hidden" name="selected" value="${escapeHtml(node)}" />
                    <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(node)}</a>
                </form>
            `;
        } else {
            document.getElementById('pod-node').textContent = '-';
        }
        
        // Owner link
        const owner = podData.owner || '';
        if (owner) {
            const ownerParts = owner.split('/');
            if (ownerParts.length >= 2) {
                const ownerKind = ownerParts[0].toLowerCase();
                const ownerName = escapeHtml(ownerParts[1]);
                document.getElementById('pod-owner').innerHTML = `
                    <form action="/workload/${ownerKind}" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(podData.namespace || namespace)}'); return true;">
                        <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                        <input type="hidden" name="ns_select" value="${escapeHtml(podData.namespace || namespace)}" />
                        <input type="hidden" name="selected" value="${ownerName}" />
                        <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(owner)}</a>
                    </form>
                `;
            } else {
                document.getElementById('pod-owner').textContent = escapeHtml(owner);
            }
        } else {
            document.getElementById('pod-owner').textContent = '-';
        }
        
        document.getElementById('pod-priority').textContent = escapeHtml(podData.priority || '-');
        document.getElementById('pod-priority-class').textContent = escapeHtml(podData.priority_class_name || '-');
        document.getElementById('pod-runtime-class').textContent = escapeHtml(podData.runtime_class_name || '-');
        
        // Annotations
        const annotationsContainer = document.getElementById('pod-annotations-container');
        if (podData.annotations && Object.keys(podData.annotations).length > 0) {
            annotationsContainer.innerHTML = `
                <table class="table table-bordered" id="annotationTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th width="50%">Key</th>
                            <th width="50%">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${Object.entries(podData.annotations).map(([key, value]) => `
                            <tr>
                                <td width="50%">${escapeHtml(key)}</td>
                                <td width="50%">${escapeHtml(value)}</td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        } else {
            annotationsContainer.innerHTML = '<span class="text-muted">No annotations</span>';
        }
        
        // Labels
        const labelsContainer = document.getElementById('pod-labels-container');
        if (podData.labels && Object.keys(podData.labels).length > 0) {
            labelsContainer.innerHTML = `
                <table class="table table-bordered" id="labelsTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th width="50%">Key</th>
                            <th width="50%">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${Object.entries(podData.labels).map(([key, value]) => `
                            <tr>
                                <td width="50%">${escapeHtml(key)}</td>
                                <td width="50%">${escapeHtml(value)}</td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        } else {
            labelsContainer.innerHTML = '<span class="text-muted">No labels</span>';
        }
        
        // Show/hide actions based on containers
        const actionsContainer = document.getElementById('pod-actions-container');
        if (podData.init_containers && podData.init_containers.length > 0 || podData.containers && podData.containers.length > 0) {
            if (actionsContainer) {
                actionsContainer.style.display = 'block';
                document.getElementById('pod-exec-name').value = podData.name || podName || '';
                document.getElementById('pod-exec-namespace').value = podData.namespace || namespace || '';
                document.getElementById('pod-logs-name').value = podData.name || podName || '';
                document.getElementById('pod-logs-namespace').value = podData.namespace || namespace || '';
            }
        }
        
        // Populate containers
        populateContainers(podData);
        
        // Populate conditions
        populateConditions(podData.conditions || []);
        
        // Populate security contexts
        populateSecurityContext(podData.security_context || {});
        
        // Populate related resources
        populateRelatedResources(podData, namespace);
        
        // Load events
        loadPodEvents(podData.name || podName, podData.namespace || namespace);
    }
    
    function populateContainers(podData) {
        // Init containers
        const initContainersSection = document.getElementById('init-containers-section');
        const initContainersTbody = document.getElementById('init-containers-tbody');
        
        if (podData.init_containers && podData.init_containers.length > 0) {
            initContainersSection.style.display = 'block';
            initContainersTbody.innerHTML = podData.init_containers.map(ic => {
                const ready = ic.ready || 'Unknown';
                let statusBadge = '';
                if (ready === 'Completed') {
                    statusBadge = '<span class="badge text-bg-secondary">' + escapeHtml(ready) + '</span>';
                } else if (ready === 'ImagePullBackOff' || ready === 'ErrImagePull' || ready === 'Error' || ready === 'CrashLoopBackOff') {
                    statusBadge = '<span class="badge text-bg-danger">' + escapeHtml(ready) + '</span>';
                } else {
                    statusBadge = '<span class="badge text-bg-secondary">' + escapeHtml(ready) + '</span>';
                }
                return `
                    <tr>
                        <td>${statusBadge}</td>
                        <td>${escapeHtml(ic.name || '')}</td>
                        <td>${escapeHtml(ic.image || '')}</td>
                        <td>${escapeHtml(ic.restarts || '0')}</td>
                    </tr>
                `;
            }).join('');
        } else {
            initContainersSection.style.display = 'none';
            initContainersTbody.innerHTML = '';
        }
        
        // Containers
        const containersTbody = document.getElementById('containers-tbody');
        if (podData.containers && podData.containers.length > 0) {
            containersTbody.innerHTML = podData.containers.map(c => {
                const ready = c.ready || 'Unknown';
                let statusBadge = '';
                if (ready === 'Running') {
                    statusBadge = '<span class="badge text-bg-success">' + escapeHtml(ready) + '</span>';
                } else if (ready === 'ImagePullBackOff' || ready === 'ErrImagePull' || ready === 'Error' || ready === 'CrashLoopBackOff') {
                    statusBadge = '<span class="badge text-bg-danger">' + escapeHtml(ready) + '</span>';
                } else if (ready === 'PodInitializing') {
                    statusBadge = '<span class="badge text-bg-info">' + escapeHtml(ready) + '</span>';
                } else {
                    statusBadge = '<span class="badge text-bg-secondary">' + escapeHtml(ready) + '</span>';
                }
                return `
                    <tr>
                        <td>${statusBadge}</td>
                        <td>${escapeHtml(c.name || '')}</td>
                        <td>${escapeHtml(c.image || '')}</td>
                        <td>${escapeHtml(c.restarts || '0')}</td>
                    </tr>
                `;
            }).join('');
        } else {
            containersTbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No containers found</td></tr>';
        }
    }
    
    function populateConditions(conditions) {
        const tbody = document.getElementById('conditions-tbody');
        if (conditions && conditions.length > 0) {
            tbody.innerHTML = conditions.map(cond => {
                return Object.entries(cond).map(([key, value]) => `
                    <tr>
                        <td>${escapeHtml(key)}</td>
                        <td>${escapeHtml(value)}</td>
                    </tr>
                `).join('');
            }).join('');
        } else {
            tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">No conditions found</td></tr>';
        }
    }
    
    function populateSecurityContext(securityContext) {
        const tbody = document.getElementById('security-tbody');
        if (securityContext && Object.keys(securityContext).length > 0) {
            tbody.innerHTML = Object.entries(securityContext).map(([key, value]) => {
                const valueStr = typeof value === 'object' ? JSON.stringify(value) : String(value);
                return `
                    <tr>
                        <td>${escapeHtml(key)}</td>
                        <td>${escapeHtml(valueStr)}</td>
                    </tr>
                `;
            }).join('');
        } else {
            tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">No security context found</td></tr>';
        }
    }
    
    function populateRelatedResources(podData, namespace) {
        const ns = podData.namespace || namespace || '';
        
        // Referred By (owner)
        const referredByTbody = document.getElementById('referred-by-tbody');
        if (podData.owner) {
            const ownerParts = podData.owner.split('/');
            if (ownerParts.length >= 2) {
                const ownerKind = ownerParts[0].toLowerCase();
                const ownerName = escapeHtml(ownerParts[1]);
                referredByTbody.innerHTML = `
                    <tr>
                        <td>${escapeHtml(ownerParts[0])}</td>
                        <td>
                            <form action="/workload/${ownerKind}" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(ns)}'); return true;">
                                <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                <input type="hidden" name="ns_select" value="${escapeHtml(ns)}" />
                                <input type="hidden" name="selected" value="${ownerName}" />
                                <a href="javascript:;" onclick="parentNode.submit();">${ownerName}</a>
                            </form>
                        </td>
                        <td>${escapeHtml(ns)}</td>
                    </tr>
                `;
            } else {
                referredByTbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No owner found</td></tr>';
            }
        } else {
            referredByTbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No owner found</td></tr>';
        }
        
        // Refers To
        const refersToTbody = document.getElementById('refers-to-tbody');
        let refersToRows = [];
        
        // Image pull secrets
        if (podData.image_pull_secrets && podData.image_pull_secrets.length > 0) {
            podData.image_pull_secrets.forEach(ips => {
                if (typeof ips === 'object') {
                    Object.entries(ips).forEach(([key, value]) => {
                        if (key === 'name' || value) {
                            const secretName = escapeHtml(value || '');
                            refersToRows.push(`
                                <tr>
                                    <td>ImagePullSecret</td>
                                    <td>
                                        <form action="/security/secret" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(ns)}'); return true;">
                                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                            <input type="hidden" name="ns_select" value="${escapeHtml(ns)}" />
                                            <input type="hidden" name="selected" value="${secretName}" />
                                            <a href="javascript:;" onclick="parentNode.submit();">${secretName}</a>
                                        </form>
                                    </td>
                                    <td>${escapeHtml(ns)}</td>
                                </tr>
                            `);
                        }
                    });
                }
            });
        }
        
        // Service account
        if (podData.service_account) {
            refersToRows.push(`
                <tr>
                    <td>ServiceAccount</td>
                    <td>
                        <form action="/cluster-permission/service-account" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(ns)}'); return true;">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(ns)}" />
                            <input type="hidden" name="selected" value="${escapeHtml(podData.service_account)}" />
                            <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(podData.service_account)}</a>
                        </form>
                    </td>
                    <td>${escapeHtml(ns)}</td>
                </tr>
            `);
        }
        
        // Secrets
        if (podData.secrets && podData.secrets.length > 0) {
            podData.secrets.forEach(secret => {
                refersToRows.push(`
                    <tr>
                        <td>Secret</td>
                        <td>
                            <form action="/security/secret" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(ns)}'); return true;">
                                <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                <input type="hidden" name="ns_select" value="${escapeHtml(ns)}" />
                                <input type="hidden" name="selected" value="${escapeHtml(secret)}" />
                                <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(secret)}</a>
                            </form>
                        </td>
                        <td>${escapeHtml(ns)}</td>
                    </tr>
                `);
            });
        }
        
        // ConfigMaps
        if (podData.cm && podData.cm.length > 0) {
            podData.cm.forEach(cm => {
                refersToRows.push(`
                    <tr>
                        <td>ConfigMap</td>
                        <td>
                            <form action="/storage/configmap" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(ns)}'); return true;">
                                <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                <input type="hidden" name="ns_select" value="${escapeHtml(ns)}" />
                                <input type="hidden" name="selected" value="${escapeHtml(cm)}" />
                                <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(cm)}</a>
                            </form>
                        </td>
                        <td>${escapeHtml(ns)}</td>
                    </tr>
                `);
            });
        }
        
        // PVCs
        if (podData.pvc && podData.pvc.length > 0) {
            podData.pvc.forEach(pvc => {
                refersToRows.push(`
                    <tr>
                        <td>PersistentVolumeClaim</td>
                        <td>
                            <form action="/storage/pvc" method="POST" onsubmit="sessionStorage.setItem('ns_select', '${escapeHtml(ns)}'); return true;">
                                <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                <input type="hidden" name="ns_select" value="${escapeHtml(ns)}" />
                                <input type="hidden" name="selected" value="${escapeHtml(pvc)}" />
                                <a href="javascript:;" onclick="parentNode.submit();">${escapeHtml(pvc)}</a>
                            </form>
                        </td>
                        <td>${escapeHtml(ns)}</td>
                    </tr>
                `);
            });
        }
        
        if (refersToRows.length > 0) {
            refersToTbody.innerHTML = refersToRows.join('');
        } else {
            refersToTbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No related resources found</td></tr>';
        }
    }
    
    function populateEvents(events) {
        const tbody = document.getElementById('events-tbody');
        if (events && events.length > 0) {
            tbody.innerHTML = events.map(event => {
                // Type badge
                let typeBadge = '';
                if (event.type === 'Normal') {
                    typeBadge = '<span class="badge text-bg-success">' + escapeHtml(event.type) + '</span>';
                } else if (event.type === 'Warning') {
                    typeBadge = '<span class="badge text-bg-warning">' + escapeHtml(event.type) + '</span>';
                } else {
                    typeBadge = '<span class="badge text-bg-secondary">' + escapeHtml(event.type || 'Unknown') + '</span>';
                }
                
                // Format timestamps
                const firstTimestamp = event.first_timestamp ? new Date(event.first_timestamp).toLocaleString() : '-';
                const lastTimestamp = event.last_timestamp ? new Date(event.last_timestamp).toLocaleString() : '-';
                
                return `
                    <tr>
                        <td>${typeBadge}</td>
                        <td>${escapeHtml(event.reason || '-')}</td>
                        <td>${escapeHtml(event.message || '-')}</td>
                        <td>${escapeHtml(event.count || '1')}</td>
                        <td>${escapeHtml(firstTimestamp)}</td>
                        <td>${escapeHtml(lastTimestamp)}</td>
                        <td>${escapeHtml(event.source || event.reporting_controller || '-')}</td>
                    </tr>
                `;
            }).join('');
        } else {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No events found</td></tr>';
        }
    }
    
    async function loadPodEvents(podName, namespace) {
        if (!podName || !namespace) {
            const tbody = document.getElementById('events-tbody');
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Pod information not available</td></tr>';
            return;
        }
        
        try {
            const apiUrl = `/api/v1/workloads/pods/${encodeURIComponent(podName)}/events?namespace=${encodeURIComponent(namespace)}&limit=100`;
            console.log('Fetching pod events from:', apiUrl);
            console.log('Pod name:', podName, 'Namespace:', namespace);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                const errorText = await response.text();
                console.error('API error response:', response.status, errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Pod events API response:', data);
            console.log('Number of events found:', data.data ? data.data.length : 0);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load pod events');
            }
            
            populateEvents(data.data || []);
            
        } catch (error) {
            console.error('Error loading pod events:', error);
            const tbody = document.getElementById('events-tbody');
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error: ' + escapeHtml(error.message) + '</td></tr>';
        }
    }
    
    async function loadPodData() {
        const { podName, namespace } = getPodInfo();
        
        if (!podName) {
            console.error('Pod name not found in URL, sessionStorage, or form.');
            document.getElementById('pod-name-breadcrumb').textContent = 'Error';
            document.getElementById('pod-name').textContent = 'Error: Pod name not provided.';
            return;
        }
        
        try {
            const apiUrl = `/api/v1/workloads/pods/${encodeURIComponent(podName)}?namespace=${encodeURIComponent(namespace)}`;
            console.log('Fetching pod data from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Pod data API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load pod data');
            }
            
            populatePodData(data.data);
            
        } catch (error) {
            console.error('Error loading pod data:', error);
            document.getElementById('pod-name-breadcrumb').textContent = 'Error';
            document.getElementById('pod-name').textContent = 'Error: ' + escapeHtml(error.message);
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadPodData();
        });
    </script>
