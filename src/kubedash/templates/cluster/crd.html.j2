{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Cluster</span></li>
          <li class="breadcrumb-item active"><span>CRDs</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">CRD List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
              <thead>
                    <tr>
                      <th>Resource</th>
                      <th>Group</th>
                      <th>Version</th>
                      <th>Scope</th>
                      <th>Action</th>
                    </tr>
              </thead>
              <tbody id="crds-tbody">
                    <tr>
                        <td colspan="5" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading CRDs...</span>
                        </td>
                    </tr>
            </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'crdsTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    function populateCRDsTable(crds) {
        const tbody = document.getElementById('crds-tbody');
        
        if (!crds || crds.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center">No CRDs found</td></tr>';
            return;
        }
        
        const rows = crds.map(crd => {
            const name = escapeHtml(crd.name || '');
            const kind = escapeHtml(crd.kind || '');
            const group = escapeHtml(crd.group || '');
            const version = escapeHtml(crd.version || '');
            const scope = escapeHtml(crd.scope || '');
            
            // Store CRD info in sessionStorage for navigation
            const crdInfo = {
                name: crd.name,
                kind: crd.kind,
                group: crd.group,
                version: crd.version,
                scope: crd.scope
            };
            
            return `
                <tr>
                    <td>
                        <form action="/cluster/crd/data" method="POST" onsubmit="sessionStorage.setItem('crd_data_info', JSON.stringify(${JSON.stringify(crdInfo)})); return true;">
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="crd_name" value="${name}" />
                            <input type="hidden" name="crd_kind" value="${kind}" />
                            <input type="hidden" name="crd_group" value="${group}" />
                            <input type="hidden" name="crd_version" value="${version}" />
                            ${crd.scope === 'Namespaced' ? `<input type="hidden" name="crd_scope" value="${scope}" />` : ''}
                            <a href="javascript:;" onclick="parentNode.submit();">${kind}</a>
                        </form>
                    </td>
                    <td>${group}</td>
                    <td>${version}</td>
                    <td>${scope}</td>
                    <td></td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    $('#dataTable').DataTable({
                        responsive: true,
                        order: [[0, 'asc']],
                        pageLength: 25
                    });
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    document.addEventListener('DOMContentLoaded', async function() {
        try {
            const response = await fetch('/api/v1/other-resources/crds');
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('CRDs API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load CRDs');
            }
            
            const crds = data.data || [];
            populateCRDsTable(crds);
            
        } catch (error) {
            console.error('Error loading CRDs:', error);
            const tbody = document.getElementById('crds-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading CRDs: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    });
</script>
{% endblock %}