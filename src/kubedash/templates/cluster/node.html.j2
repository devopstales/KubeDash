{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Cluster</span></li>
          <li class="breadcrumb-item active"><span>Nodes</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Node List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>State</th>
                      <th>Name</th>
                      <th>Role</th>
                      <th>Version</th>
                      <th>IP</th>
                      <th>OS</th>
                      <th>CPU Usage</th>
                      <th>Memory Usage</th>
                    </tr>
                  </thead>
                  <tbody id="nodes-tbody">
                    <tr>
                        <td colspan="8" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading nodes...</span>
                        </td>
                    </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    const csrf_token = {{ csrf_token()|tojson }};
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'nodesTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        // Check if DataTable is initialized using try-catch
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        // Check if DataTable is initialized using try-catch
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    function populateNodesTable(nodes, metrics) {
        const tbody = document.getElementById('nodes-tbody');
        
        if (!nodes || nodes.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center">No nodes found</td></tr>';
            return;
        }
        
        // Create a lookup map for metrics by node name
        const metricsMap = {};
        if (metrics && metrics.nodes && Array.isArray(metrics.nodes)) {
            metrics.nodes.forEach(nodeMetric => {
                if (nodeMetric.name) {
                    metricsMap[nodeMetric.name] = nodeMetric;
                }
            });
        }
        
        // Get selected node from URL or sessionStorage
        const urlParams = new URLSearchParams(window.location.search);
        const selectedNode = urlParams.get('selected') || sessionStorage.getItem('selected_node');
        
        const rows = nodes.map(node => {
            const nodeName = escapeHtml(node.name || '');
            const status = node.status || 'Unknown';
            const role = escapeHtml(node.role || 'Worker');
            const version = escapeHtml(node.version || '');
            const ip = escapeHtml(node.ip || '');
            const os = escapeHtml(node.os || '');
            
            const isSelected = selectedNode === node.name;
            const rowClass = isSelected ? 'selected' : '';
            
            // Status badge
            const statusBadge = status === 'Ready'
                ? '<span class="badge text-bg-success">' + escapeHtml(status) + '</span>'
                : '<span class="badge text-bg-danger">' + escapeHtml(status) + '</span>';
            
            // Get metrics for this node
            const nodeMetrics = metricsMap[node.name];
            let cpuUsageHtml = '<td></td>';
            let memoryUsageHtml = '<td></td>';
            
            if (nodeMetrics && nodeMetrics.cpu && nodeMetrics.memory) {
                const cpuUsagePercent = Math.round(nodeMetrics.cpu.usagePercent || 0);
                const memoryUsagePercent = Math.round(nodeMetrics.memory.usagePercent || 0);
                
                cpuUsageHtml = `
                    <td>
                        <div class="progress position-relative" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" style="width: ${cpuUsagePercent}%" aria-valuenow="${cpuUsagePercent}" aria-valuemin="0" aria-valuemax="100"></div>
                            <small class="justify-content-center d-flex position-absolute w-100">${cpuUsagePercent}%</small>
                        </div>
                    </td>
                `;
                
                memoryUsageHtml = `
                    <td>
                        <div class="progress position-relative" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" style="width: ${memoryUsagePercent}%" aria-valuenow="${memoryUsagePercent}" aria-valuemin="0" aria-valuemax="100"></div>
                            <small class="justify-content-center d-flex position-absolute w-100">${memoryUsagePercent}%</small>
                        </div>
                    </td>
                `;
            }
            
            // Use JSON.stringify for JavaScript string values to prevent XSS
            const nodeNameJson = JSON.stringify(node.name || '');
            return `
                <tr class="${rowClass}">
                    <td>${statusBadge}</td>
                    <td>
                        <form action="/cluster/node/data" method="POST" data-node-name="${escapeHtml(nodeName)}" >
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="no_name" value="${escapeHtml(nodeName)}" />
                            <input type="hidden" name="selected" value="${escapeHtml(nodeName)}" />
                            <a href="#" class="form-submit-link">${nodeName}</a>
                        </form>
                    </td>
                    <td>${role}</td>
                    <td>${version}</td>
                    <td>${ip}</td>
                    <td>${os}</td>
                    ${cpuUsageHtml}
                    ${memoryUsageHtml}
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    const dataTable = $('#dataTable').DataTable({
                        responsive: true,
                        order: [[1, 'asc']],
                        pageLength: 25
                    });
                    
                    // Navigate to selected row if present
                    if (selectedNode) {
                        let foundRowIndex = -1;
                        dataTable.rows().every(function(rowIdx) {
                            const rowNode = this.node();
                            const rowName = $(rowNode).find('input[name="selected"]').val();
                            if (rowName === selectedNode) {
                                foundRowIndex = rowIdx;
                                return false; // break
                            }
                            return true;
                        });
                        
                        if (foundRowIndex >= 0) {
                            const pageLength = dataTable.page.len();
                            const targetPage = Math.floor(foundRowIndex / pageLength);
                            dataTable.page(targetPage).draw('page');
                        }
                    }
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    document.addEventListener('DOMContentLoaded', async function() {
        try {
            // Fetch nodes and metrics in parallel
            const [nodesResponse, metricsResponse] = await Promise.all([
                fetch('/api/v1/nodes'),
                fetch('/api/v1/cluster/metrics')
            ]);
            
            if (!nodesResponse.ok) {
                throw new Error(`HTTP error! status: ${nodesResponse.status}`);
            }
            
            const nodesData = await nodesResponse.json();
            console.log('Nodes API response:', nodesData);
            
            let metrics = null;
            if (metricsResponse.ok) {
                const metricsData = await metricsResponse.json();
                console.log('Metrics API response:', metricsData);
                metrics = metricsData.data || null;
            } else {
                console.warn('Failed to load metrics:', metricsResponse.status);
            }
            
            const nodes = nodesData.data || [];
            populateNodesTable(nodes, metrics);
            
        } catch (error) {
            console.error('Error loading nodes:', error);
            const tbody = document.getElementById('nodes-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-danger">Error loading nodes: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    });

    // Event delegation for form submission links (CSP-compliant)
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            // Set sessionStorage based on form inputs
            const inputs = form.querySelectorAll('input[type="hidden"]');
            inputs.forEach(input => {
                if (input.name && input.value) {
                    sessionStorage.setItem(input.name, input.value);
                }
            });
        }
    });
</script>
{% endblock %}
