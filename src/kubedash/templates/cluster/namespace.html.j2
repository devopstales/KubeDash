{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Cluster</span></li>
          <li class="breadcrumb-item active"><span>Namespaces</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
  <!-- Button trigger modal add -->
  {% if session['user_role'] == "Admin" %}
  <div class="col">
    <button class="header-toggler" type="button" data-bs-toggle="modal" data-bs-target="#modaladd">
      <i class="material-icons">add</i>
    </button>
  </div>
  {% endif %}
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<!-- DataTales -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Namespace List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Namespace</th>
                        <th>Repository</th>
                        <th>Pipeline</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="namespaces-tbody">
                    <tr>
                        <td colspan="6" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading namespaces...</span>
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- Modal Add Namespace -->
<div class="modal fade" id="modaladd" tabindex="-1" role="dialog" aria-labelledby="modaladdLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modaladdLabel">New</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form action="/cluster/namespace/create" method="POST">
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
          <div class="form-group">
            <label>Namespace:</label>
            <input class="form-control user" name="namespace" type="text" placeholder="Type your username">
          </div>
          <div class="modal-footer">
            <div class="form-group mt-2">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary" >Add Namespace</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<!-- Modal Add Namespace -->
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    // IMMEDIATE: Prevent datatables-demo.js from initializing on loading row
    (function() {
        function setupOverride() {
            if (typeof $ !== 'undefined' && $.fn && !window._datatableOverrideSetup) {
                window._datatableOverrideSetup = true;
                const originalDataTable = $.fn.DataTable;
                $.fn.DataTable = function(options) {
                    const table = this[0];
                    if (table && table.id === 'dataTable') {
                        const tbody = table.querySelector('tbody');
                        if (tbody) {
                            const rows = tbody.querySelectorAll('tr');
                            const hasColspanRow = Array.from(rows).some(row => {
                                const cells = row.querySelectorAll('td');
                                return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                            });
                            if (hasColspanRow) {
                                console.log('Blocked DataTable initialization on loading row');
                                return this;
                            }
                        }
                    }
                    return originalDataTable.apply(this, arguments);
                };
                Object.setPrototypeOf($.fn.DataTable, originalDataTable);
                Object.keys(originalDataTable).forEach(key => {
                    $.fn.DataTable[key] = originalDataTable[key];
                });
            }
        }
        setupOverride();
        setTimeout(setupOverride, 0);
        setTimeout(setupOverride, 50);
        setTimeout(setupOverride, 100);
    })();
    
    (function() {
        function checkAndDestroyAutoInit() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById('dataTable');
                if (table && $.fn.DataTable.isDataTable(table)) {
                    const tbody = table.querySelector('tbody');
                    if (tbody) {
                        const rows = tbody.querySelectorAll('tr');
                        const hasColspanRow = Array.from(rows).some(row => {
                            const cells = row.querySelectorAll('td');
                            return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                        });
                        if (hasColspanRow) {
                            console.log('Destroying auto-initialized DataTable on loading row');
                            try {
                                $(table).DataTable().destroy();
                            } catch(e) {
                                console.error('Error destroying DataTable:', e);
                            }
                        }
                    }
                }
            }
        }
        if (typeof $ !== 'undefined') {
            checkAndDestroyAutoInit();
        }
        setTimeout(checkAndDestroyAutoInit, 50);
        setTimeout(checkAndDestroyAutoInit, 100);
        setTimeout(checkAndDestroyAutoInit, 200);
        setTimeout(checkAndDestroyAutoInit, 500);
        setTimeout(checkAndDestroyAutoInit, 1000);
    })();
    
    const csrf_token = {{ csrf_token()|tojson }};
    const selected_namespace = {{ (request.args.get('selected') or '')|tojson }};
    const user_role = {{ session.get('user_role', '')|tojson }};
    const is_admin = user_role === 'Admin';
    const namespaces_api_url = '/api/v1/namespaces';
    
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    function populateNamespacesTable(namespaces) {
        const tbody = document.getElementById('namespaces-tbody');
        const table = document.getElementById('dataTable');
        
        if (table && typeof $ !== 'undefined' && $.fn.DataTable && $.fn.DataTable.isDataTable(table)) {
            $(table).DataTable().destroy();
        }
        
        tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="ms-2">Processing namespaces...</span>
                </td>
            </tr>
        `;
        
        if (!namespaces || namespaces.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No namespaces found</td></tr>';
            return;
        }
        
        // Filter out null/undefined namespaces
        const validNamespaces = namespaces.filter(ns => ns && ns !== null && typeof ns === 'object');
        
        if (validNamespaces.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No valid namespaces found</td></tr>';
            return;
        }
        
        const rowsHtml = validNamespaces.map(ns => {
            const name = escapeHtml(ns.name || '');
            const status = ns.status || 'Unknown';
            const isSelected = selected_namespace === ns.name;
            const rowClass = isSelected ? 'class="selected"' : '';
            const created = escapeHtml(ns.created || '');
            
            // Status badge
            const statusBadge = status === 'Active' 
                ? '<span class="badge text-bg-success">Active</span>'
                : '<span class="badge text-bg-danger">' + escapeHtml(status) + '</span>';
            
            // Repository link
            let repositoryCell = '-';
            if (ns.app_service && ns.app_service.repository) {
                const repo = ns.app_service.repository;
                if (repo && (repo.startsWith('http://') || repo.startsWith('https://'))) {
                    repositoryCell = `<a width="24" height="24" href="${escapeHtml(repo)}" target="_blank" rel="noopener noreferrer">
                        <i class="fa-solid fa-code-branch fa-lg" style="font-size: 24px;"></i>
                    </a>`;
                }
            }
            
            // Pipeline link
            let pipelineCell = '-';
            if (ns.app_service && ns.app_service.pipeline) {
                const pipeline = ns.app_service.pipeline;
                if (pipeline && (pipeline.startsWith('http://') || pipeline.startsWith('https://'))) {
                    pipelineCell = `<a href="${escapeHtml(pipeline)}" target="_blank" rel="noopener noreferrer">
                        <i class="fa-solid fa-diagram-project fa-lg" style="font-size: 24px;"></i>
                    </a>`;
                }
            }
            
            // Delete button (Admin only)
            let actionCell = '';
            if (is_admin) {
                actionCell = `
                    <div class="d-flex flex-row">
                        <form action="/cluster/namespace/delete" method="post">
                            <input type="hidden" name="csrf_token" value="${csrf_token}">
                            <input type="hidden" name="namespace" value="${escapeHtml(name)}"/>
                            <button type="submit" rel="tooltip" class="btn btn-danger btn-just-icon btn-sm" value="upvote">
                                <i class="material-icons">delete</i>
                            </button>
                        </form>
                    </div>
                `;
            }
            
            return `
                <tr ${rowClass}>
                    <td>${statusBadge}</td>
                    <td>
                        <form action="/cluster/namespace/data" method="POST" class="inline-form" data-namespace="${escapeHtml(name)}">
                            <input type="hidden" name="csrf_token" value="${csrf_token}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(name)}" />
                            <a href="#" class="form-submit-link">${name}</a>
                        </form>
                    </td>
                    <td>${repositoryCell}</td>
                    <td>${pipelineCell}</td>
                    <td>${created}</td>
                    <td>${actionCell}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rowsHtml;
        
        setTimeout(() => {
            const rows = tbody.querySelectorAll('tr');
            let hasDataRows = false;
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                const hasColspan = Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                if (!hasColspan && cells.length === 6) {
                    hasDataRows = true;
                }
            });
            
            if (!hasDataRows) return;
            
            if ($.fn.DataTable && $(table).length) {
                if ($.fn.DataTable.isDataTable(table)) {
                    const savedRows = tbody.innerHTML;
                    $(table).DataTable().destroy();
                    tbody.innerHTML = savedRows;
                }
                
                const dataRows = Array.from(tbody.querySelectorAll('tr')).filter(row => {
                    const cells = row.querySelectorAll('td');
                    return !Array.from(cells).some(cell => cell.hasAttribute('colspan')) && cells.length === 6;
                });
                
                if (dataRows.length > 0) {
                    $(table).DataTable({
                        responsive: true,
                        pageLength: 25
                    });
                }
            }
        }, 50);
    }
    
    document.addEventListener('DOMContentLoaded', async function() {
        let retries = 0;
        while ((typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') && retries < 10) {
            await new Promise(resolve => setTimeout(resolve, 100));
            retries++;
        }
        
        if (typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') {
            console.error('jQuery or DataTables not loaded');
            return;
        }
        
        const table = document.getElementById('dataTable');
        if (table && $.fn.DataTable && $.fn.DataTable.isDataTable(table)) {
            const tbody = table.querySelector('tbody');
            if (tbody) {
                const rows = tbody.querySelectorAll('tr');
                const hasColspanRow = Array.from(rows).some(row => {
                    const cells = row.querySelectorAll('td');
                    return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                });
                if (hasColspanRow) {
                    $(table).DataTable().destroy();
                }
            }
        }
        
        try {
            console.log('Fetching namespaces from:', namespaces_api_url);
            
            const response = await fetch(namespaces_api_url);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Namespaces API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load namespaces');
            }

            const namespaces = data.data || [];
            populateNamespacesTable(namespaces);

        } catch (error) {
            console.error('Error loading namespaces:', error);
            const tbody = document.getElementById('namespaces-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading namespaces: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    });

    // Event delegation for form submission links (CSP-compliant)
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            const namespace = form.dataset.namespace;
            if (namespace) {
                sessionStorage.setItem('ns_select', namespace);
            }
        }
    });
</script>
{% endblock %}