{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Cluster</span></li>
          <li class="breadcrumb-item"><a href="/cluster/crd">CRDs</a></li>
          <li class="breadcrumb-item active" id="crd-kind-breadcrumb">Loading...</li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary" id="crd-data-title">CRD Data</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
              <thead>
                    <tr>
                      <th>Name</th>
                      <th>Namespace</th>
                      <th>Status</th>
                      <th>Type</th>
                      <th>Reason</th>
                      <th>Message</th>
                      <th>Created</th>
                    </tr>
              </thead>
              <tbody id="crd-data-tbody">
                <tr>
                    <td colspan="7" class="text-center">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="ms-2">Loading CRD data...</span>
                    </td>
                </tr>
              </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const originalTableId = 'dataTable';
        const tempTableId = 'crdDataTable_' + Date.now();
        
        // Temporarily change table ID to prevent auto-initialization
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById(originalTableId);
            if (table) {
                table.id = tempTableId;
            }
        });
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
        
        // Clean up any auto-initialized DataTables
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 100);
        
        setTimeout(function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById(tempTableId);
                if (table) {
                    try {
                        const $table = $('#' + tempTableId);
                        if ($table.length && $table.data('DataTable')) {
                            $table.DataTable().destroy();
                        }
                    } catch (e) {
                        // DataTable not initialized or error, ignore
                    }
                    table.id = originalTableId;
                }
            }
        }, 500);
    })();
    
    // Get CRD parameters from URL query parameters, form data, or sessionStorage
    function getCRDParams() {
        const urlParams = new URLSearchParams(window.location.search);
        let crdName = urlParams.get('crd_name');
        let crdKind = urlParams.get('crd_kind');
        let crdGroup = urlParams.get('crd_group');
        let crdVersion = urlParams.get('crd_version');
        let crdScope = urlParams.get('crd_scope');
        
        // If not in query, check sessionStorage
        if (!crdName || !crdKind || !crdGroup || !crdVersion) {
            const storedInfo = sessionStorage.getItem('crd_data_info');
            if (storedInfo) {
                try {
                    const info = JSON.parse(storedInfo);
                    crdName = crdName || info.name;
                    crdKind = crdKind || info.kind;
                    crdGroup = crdGroup || info.group;
                    crdVersion = crdVersion || info.version;
                    crdScope = crdScope || info.scope;
                    sessionStorage.removeItem('crd_data_info');
                } catch (e) {
                    console.warn('Failed to parse stored CRD info:', e);
                }
            }
        }
        
        // If still not found, check form data
        if (!crdName || !crdKind || !crdGroup || !crdVersion) {
            const form = document.querySelector('form[action="/cluster/crd/data"]');
            if (form) {
                crdName = crdName || form.querySelector('input[name="crd_name"]')?.value;
                crdKind = crdKind || form.querySelector('input[name="crd_kind"]')?.value;
                crdGroup = crdGroup || form.querySelector('input[name="crd_group"]')?.value;
                crdVersion = crdVersion || form.querySelector('input[name="crd_version"]')?.value;
                crdScope = crdScope || form.querySelector('input[name="crd_scope"]')?.value;
            }
        }
        
        return { crdName, crdKind, crdGroup, crdVersion, crdScope };
    }
    
    function populateCRDDataTable(crdData) {
        const tbody = document.getElementById('crd-data-tbody');
        
        if (!crdData || crdData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center">No CRD data found</td></tr>';
            return;
        }
        
        console.log('Populating CRD data table with', crdData.length, 'items:', crdData);
        
        const rows = crdData.map(crd => {
            const name = escapeHtml(crd.name || '');
            const namespace = escapeHtml(crd.namespace || '');
            const status = escapeHtml(crd.status || '');
            const type = escapeHtml(crd.type || '');
            const reason = escapeHtml(crd.reason || '');
            const message = escapeHtml(crd.message || '');
            const created = crd.creationTimestamp || '';
            
            // Format creation timestamp
            let createdFormatted = '-';
            if (created) {
                try {
                    const date = new Date(created);
                    createdFormatted = date.toLocaleString();
                } catch (e) {
                    createdFormatted = created;
                }
            }
            
            // Status badge
            let statusBadge = '';
            if (status === 'True' || status === 'Ready' || status === 'Active') {
                statusBadge = '<span class="badge text-bg-success">' + escapeHtml(status) + '</span>';
            } else if (status === 'False' || status === 'Unknown' || status === 'Failed' || status === 'Error') {
                statusBadge = '<span class="badge text-bg-danger">' + escapeHtml(status) + '</span>';
            } else if (status) {
                statusBadge = '<span class="badge text-bg-secondary">' + escapeHtml(status) + '</span>';
            } else {
                statusBadge = '<span class="badge text-bg-secondary">-</span>';
            }
            
            return `
                <tr>
                    <td>${name}</td>
                    <td>${namespace || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>${type || '-'}</td>
                    <td>${reason || '-'}</td>
                    <td>${message || '-'}</td>
                    <td>${createdFormatted}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay to ensure DOM is updated
        setTimeout(function() {
            const table = document.getElementById('dataTable');
            if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    // Destroy existing DataTable if it exists
                    const $table = $('#dataTable');
                    if ($table.length && $table.data('DataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Initialize DataTables
                    $('#dataTable').DataTable({
                        responsive: true,
                        order: [[0, 'asc']],
                        pageLength: 25
                    });
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 50);
    }
    
    document.addEventListener('DOMContentLoaded', async function() {
        const { crdName, crdKind, crdGroup, crdVersion, crdScope } = getCRDParams();
        
        if (!crdName || !crdKind || !crdGroup || !crdVersion) {
            console.error('Missing CRD parameters');
            const breadcrumb = document.getElementById('crd-kind-breadcrumb');
            const tbody = document.getElementById('crd-data-tbody');
            if (breadcrumb) breadcrumb.textContent = 'Error';
            if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error: Missing CRD parameters</td></tr>';
            return;
        }
        
        // Update breadcrumb and title
        const breadcrumb = document.getElementById('crd-kind-breadcrumb');
        const title = document.getElementById('crd-data-title');
        if (breadcrumb) {
            breadcrumb.textContent = crdKind;
        }
        if (title) {
            title.textContent = `CRD Data - ${crdKind}`;
        }
        
        async function fetchCRDData(useNamespace) {
            // Build API URL
            const apiUrl = `/api/v1/other-resources/crds/${encodeURIComponent(crdGroup)}/${encodeURIComponent(crdVersion)}/${encodeURIComponent(crdKind)}`;
            const url = new URL(apiUrl, window.location.origin);
            
            // Add the CRD plural name (this is the correct resource name, not constructed from kind)
            url.searchParams.set('name', crdName);
            
            // Add namespace parameter only if explicitly requested and this is a namespaced CRD
            if (useNamespace && crdScope === 'Namespaced') {
                // Try to get namespace from multiple sources
                let namespace = null;
                
                // 1. Check URL query parameter
                const urlParams = new URLSearchParams(window.location.search);
                namespace = urlParams.get('namespace');
                
                // 2. Check topbar namespace selector
                if (!namespace) {
                    const topbarSelect = document.getElementById('inputGroupSelect04');
                    if (topbarSelect) {
                        namespace = topbarSelect.value;
                    }
                }
                
                // 3. Check sessionStorage
                if (!namespace) {
                    namespace = sessionStorage.getItem('ns_select');
                }
                
                // 4. Use default if still not found
                if (!namespace) {
                    namespace = 'default';
                }
                
                url.searchParams.set('namespace', namespace);
                console.log('Using namespace:', namespace);
            }
            
            console.log('Fetching CRD data from:', url.toString());
            
            const response = await fetch(url.toString());
            if (!response.ok) {
                const errorText = await response.text();
                console.error('API error response:', errorText);
                if (response.status === 404) {
                    return { error: 'NotFound', message: `CRD '${crdKind}' not found` };
                }
                return { error: 'HTTPError', message: `HTTP error! status: ${response.status} - ${errorText}` };
            }
            
            const data = await response.json();
            console.log('CRD data API response:', data);
            console.log('CRD data items count:', data.data ? data.data.length : 0);
            console.log('CRD metadata:', data.metadata);
            
            if (data.error) {
                console.error('API returned error:', data.error, data.message);
                return { error: data.error, message: data.message || 'Failed to load CRD data', data: data };
            }
            
            const items = data.data || [];
            console.log('Extracted items:', items.length, items);
            
            return { data: items, metadata: data.metadata };
        }
        
        try {
            // First, try with the scope from the CRD list
            let result;
            let triedFallback = false;
            
            if (crdScope === 'Namespaced') {
                // Try namespaced first
                result = await fetchCRDData(true);
                console.log('Initial namespaced query result:', result);
                
                // If namespaced query returns empty or has an error, try cluster-scoped as fallback
                // This handles cases where the scope detection is incorrect
                const isEmpty = !result.error && result.data && result.data.length === 0;
                const hasError = result.error;
                
                if (isEmpty || hasError) {
                    console.log('Namespaced query returned empty or error, trying cluster-scoped as fallback...');
                    triedFallback = true;
                    const clusterResult = await fetchCRDData(false);
                    console.log('Cluster-scoped fallback result:', clusterResult);
                    
                    // If cluster-scoped has data, use that (it's likely the correct scope)
                    if (!clusterResult.error && clusterResult.data && clusterResult.data.length > 0) {
                        console.log('Cluster-scoped query succeeded with data, using cluster-scoped result');
                        result = clusterResult;
                    } else if (hasError && !clusterResult.error) {
                        // If namespaced had error but cluster-scoped doesn't, use cluster-scoped
                        console.log('Using cluster-scoped result (namespaced had error)');
                        result = clusterResult;
                    } else if (isEmpty && !clusterResult.error) {
                        // If namespaced was empty but cluster-scoped succeeded (even if also empty), prefer cluster-scoped
                        // This indicates the resource is actually cluster-scoped
                        console.log('Using cluster-scoped result (namespaced was empty, resource is cluster-scoped)');
                        result = clusterResult;
                    }
                    // Otherwise keep the original result
                }
            } else {
                // Cluster-scoped, just fetch without namespace
                result = await fetchCRDData(false);
            }
            
            if (result.error) {
                throw new Error(result.message || 'Failed to load CRD data');
            }
            
            const crdData = result.data || [];
            console.log('Final CRD data items:', crdData.length, crdData);
            
            if (crdData.length === 0) {
                // Show a more informative message with debugging info
                const tbody = document.getElementById('crd-data-tbody');
                if (tbody) {
                    let namespaceMsg = '';
                    let debugInfo = '';
                    
                    if (result.metadata) {
                        if (result.metadata.namespace) {
                            namespaceMsg = ` in namespace '${result.metadata.namespace}'`;
                        } else {
                            namespaceMsg = ' (cluster-scoped)';
                        }
                        
                        // Add debug info to help troubleshoot
                        debugInfo = `<br><small class="text-info">API: Group=${result.metadata.group}, Version=${result.metadata.version}, Plural=${result.metadata.plural || crdName}${result.metadata.namespace ? ', Namespace=' + result.metadata.namespace : ''}</small>`;
                    }
                    
                    const message = `No ${crdKind} resources found${namespaceMsg}. This might be normal if no resources of this type exist yet.${debugInfo}`;
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">${message}</td></tr>`;
                }
                return;
            }
            
            populateCRDDataTable(crdData);
            
        } catch (error) {
            console.error('Error loading CRD data:', error);
            const tbody = document.getElementById('crd-data-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error loading CRD data: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    });
</script>
{% endblock %}