{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Cluster</span></li>
          <li class="breadcrumb-item"><a href="/cluster/namespace">Namespaces</a></li>
          <li class="breadcrumb-item active" id="namespace-name-breadcrumb">Loading...</li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Namespace Data</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="namespaceInfoTable" width="100%" cellspacing="0">
                <tbody id="namespace-info-tbody">
                    <tr>
                        <td colspan="2" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading namespace data...</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div> 
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script>
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    // Get namespace name from URL query parameter, form data, or sessionStorage
    function getNamespaceName() {
        const urlParams = new URLSearchParams(window.location.search);
        let namespaceName = urlParams.get('namespace');
        
        // If not in query, check sessionStorage
        if (!namespaceName) {
            namespaceName = sessionStorage.getItem('namespace_data_name');
            if (namespaceName) {
                sessionStorage.removeItem('namespace_data_name');
            }
        }
        
        // If still not found, check form data
        if (!namespaceName) {
            const form = document.querySelector('form[action="/cluster/namespace/data"]');
            if (form) {
                const nsInput = form.querySelector('input[name="ns_select"]');
                if (nsInput) {
                    namespaceName = nsInput.value;
                }
            }
        }
        
        return namespaceName;
    }
    
    function populateNamespaceData(namespace) {
        const tbody = document.getElementById('namespace-info-tbody');
        
        if (!namespace) {
            tbody.innerHTML = '<tr><td colspan="2" class="text-center text-danger">Error: Namespace data not found</td></tr>';
            return;
        }
        
        const name = escapeHtml(namespace.name || '');
        const status = namespace.status || 'Unknown';
        const created = escapeHtml(namespace.created || '');
        
        // Status badge
        const statusBadge = status === 'Active' 
            ? '<span class="badge text-bg-tag text-bg-success">Active</span>'
            : '<span class="badge text-bg-tag text-bg-danger">' + escapeHtml(status) + '</span>';
        
        // Annotations table
        let annotationsHtml = '<p class="text-muted">No annotations</p>';
        if (namespace.annotations && typeof namespace.annotations === 'object') {
            const annotations = Array.isArray(namespace.annotations) 
                ? Object.fromEntries(namespace.annotations.map(([k, v]) => [k, v]))
                : namespace.annotations;
            
            const annotationEntries = Object.entries(annotations);
            if (annotationEntries.length > 0) {
                annotationsHtml = `
                    <table class="table table-bordered" id="annotationTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th width="50%">Key</th>
                                <th width="50%">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${annotationEntries.map(([key, value]) => `
                                <tr>
                                    <td width="50%">${escapeHtml(key)}</td>
                                    <td width="50%">${escapeHtml(String(value))}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                `;
            }
        }
        
        // Labels table
        let labelsHtml = '<p class="text-muted">No labels</p>';
        if (namespace.labels) {
            let labels = namespace.labels;
            // Handle both array and object formats
            if (Array.isArray(labels)) {
                labels = Object.fromEntries(labels.map(([k, v]) => [k, v]));
            }
            
            if (typeof labels === 'object' && labels !== null) {
                const labelEntries = Object.entries(labels);
                if (labelEntries.length > 0) {
                    labelsHtml = `
                        <table class="table table-bordered" id="labelsTable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th width="50%">Key</th>
                                    <th width="50%">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${labelEntries.map(([key, value]) => `
                                    <tr>
                                        <td width="50%">${escapeHtml(key)}</td>
                                        <td width="50%">${escapeHtml(String(value))}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    `;
                }
            }
        }
        
        tbody.innerHTML = `
            <tr>
                <th>Status:</th>
                <td>${statusBadge}</td>
            </tr>
            <tr>
                <th>Name:</th>
                <td>${name}</td>
            </tr>
            <tr>
                <th>Created:</th>
                <td>${created}</td>
            </tr>
            <tr>
                <th>Annotations:</th>
                <td>${annotationsHtml}</td>
            </tr>
            <tr>
                <th>Labels:</th>
                <td>${labelsHtml}</td>
            </tr>
        `;
    }
    
    document.addEventListener('DOMContentLoaded', async function() {
        const namespaceName = getNamespaceName();
        
        if (!namespaceName) {
            console.error('No namespace name provided');
            const breadcrumb = document.getElementById('namespace-name-breadcrumb');
            const tbody = document.getElementById('namespace-info-tbody');
            if (breadcrumb) breadcrumb.textContent = 'Error';
            if (tbody) tbody.innerHTML = '<tr><td colspan="2" class="text-center text-danger">Error: Namespace name not provided</td></tr>';
            return;
        }
        
        // Update breadcrumb
        const breadcrumb = document.getElementById('namespace-name-breadcrumb');
        if (breadcrumb) {
            breadcrumb.textContent = namespaceName;
        }
        
        try {
            const apiUrl = `/api/v1/namespaces/${encodeURIComponent(namespaceName)}`;
            console.log('Fetching namespace from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error(`Namespace '${namespaceName}' not found`);
                }
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Namespace API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load namespace');
            }
            
            const namespace = data.data || {};
            populateNamespaceData(namespace);
            
        } catch (error) {
            console.error('Error loading namespace:', error);
            const tbody = document.getElementById('namespace-info-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="2" class="text-center text-danger">Error loading namespace: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    });
</script>
{% endblock %}