{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Network</span></li>
          <li class="breadcrumb-item active"><span>Ingress Class</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">IngressClass List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Name</th>
                      <th>Controller</th>
                      <th>Created</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for ic in ingresses_classes %}
                    {% if selected == ic.name %}
                      <tr class="selected" >
                    {% else %}
                      <tr>
                    {% endif %}
                        <td>
                          <form action="/network/ingress-class/data" method="POST" class="data-form" data-name="{{ ic.name }}" data-storage-key="ingress_class_data_name">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="ns_select" value="{{ session['ns_select'] }}" />
                            <input type="hidden" name="ic_name" value="{{ ic.name }}" />
                            <a href="#" class="form-submit-link">{{ ic.name }}</a>
                          </form>
                        </td>
                        <td>
                            {{ ic.controller }}
                        </td>
                        <td>
                          {{ ic.created }}
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    // Event delegation for form submissions
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) {
                const name = form.dataset.name || '';
                const storageKey = form.dataset.storageKey || '';
                if (name && storageKey) sessionStorage.setItem(storageKey, name);
                form.submit();
            }
        }
    });

    // Event delegation for form submission links (CSP-compliant)
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('form-submit-link')) {
            e.preventDefault();
            const form = e.target.closest('form');
            if (form) {
                form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            const inputs = form.querySelectorAll('input[type="hidden"]');
            inputs.forEach(input => {
                if (input.name && input.value) {
                    sessionStorage.setItem(input.name, input.value);
                }
            });
        }
    });
</script>
{% endblock %}
