<div class="card mb-4 mx-5">
  <div class="card-header py-3">
    <h5 class="m-0 font-weight-bold text-primary" id="RunningKubectl">Running kubectl</h5>
  </div>
  <div class="card-body">
    <p class="card-text">Once you get the <code>~/.kube/config</code> file you should be able to run <code>kubectl</code>: </p>
    <pre><code class="bash"># These are examples. Your context and cluster names will likely differ.

$ kubectl config get-contexts
CURRENT   NAME       CLUSTER            AUTHINFO   NAMESPACE
      k8s        k8s                k8s        
      microk8s   microk8s-cluster   admin      

$ kubectl --context k8s get namespaces
NAME          STATUS    AGE
default       Active    83d
experimental  Active    15d

$ kubectl --context k8s -n experimental get pods
NAME                                       READY     STATUS             RESTARTS   AGE
testapp-4074452424-06m0b                   1/1       Running            1          6d</code></pre>
  </div>
</div>
        `;
    }
    
    // Render error template
    function renderErrorExport(data) {
        const preferred_username = escapeHtml(data.preferred_username || '');
        return `
<h2 class="text-center my-4">Welcome ${preferred_username}</h2>
<h3 class="text-center my-4">In order to get command-line acces to the Kubernetes cluster, you need to login with OpenID Connect (OIDC) authentication to this app.</h3>
        `;
    }
    
    // Load export data from API
    async function loadExportData() {
        try {
            const apiUrl = '/api/v1/settings/export';
            console.log('Fetching export data from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            console.log('Export API response:', result);
            
            if (result.error) {
                throw new Error(result.message || 'Failed to load export data');
            }
            
            const data = result.data || {};
            const exportContent = document.getElementById('export-content');
            const exportError = document.getElementById('export-error');
            const loading = document.getElementById('export-loading');
            
            // Hide loading
            loading.style.display = 'none';
            
            // Render based on type
            if (data.type === 'oidc') {
                exportContent.innerHTML = renderOIDCExport(data);
                exportContent.style.display = 'block';
            } else if (data.type === 'cert') {
                exportContent.innerHTML = renderCertExport(data);
                exportContent.style.display = 'block';
            } else {
                // type === 'none' or error
                exportError.innerHTML = renderErrorExport(data);
                exportError.style.display = 'block';
            }
            
            // Initialize syntax highlighting if available
            if (typeof hljs !== 'undefined') {
                document.querySelectorAll('pre code').forEach((block) => {
                    hljs.highlightElement(block);
                });
            }
            
        } catch (error) {
            console.error('Error loading export data:', error);
            const loading = document.getElementById('export-loading');
            const exportError = document.getElementById('export-error');
            loading.style.display = 'none';
            exportError.innerHTML = `
                <div class="alert alert-danger text-center">
                    <h4>Error loading export configuration</h4>
                    <p>${escapeHtml(error.message)}</p>
                </div>
            `;
            exportError.style.display = 'block';
        }
    }
    
    // Load data on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadExportData();
    });
</script>
{% endblock %}


{% block content %}
<div id="export-loading" class="text-center py-5">
    <div class="spinner-border spinner-border-sm text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <span class="ms-2">Loading export configuration...</span>
</div>

<div id="export-content" style="display: none;"></div>

<div id="export-error" style="display: none;"></div>
{% endblock %}
