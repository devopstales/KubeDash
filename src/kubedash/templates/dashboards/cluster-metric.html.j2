        }
        
        // Populate events table
        function populateEventsTable(events) {
            console.log('populateEventsTable called with:', events); // Debug log
            const tbody = document.getElementById('events-tbody');
            const table = document.getElementById('dataTable');
            
            if (!events || events.length === 0) {
                console.log('No events to display');
                // Clear tbody and add a single row with proper structure for DataTables
                tbody.innerHTML = '';
                // Initialize DataTable with language option to customize empty message
                if ($.fn.DataTable && $(table).length) {
                    if ($.fn.DataTable.isDataTable(table)) {
                        $(table).DataTable().destroy();
                    }
                    $(table).DataTable({
                        responsive: true,
                        pageLength: 25,
                        language: {
                            emptyTable: "No cluster events found. This is normal if there are no recent warning or error events."
                        }
                    });
                }
                return;
            }
            
            console.log('Processing', events.length, 'events');
            
            // Helper function to escape HTML (simple version)
            const escapeHtml = (text) => {
                if (text === null || text === undefined) return '';
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return String(text).replace(/[&<>"']/g, m => map[m]);
            };
            
            // Build HTML rows
            const rowsHtml = events.map(event => {
                const kind = escapeHtml(event.involvedObjectKind || '');
                const name = escapeHtml(event.involvedObjectName || '');
                const namespace = escapeHtml(event.namespace || '');
                const reason = escapeHtml(event.reason || '');
                const message = escapeHtml(event.message || '');
                const count = event.count || 0;
                
                const nameCell = event.involvedObjectKind === 'Pod' 
                    ? `<form action="/workload/pods" method="POST">
                         <input type="hidden" name="csrf_token" value="${csrf_token}">
                         <input type="hidden" name="ns_select" value="${namespace}" />
                         <input type="hidden" name="selected" value="${name}" />                                
                         <a href="javascript:;" onclick="parentNode.submit();">${name}</a>
                       </form>`
                    : name;
                
                return `
                    <tr>
                        <td style="white-space: nowrap;">${kind}</td>
                        <td style="white-space: nowrap;">${nameCell}</td>
                        <td style="white-space: nowrap;">${namespace}</td>
                        <td style="white-space: nowrap;">
                            <span class="badge text-bg-secondary">${reason}</span>
                        </td>
                        <td>${message}</td>
                        <td style="white-space: nowrap;">${count}</td>
                    </tr>
                `;
            }).join('');
            
            // Set innerHTML
            tbody.innerHTML = rowsHtml;
            
            // Verify rows were added
            const rowCount = tbody.querySelectorAll('tr').length;
            console.log('Rows added to tbody:', rowCount);
            
            // Small delay to ensure DOM is updated, then initialize DataTable
            setTimeout(() => {
                if ($.fn.DataTable && $(table).length) {
                    // Check if DataTable is already initialized
                    if ($.fn.DataTable.isDataTable(table)) {
                        console.log('Destroying existing DataTable');
                        // Save the tbody HTML before destroying (destroy removes rows from DOM)
                        const savedRows = tbody.innerHTML;
                        $(table).DataTable().destroy();
                        // Restore the rows after destroying
                        tbody.innerHTML = savedRows;
                    }
                    
                    // Verify rows still exist before initializing
                    const currentRowCount = tbody.querySelectorAll('tr').length;
                    console.log('Initializing DataTable with', currentRowCount, 'rows');
                    
                    if (currentRowCount === 0) {
                        console.error('No rows found in tbody after DataTable destroy/restore');
                        return;
                    }
                    
                    // Initialize DataTable
                    $(table).DataTable({
                        responsive: true,
                        pageLength: 25,
                        order: [[5, 'desc']], // Sort by Count column descending
                        language: {
                            emptyTable: "No cluster events found"
                        }
                    });
                    
                    console.log('DataTable initialized successfully');
                } else {
                    console.error('jQuery or DataTable not available for initialization');
                }
            }, 50); // Small delay to ensure DOM is fully updated
        }
        
        // Load data using fetch() - following Flask fetch pattern
        document.addEventListener('DOMContentLoaded', async function() {
            // Wait for jQuery and DataTables to be ready (with retry)
            let retries = 0;
            while ((typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') && retries < 10) {
                await new Promise(resolve => setTimeout(resolve, 100));
                retries++;
            }
            
            if (typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') {
                console.error('jQuery or DataTables not loaded after waiting');
                return;
            }
            
            try {
                // Fetch cluster metrics
                const metricsResponse = await fetch(metrics_url);
                if (!metricsResponse.ok) {
                    throw new Error(`HTTP error! status: ${metricsResponse.status}`);
                }
                const metricsData = await metricsResponse.json();
                
                if (metricsData.error) {
                    throw new Error(metricsData.message || 'Failed to load metrics');
                }
                
                const metrics = metricsData.data;
                
                // Initialize charts with fetched data
                initCPUChart(metrics);
                initMemoryChart(metrics);
                initPodChart(metrics);
                
                // Fetch cluster events
                console.log('Fetching events from:', events_url);
                const eventsResponse = await fetch(events_url + '?limit=100');
                if (!eventsResponse.ok) {
                    throw new Error(`HTTP error! status: ${eventsResponse.status}`);
                }
                const eventsData = await eventsResponse.json();
                
                console.log('Events API response:', eventsData); // Debug log
                
                if (eventsData.error) {
                    throw new Error(eventsData.message || 'Failed to load events');
                }
                
                // Check if data exists and is an array
                if (!eventsData.data) {
                    console.warn('Events data is missing or undefined');
                    populateEventsTable([]);
                } else if (!Array.isArray(eventsData.data)) {
                    console.warn('Events data is not an array:', typeof eventsData.data, eventsData.data);
                    populateEventsTable([]);
                } else {
                    console.log('Populating events table with', eventsData.data.length, 'events');
                    // Populate events table
                    populateEventsTable(eventsData.data);
                }
                
            } catch (error) {
                console.error('Error loading cluster metrics:', error);
                
                // Show error messages
                const tbody = document.getElementById('events-tbody');
                if (tbody) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading events: ' + error.message + '</td></tr>';
                    
                    // Initialize DataTable even with error message
                    const table = document.getElementById('dataTable');
                    if ($.fn.DataTable && $(table).length && !$.fn.DataTable.isDataTable(table)) {
                        $(table).DataTable({
                            responsive: true,
                            pageLength: 25
                        });
                    }
                }
                
                // Update metric placeholders with error
                const errorMsg = 'Error loading data';
                const cpuCapacity = document.getElementById('cpu-capacity');
                const memoryCapacity = document.getElementById('memory-capacity');
                const podCurrent = document.getElementById('pod-current');
                if (cpuCapacity) cpuCapacity.textContent = errorMsg;
                if (memoryCapacity) memoryCapacity.textContent = errorMsg;
                if (podCurrent) podCurrent.textContent = errorMsg;
            }
        });
    </script>
{% endblock %}
