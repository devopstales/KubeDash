{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Cluster Permissions</span></li>
          <li class="breadcrumb-item active"><span>Roles</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Roles List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Name</th>
                      <th>Labels</th>
                      <th>Annotations</th>
                    </tr>
                  </thead>
                  <tbody id="roles-tbody">
                    <tr>
                        <td colspan="3" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading roles...</span>
                        </td>
                    </tr>
                  </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    // IMMEDIATE: Prevent datatables-demo.js from initializing on loading row
    (function() {
        function setupOverride() {
            if (typeof $ !== 'undefined' && $.fn && !window._datatableOverrideSetup) {
                window._datatableOverrideSetup = true;
                const originalDataTable = $.fn.DataTable;
                $.fn.DataTable = function(options) {
                    const table = this[0];
                    if (table && table.id === 'dataTable') {
                        const tbody = table.querySelector('tbody');
                        if (tbody) {
                            const rows = tbody.querySelectorAll('tr');
                            const hasColspanRow = Array.from(rows).some(row => {
                                const cells = row.querySelectorAll('td');
                                return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                            });
                            if (hasColspanRow) {
                                console.log('Blocked DataTable initialization on loading row');
                                return this;
                            }
                        }
                    }
                    return originalDataTable.apply(this, arguments);
                };
                Object.setPrototypeOf($.fn.DataTable, originalDataTable);
                Object.keys(originalDataTable).forEach(key => {
                    $.fn.DataTable[key] = originalDataTable[key];
                });
            }
        }
        setupOverride();
        setTimeout(setupOverride, 0);
        setTimeout(setupOverride, 50);
        setTimeout(setupOverride, 100);
    })();
    
    (function() {
        function checkAndDestroyAutoInit() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                const table = document.getElementById('dataTable');
                if (table && $.fn.DataTable.isDataTable(table)) {
                    const tbody = table.querySelector('tbody');
                    if (tbody) {
                        const rows = tbody.querySelectorAll('tr');
                        const hasColspanRow = Array.from(rows).some(row => {
                            const cells = row.querySelectorAll('td');
                            return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                        });
                        if (hasColspanRow) {
                            console.log('Destroying auto-initialized DataTable on loading row');
                            try {
                                $(table).DataTable().destroy();
                            } catch(e) {
                                console.error('Error destroying DataTable:', e);
                            }
                        }
                    }
                }
            }
        }
        if (typeof $ !== 'undefined') {
            checkAndDestroyAutoInit();
        }
        setTimeout(checkAndDestroyAutoInit, 50);
        setTimeout(checkAndDestroyAutoInit, 100);
        setTimeout(checkAndDestroyAutoInit, 200);
        setTimeout(checkAndDestroyAutoInit, 500);
        setTimeout(checkAndDestroyAutoInit, 1000);
    })();
    
    const csrf_token = {{ csrf_token()|tojson }};
    const selected_role = {{ (request.args.get('selected') or '')|tojson }};
    const current_namespace = {{ session.get('ns_select', 'default')|tojson }};
    const roles_api_url = '/api/v1/rbac/roles';
    
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    function formatLabels(labels) {
        if (!labels || typeof labels !== 'object') return '';
        return Object.entries(labels).map(([key, value]) => 
            `<span class="badge text-bg-secondary">${escapeHtml(key)}: ${escapeHtml(value)}</span>`
        ).join('<br>');
    }
    
    function formatAnnotations(annotations) {
        if (!annotations || typeof annotations !== 'object') return '';
        return Object.entries(annotations)
            .filter(([key]) => key !== 'kubectl.kubernetes.io/last-applied-configuration')
            .map(([key, value]) => 
                `<span class="badge text-bg-secondary">${escapeHtml(key)}: ${escapeHtml(value)}</span>`
            ).join('<br>');
    }
    
    function populateRolesTable(roles) {
        const tbody = document.getElementById('roles-tbody');
        const table = document.getElementById('dataTable');
        
        if (table && typeof $ !== 'undefined' && $.fn.DataTable && $.fn.DataTable.isDataTable(table)) {
            $(table).DataTable().destroy();
        }
        
        tbody.innerHTML = `
            <tr>
                <td colspan="3" class="text-center">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="ms-2">Processing roles...</span>
                </td>
            </tr>
        `;
        
        if (!roles || roles.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No roles found</td></tr>';
            return;
        }
        
        const rowsHtml = roles.map(role => {
            const name = escapeHtml(role.name || '');
            const isSelected = selected_role === role.name;
            const rowClass = isSelected ? 'class="selected"' : '';
            const labels = formatLabels(role.labels);
            const annotations = formatAnnotations(role.annotations);
            
            return `
                <tr ${rowClass}>
                    <td>
                        <form action="/cluster-permission/role/data" method="POST" onsubmit="sessionStorage.setItem('role_data_name', '${name}'); sessionStorage.setItem('role_data_namespace', '${escapeHtml(current_namespace)}'); return true;">
                            <input type="hidden" name="csrf_token" value="${csrf_token}">
                            <input type="hidden" name="ns_select" value="${escapeHtml(current_namespace)}" />
                            <input type="hidden" name="r_name" value="${name}" />
                            <a href="javascript:;" onclick="sessionStorage.setItem('role_data_name', '${name}'); sessionStorage.setItem('role_data_namespace', '${escapeHtml(current_namespace)}'); parentNode.submit();">${name}</a>
                        </form>
                    </td>
                    <td>${labels || ' '}</td>
                    <td>${annotations || ' '}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rowsHtml;
        
        setTimeout(() => {
            const rows = tbody.querySelectorAll('tr');
            let hasDataRows = false;
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                const hasColspan = Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                if (!hasColspan && cells.length === 3) {
                    hasDataRows = true;
                }
            });
            
            if (!hasDataRows) return;
            
            if ($.fn.DataTable && $(table).length) {
                if ($.fn.DataTable.isDataTable(table)) {
                    const savedRows = tbody.innerHTML;
                    $(table).DataTable().destroy();
                    tbody.innerHTML = savedRows;
                }
                
                const dataRows = Array.from(tbody.querySelectorAll('tr')).filter(row => {
                    const cells = row.querySelectorAll('td');
                    return !Array.from(cells).some(cell => cell.hasAttribute('colspan')) && cells.length === 3;
                });
                
                if (dataRows.length > 0) {
                    $(table).DataTable({
                        responsive: true,
                        pageLength: 25
                    });
                }
            }
        }, 50);
    }
    
    document.addEventListener('DOMContentLoaded', async function() {
        let retries = 0;
        while ((typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') && retries < 10) {
            await new Promise(resolve => setTimeout(resolve, 100));
            retries++;
        }
        
        if (typeof $ === 'undefined' || typeof $.fn.DataTable === 'undefined') {
            console.error('jQuery or DataTables not loaded');
            return;
        }
        
        const table = document.getElementById('dataTable');
        if (table && $.fn.DataTable && $.fn.DataTable.isDataTable(table)) {
            const tbody = table.querySelector('tbody');
            if (tbody) {
                const rows = tbody.querySelectorAll('tr');
                const hasColspanRow = Array.from(rows).some(row => {
                    const cells = row.querySelectorAll('td');
                    return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                });
                if (hasColspanRow) {
                    $(table).DataTable().destroy();
                }
            }
        }
        
        try {
            const namespace = current_namespace || 'default';
            const apiUrl = `${roles_api_url}?namespace=${encodeURIComponent(namespace)}`;
            console.log('Fetching roles from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Roles API response:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load roles');
            }
            
            const roles = data.data || [];
            populateRolesTable(roles);
            
        } catch (error) {
            console.error('Error loading roles:', error);
            const tbody = document.getElementById('roles-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Error loading roles: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    });
</script>
{% endblock %}
