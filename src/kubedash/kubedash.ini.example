##################### KubeDash Configuration Example #####################
# Copy this file to kubedash.ini and adjust values for your environment
# All sensitive values (passwords, API keys) should be set via environment variables

[DEFAULT]
# Application mode: production, development, testing
app_mode = development

#################################### Logging #############################
[logging]
# Format: text (human-readable, optional color) or json (one JSON object per line for ELK/Loki)
format = text
# Root log level: DEBUG, INFO, WARNING, ERROR
level = INFO

#################################### Audit ##############################
[audit]
# Enable audit logging (login/logout, privilege changes, destructive actions)
enabled = true

#################################### Security ############################
[security]
# Default admin password (change in production!)
admin_password = admin

#################################### Database ############################
[database]
# Database type: postgres or sqlite3
type = postgres
host = 127.0.0.1:5432
name = kubedash
user = kubedash
password = kubedash

# For SQLite (development):
# type = sqlite3
# db_path = /code/kubedash/data/kubedash.db

#################################### Cache server #############################
[remote_cache]
# Redis configuration for caching
redis_enabled = true
redis_host = 127.0.0.1
redis_port = 6379
redis_db = 0
redis_password =

# Cache timeouts (seconds)
short_cache_time = 60
long_cache_time = 900

#################################### SSO Settings ###########################
[sso_settings]
# OAuth2/OIDC configuration for SSO
issuer_url = https://auth.example.com/realms/myrealm
callback_url = https://kubedash.example.com
scope = roles email openid profile
client_id = kubedash
# Set via environment: KUBEDASH_SSO_SECRET
# secret =

#################################### Kubernetes ###########################
[k8s]
# Kubernetes cluster configuration
cluster_name = my-cluster
api_server = https://api.example.com:6443
# Base64 encoded CA certificate
api_ca = LS0tLS1CRUdJTi...

#################################### Monitoring Settings ###########################
[monitoring]
# Jaeger/OpenTelemetry configuration
jaeger_enabled = true
jaeger_http_endpoint = http://127.0.0.1:4318

#################################### Plugin Settings ###########################
[plugin_settings]
# Enable/disable plugins (true/false)

# AI Chat plugin - AI-powered Kubernetes management
ai_chat = true

# Registry plugin - Container registry management
registry = true

# Helm plugin - Helm chart management
helm = true

# External LoadBalancer plugin
external_loadbalancer = true

# Cert-Manager plugin - Certificate management
cert_manager = true

# Flux CD plugin - GitOps operations
flux = true

# Gateway API plugin - API Gateway management
gateway_api = true

# Trivy Operator plugin - Security scanning
trivy_operator = true

# Iframe Proxy plugin - External app integration
iframe_proxy = true

# Application Catalog plugin
application_catalog = true

#################################### AI Chat Settings ###########################
[ai_chat]
# Kubernetes operations use lib/k8s (same cluster and auth as KubeDash). No MCP server required.

# Enable/disable AI Chat functionality
enabled = true

# Read-only mode: true = only list/describe/logs; false = allow create/delete
read_only = false

# LLM Provider (optional - omit for air-gapped / pattern-based commands only)
# Provider type: openai, ollama, gemini, azure
llm_provider = ollama

# LLM API base URL
# Ollama: http://host:11434/v1  |  OpenAI: https://api.openai.com/v1  |  Azure: your-resource URL
llm_base_url = http://127.0.0.1:11434/v1

# Model name (e.g. llama3.1:8b, gpt-3.5-turbo, gemini-pro)
llm_model = llama3.1:8b

# LLM API key (optional for Ollama; required for OpenAI/Gemini/Azure). Or KUBEDASH_LLM_API_KEY
# llm_api_key =

llm_timeout = 60
llm_max_tokens = 2000

#################################### Performance Settings ###########################
[performance]
# Skip cluster metrics for faster page loads
skip_cluster_metrics = false

# Initial metrics timeout (seconds)
initial_metrics_timeout = 3

#################################### Application Links ###########################
[application_list]
# External applications to display in KubeDash

app_0_name = Kubeview
app_0_url = http://127.0.0.1:8003
app_0_embed = true
app_0_enable = true

app_1_name = Jaeger
app_1_url = http://127.0.0.1:16686
app_1_embed = true
app_1_enable = true

app_2_name = Prometheus
app_2_url = https://prometheus.example.com
app_2_embed = false
app_2_enable = true

app_3_name = Grafana
app_3_url = https://grafana.example.com
app_3_embed = false
app_3_enable = true

# Add more applications as needed...
