    function populateHTTPRoutesTable(routes, namespace) {
        const tbody = document.getElementById('httproutes-tbody');
        
        if (!routes || routes.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted">No HTTPRoutes found in namespace ${escapeHtml(namespace || 'default')}</td></tr>`;
            return;
        }
        
        const rows = routes.map(route => {
            let statusBadge = '';
            if (route.accepted_parents === route.total_parents) {
                statusBadge = `<span class="badge bg-success">${route.accepted_parents}/${route.total_parents}</span>`;
            } else if (route.accepted_parents > 0) {
                statusBadge = `<span class="badge bg-warning text-dark">${route.accepted_parents}/${route.total_parents}</span>`;
            } else {
                statusBadge = `<span class="badge bg-danger">${route.accepted_parents}/${route.total_parents}</span>`;
            }
            
            const hostnamesHtml = (route.hostnames || []).slice(0, 3).map(h => 
                `<span class="badge bg-light text-dark">${escapeHtml(h)}</span>`
            ).join('') + ((route.hostnames || []).length > 3 ? `<span class="badge bg-secondary">+${(route.hostnames || []).length - 3}</span>` : '');
            
            const gatewaysHtml = (route.gateways || []).map(gw => {
                const gwName = String(gw).split('/').pop();
                return `<a href="/plugins/gateway-api/gateway/${escapeHtml(String(gw).replace('/', '/'))}" class="badge bg-info text-decoration-none">${escapeHtml(gwName)}</a>`;
            }).join('');
            
            const backendsHtml = (route.backends || []).slice(0, 2).map(b => 
                `<code class="small">${escapeHtml(b)}</code>`
            ).join('') + ((route.backends || []).length > 2 ? `<span class="badge bg-secondary">+${(route.backends || []).length - 2}</span>` : '');
            
            return `
                <tr>
                    <td>${statusBadge}</td>
                    <td><a href="/plugins/gateway-api/httproute/${escapeHtml(route.namespace)}/${escapeHtml(route.name)}">${escapeHtml(route.name)}</a></td>
                    <td>${escapeHtml(route.namespace || '')}</td>
                    <td>${hostnamesHtml || '-'}</td>
                    <td>${gatewaysHtml || '-'}</td>
                    <td><span class="badge bg-secondary">${escapeHtml(String(route.rules_count || 0))}</span></td>
                    <td>${backendsHtml || '-'}</td>
                    <td>${escapeHtml(route.age || '')}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        setTimeout(() => safeInitDataTable('#httpRouteTable', [1, "asc"]), 100);
    }
    
