    // Load Gateway API status
    async function loadGatewayAPIStatus() {
        try {
            const response = await fetch('/api/v1/plugins/gateway-api/status');
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            gatewayApiData.gateway_api_status = data.data || { installed: false };
            
            // Show/hide status alert
            const alertDiv = document.getElementById('gateway-api-status-alert');
            if (alertDiv) {
                alertDiv.style.display = gatewayApiData.gateway_api_status.installed ? 'none' : 'block';
            }
        } catch (error) {
            console.error('Error loading Gateway API status:', error);
            gatewayApiData.gateway_api_status = { installed: false };
        }
    }
    
    // Load all Gateway API resources
    async function loadGatewayAPIResources(namespace) {
        try {
            const [statusRes, classesRes, gatewaysRes, httproutesRes, grpcroutesRes, 
                   tcproutesRes, tlsroutesRes, referencegrantsRes, backendtlspoliciesRes] = await Promise.all([
                fetch('/api/v1/plugins/gateway-api/status'),
                fetch('/api/v1/plugins/gateway-api/gateway-classes'),
                fetch(`/api/v1/plugins/gateway-api/gateways?namespace=${encodeURIComponent(namespace)}`),
                fetch(`/api/v1/plugins/gateway-api/httproutes?namespace=${encodeURIComponent(namespace)}`),
                fetch(`/api/v1/plugins/gateway-api/grpcroutes?namespace=${encodeURIComponent(namespace)}`),
                fetch(`/api/v1/plugins/gateway-api/tcproutes?namespace=${encodeURIComponent(namespace)}`),
                fetch(`/api/v1/plugins/gateway-api/tlsroutes?namespace=${encodeURIComponent(namespace)}`),
                fetch(`/api/v1/plugins/gateway-api/reference-grants?namespace=${encodeURIComponent(namespace)}`),
                fetch(`/api/v1/plugins/gateway-api/backend-tls-policies?namespace=${encodeURIComponent(namespace)}`)
            ]);
            
            if (statusRes.ok) {
                const statusData = await statusRes.json();
                gatewayApiData.gateway_api_status = statusData.data || { installed: false };
            }
            
            if (classesRes.ok) {
                const classesData = await classesRes.json();
                gatewayApiData.gateway_classes = classesData.data || [];
            }
            
            if (gatewaysRes.ok) {
                const gatewaysData = await gatewaysRes.json();
                gatewayApiData.gateways = gatewaysData.data || [];
            }
            
            if (httproutesRes.ok) {
                const httproutesData = await httproutesRes.json();
                gatewayApiData.httproutes = httproutesData.data || [];
            }
            
            if (grpcroutesRes.ok) {
                const grpcroutesData = await grpcroutesRes.json();
                gatewayApiData.grpcroutes = grpcroutesData.data || [];
            }
            
            if (tcproutesRes.ok) {
                const tcproutesData = await tcproutesRes.json();
                gatewayApiData.tcproutes = tcproutesData.data || [];
            }
            
            if (tlsroutesRes.ok) {
                const tlsroutesData = await tlsroutesRes.json();
                gatewayApiData.tlsroutes = tlsroutesData.data || [];
            }
            
            if (referencegrantsRes.ok) {
                const referencegrantsData = await referencegrantsRes.json();
                gatewayApiData.referencegrants = referencegrantsData.data || [];
            }
            
            if (backendtlspoliciesRes.ok) {
                const backendtlspoliciesData = await backendtlspoliciesRes.json();
                gatewayApiData.backendtlspolicies = backendtlspoliciesData.data || [];
            }
            
            // Update UI with loaded data
            updateStatusBadges();
            updateTabVisibility();
            updateBadgeCounts();
            
            populateGatewayClassesTable(gatewayApiData.gateway_classes);
            populateGatewaysTable(gatewayApiData.gateways, namespace);
            populateHTTPRoutesTable(gatewayApiData.httproutes, namespace);
            populateGRPCRoutesTable(gatewayApiData.grpcroutes);
            populateTCPRoutesTable(gatewayApiData.tcproutes);
            populateTLSRoutesTable(gatewayApiData.tlsroutes);
            populateReferenceGrantsTable(gatewayApiData.referencegrants);
            populateBackendTLSPoliciesTable(gatewayApiData.backendtlspolicies);
            
        } catch (error) {
            console.error('Error loading Gateway API resources:', error);
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', async function() {
        const namespace = getSelectedNamespace();
        const activeTab = getActiveTab();
        
        // Load Gateway API status first
        await loadGatewayAPIStatus();
        
        // Show/hide status alert
        const alertDiv = document.getElementById('gateway-api-status-alert');
        if (alertDiv && gatewayApiData.gateway_api_status) {
            alertDiv.style.display = gatewayApiData.gateway_api_status.installed ? 'none' : 'block';
        }
        
        // Load all resources
        await loadGatewayAPIResources(namespace);
        
        // Switch to the correct tab if specified
        if (activeTab) {
            setTimeout(function() {
                const tabId = '#nav-' + activeTab + '-tab';
                if (typeof $ !== 'undefined') {
                    $(tabId).tab('show');
                }
            }, 200);
        }
        
        // Reload data when namespace changes
        const namespaceSelect = document.getElementById('inputGroupSelect04');
        if (namespaceSelect) {
            namespaceSelect.addEventListener('change', async function() {
                const newNamespace = this.value;
                sessionStorage.setItem('ns_select', newNamespace);
                await loadGatewayAPIResources(newNamespace);
            });
        }
        
        // Store active tab in URL
        $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
            const tabId = $(e.target).attr('href').replace('#nav-', '');
            const url = new URL(window.location);
            url.searchParams.set('tab', tabId);
            window.history.replaceState({}, '', url);
        });
        
        // Initialize DataTables when tabs become visible
        $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
            setTimeout(function() {
                const tabId = $(e.target).attr('href');
                if (tabId === '#nav-gatewayclasses') {
                    safeInitDataTable('#gatewayClassTable', [1, "asc"]);
                } else if (tabId === '#nav-gateways') {
                    safeInitDataTable('#gatewayTable', [1, "asc"]);
                } else if (tabId === '#nav-httproutes') {
                    safeInitDataTable('#httpRouteTable', [1, "asc"]);
                } else if (tabId === '#nav-grpcroutes') {
                    safeInitDataTable('#grpcRouteTable', [0, "asc"]);
                } else if (tabId === '#nav-tcproutes') {
                    safeInitDataTable('#tcpRouteTable', [1, "asc"]);
                } else if (tabId === '#nav-tlsroutes') {
                    safeInitDataTable('#tlsRouteTable', [1, "asc"]);
                } else if (tabId === '#nav-referencegrants') {
                    safeInitDataTable('#referenceGrantTable', [0, "asc"]);
                } else if (tabId === '#nav-backendtlspolicies') {
                    safeInitDataTable('#backendTLSPolicyTable', [1, "asc"]);
                }
            }, 100);
        });
    });
</script>
