{% block add_head_css %}
{% include "segments/datatable_snippet.html.j2" %}
<style>
    .badge.bg-light {
        border: 1px solid #dee2e6;
    }
    code.small {
        font-size: 0.85em;
    }
</style>
{% endblock %}

{% block add_tail_js %}
<script>
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    // Get namespace from topbar selector or use default
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value;
        }
        return sessionStorage.getItem('ns_select') || 'default';
    }
    
    // Get active tab from URL or default
    function getActiveTab() {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get('tab') || 'gatewayclasses';
    }
    
    // Data storage for fetched resources
    const gatewayApiData = {
        gateway_api_status: null,
        gateway_classes: [],
        gateways: [],
        httproutes: [],
        grpcroutes: [],
        tcproutes: [],
        tlsroutes: [],
        referencegrants: [],
        backendtlspolicies: []
    };
    
    // DataTables protection
    (function() {
        const tableIds = ['gatewayClassTable', 'gatewayTable', 'httpRouteTable', 'grpcRouteTable', 
                         'tcpRouteTable', 'tlsRouteTable', 'referenceGrantTable', 'backendTLSPolicyTable'];
        
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
    })();
    
    const initializedTables = new Set();
    
    function safeInitDataTable(selector, orderCol) {
        const $table = $(selector);
        if (!$table.length) return;
        
        if (initializedTables.has(selector)) {
            if (typeof $.fn.DataTable.isDataTable === 'function' && $.fn.DataTable.isDataTable(selector)) {
                return;
            } else {
                initializedTables.delete(selector);
            }
        }
        
        try {
            let isInitialized = false;
            if (typeof $.fn.DataTable.isDataTable === 'function' && $.fn.DataTable.isDataTable(selector)) {
                isInitialized = true;
            } else if ($table.data('DataTable')) {
                isInitialized = true;
            }
            
            if (isInitialized) {
                try {
                    $table.DataTable().destroy();
                    $table.removeData('DataTable');
                    initializedTables.delete(selector);
                } catch (destroyError) {
                    console.warn('Error destroying DataTable:', destroyError);
                    initializedTables.delete(selector);
                }
            }
            
            setTimeout(function() {
                try {
                    if (typeof $.fn.DataTable.isDataTable === 'function' && $.fn.DataTable.isDataTable(selector)) {
                        initializedTables.add(selector);
                        return;
                    }
                    
                    const hasDataRows = $table.find('tbody tr').filter(function() {
                        return !$(this).find('td[colspan]').length;
                    }).length > 0;
                    
                    if (!hasDataRows) {
                        return;
                    }
                    
                    $table.DataTable({
                        "order": [orderCol],
                        "pageLength": 25
                    });
                    
                    initializedTables.add(selector);
                } catch (initError) {
                    console.warn('Error initializing DataTable:', initError);
                    initializedTables.delete(selector);
                }
            }, 10);
        } catch (e) {
            console.warn('Error in safeInitDataTable:', e);
            initializedTables.delete(selector);
        }
    }
    
    function updateStatusBadges() {
        const badgesContainer = document.getElementById('gateway-api-status-badges');
        if (!badgesContainer) return;
        
        const status = gatewayApiData.gateway_api_status || {};
        let html = '';
        
        if (status.installed) {
            html += '<span class="badge bg-success me-2"><i class="cil-check-circle"></i> Gateway API Installed</span>';
        }
        
        if (status.experimental && status.experimental.length > 0) {
            html += `<span class="badge bg-info">Experimental APIs: ${status.experimental.length}</span>`;
        }
        
        badgesContainer.innerHTML = html;
    }
    
    function updateTabVisibility() {
        const status = gatewayApiData.gateway_api_status || {};
        const experimental = status.experimental || [];
        const standard = status.standard || [];
        
        // Show/hide tabs based on data or API availability
        const grpcroutesTab = document.getElementById('grpcroutes-tab-container');
        if (grpcroutesTab) {
            grpcroutesTab.style.display = (gatewayApiData.grpcroutes.length > 0 || experimental.includes('grpcroutes')) ? '' : 'none';
        }
        
        const tcproutesTab = document.getElementById('tcproutes-tab-container');
        if (tcproutesTab) {
            tcproutesTab.style.display = (gatewayApiData.tcproutes.length > 0 || experimental.includes('tcproutes')) ? '' : 'none';
        }
        
        const tlsroutesTab = document.getElementById('tlsroutes-tab-container');
        if (tlsroutesTab) {
            tlsroutesTab.style.display = (gatewayApiData.tlsroutes.length > 0 || experimental.includes('tlsroutes')) ? '' : 'none';
        }
        
        const referencegrantsTab = document.getElementById('referencegrants-tab-container');
        if (referencegrantsTab) {
            referencegrantsTab.style.display = (gatewayApiData.referencegrants.length > 0 || standard.includes('referencegrants')) ? '' : 'none';
        }
        
        const backendtlspoliciesTab = document.getElementById('backendtlspolicies-tab-container');
        if (backendtlspoliciesTab) {
            backendtlspoliciesTab.style.display = (gatewayApiData.backendtlspolicies.length > 0 || experimental.includes('backendtlspolicies')) ? '' : 'none';
        }
    }
    
    function updateBadgeCounts() {
        document.getElementById('gatewayclasses-badge').textContent = gatewayApiData.gateway_classes.length || 0;
        document.getElementById('gateways-badge').textContent = gatewayApiData.gateways.length || 0;
        document.getElementById('httproutes-badge').textContent = gatewayApiData.httproutes.length || 0;
        document.getElementById('grpcroutes-badge').textContent = gatewayApiData.grpcroutes.length || 0;
        document.getElementById('tcproutes-badge').textContent = gatewayApiData.tcproutes.length || 0;
        document.getElementById('tlsroutes-badge').textContent = gatewayApiData.tlsroutes.length || 0;
        document.getElementById('referencegrants-badge').textContent = gatewayApiData.referencegrants.length || 0;
        document.getElementById('backendtlspolicies-badge').textContent = gatewayApiData.backendtlspolicies.length || 0;
    }
    
    function populateGatewayClassesTable(classes) {
        const tbody = document.getElementById('gatewayclasses-tbody');
        
        if (!classes || classes.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No GatewayClasses found</td></tr>';
            return;
        }
        
        const rows = classes.map(gc => {
            const status = gc.status === 'True' 
                ? `<span class="badge bg-success">${escapeHtml(gc.status_reason || 'Accepted')}</span>`
                : `<span class="badge bg-danger">${escapeHtml(gc.status_reason || 'Pending')}</span>`;
            
            return `
                <tr>
                    <td>${status}</td>
                    <td><a href="/plugins/gateway-api/gatewayclass/${escapeHtml(gc.name)}">${escapeHtml(gc.name)}</a></td>
                    <td><code>${escapeHtml(gc.controller || '')}</code></td>
                    <td>${escapeHtml(gc.description || '-')}</td>
                    <td>${escapeHtml(gc.age || '')}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        setTimeout(() => safeInitDataTable('#gatewayClassTable', [1, "asc"]), 100);
    }
    
    function populateGatewaysTable(gateways, namespace) {
        const tbody = document.getElementById('gateways-tbody');
        
        if (!gateways || gateways.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted">No Gateways found in namespace ${escapeHtml(namespace || 'default')}</td></tr>`;
            return;
        }
        
        const rows = gateways.map(gw => {
            let statusBadge = '';
            if (gw.programmed_status === 'True') {
                statusBadge = '<span class="badge bg-success">Programmed</span>';
            } else if (gw.accepted_status === 'True') {
                statusBadge = '<span class="badge bg-info">Accepted</span>';
            } else {
                statusBadge = `<span class="badge bg-warning text-dark">${escapeHtml(gw.programmed_reason || 'Pending')}</span>`;
            }
            
            const listenersHtml = (gw.listeners || []).map(listener => 
                `<span class="badge bg-light text-dark me-1">${escapeHtml(listener.protocol || '')}:${escapeHtml(String(listener.port || ''))}</span>`
            ).join('');
            
            const addressesHtml = (gw.addresses || []).length > 0
                ? (gw.addresses || []).map(addr => `<code>${escapeHtml(String(addr).split(':').pop())}</code>`).join('')
                : '<span class="text-muted">-</span>';
            
            return `
                <tr>
                    <td>${statusBadge}</td>
                    <td><a href="/plugins/gateway-api/gateway/${escapeHtml(gw.namespace)}/${escapeHtml(gw.name)}">${escapeHtml(gw.name)}</a></td>
                    <td>${escapeHtml(gw.namespace || '')}</td>
                    <td><a href="/plugins/gateway-api/gatewayclass/${escapeHtml(gw.gateway_class)}">${escapeHtml(gw.gateway_class || '')}</a></td>
                    <td>${listenersHtml || '-'}</td>
                    <td>${addressesHtml}</td>
                    <td><span class="badge bg-primary">${escapeHtml(String(gw.attached_routes || 0))}</span></td>
