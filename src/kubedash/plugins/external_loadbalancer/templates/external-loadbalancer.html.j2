{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
(function() {
    'use strict';
    try {
        console.log('External LoadBalancer script starting...');
        
        const escapeHtml = (text) => {
            if (text === null || text === undefined) return '';
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        };
        
        const csrf_token = {{ csrf_token()|tojson }};
        
        const selected = {{ selected|tojson if selected else 'null' }};
        const selected_type = {{ selected_type|tojson if selected_type else 'null' }};
    
    // Get namespace from topbar selector or use default
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value;
        }
        return sessionStorage.getItem('ns_select') || 'default';
    }
    
    // DataTables protection - prevent auto-initialization on loading rows
    (function() {
        const tableIds = ['ipaddresspoolTable', 'l2advertisementTable', 'bgppeersTable', 'bgpadvertisementTable'];
        
        // Override DataTable initialization to prevent on colspan rows
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            const originalDataTable = $.fn.DataTable;
            $.fn.DataTable = function(opts) {
                const $this = $(this);
                // Check if this is a loading row with colspan
                if ($this.find('tbody tr td[colspan]').length > 0) {
                    console.log('Blocked DataTable initialization on loading row');
                    return $this;
                }
                return originalDataTable.apply(this, arguments);
            };
        }
    })();
    
    // Track which tables have been initialized
    const initializedTables = new Set();
    const initializingTables = new Set(); // Track tables currently being initialized
    
    function safeInitDataTable(selector, orderCol) {
        const $table = $(selector);
        if (!$table.length) return;
        
        // Check if already initialized or currently initializing
        if (initializedTables.has(selector) || initializingTables.has(selector)) {
            // Double-check if it's actually initialized
            if (typeof $.fn.DataTable !== 'undefined' && typeof $.fn.DataTable.isDataTable === 'function') {
                if ($.fn.DataTable.isDataTable(selector)) {
                    return; // Already initialized, skip
                } else {
                    // Was marked as initialized but isn't - remove from set
                    initializedTables.delete(selector);
                }
            }
        }
        
        // Check if DataTable is already initialized (synchronous check)
        if (typeof $.fn.DataTable !== 'undefined' && typeof $.fn.DataTable.isDataTable === 'function') {
            if ($.fn.DataTable.isDataTable(selector)) {
                initializedTables.add(selector);
                return; // Already initialized
            }
        }
        
        // Check if table has data rows (not just loading/empty rows)
        const hasDataRows = $table.find('tbody tr').filter(function() {
            return !$(this).find('td[colspan]').length;
        }).length > 0;
        
        if (!hasDataRows) {
            return; // No data to display, don't initialize
        }
        
        // Mark as initializing to prevent concurrent initialization
        initializingTables.add(selector);
        
        // Destroy existing DataTable if it exists (shouldn't happen, but be safe)
        try {
            if (typeof $.fn.DataTable !== 'undefined' && typeof $.fn.DataTable.isDataTable === 'function') {
                if ($.fn.DataTable.isDataTable(selector)) {
                    $table.DataTable().destroy();
                    $table.removeData('DataTable');
                }
            }
        } catch (destroyError) {
            // Ignore destroy errors
        }
        
        // Initialize DataTable
        try {
            $table.DataTable({
                "order": [orderCol],
                "pageLength": 25,
                "destroy": true // Allow re-initialization if needed
            });
            initializedTables.add(selector);
            initializingTables.delete(selector);
        } catch (initError) {
            console.warn('Error initializing DataTable:', initError);
            initializedTables.delete(selector);
            initializingTables.delete(selector);
        }
    }
    
    function formatAddresses(pool) {
        if (pool.type === 'cilium' && pool.blocks && Array.isArray(pool.blocks)) {
            let html = '';
            pool.blocks.forEach(address => {
                if (typeof address === 'object') {
                    if (address.start) html += escapeHtml(String(address.start)) + ' - ';
                    if (address.stop) html += escapeHtml(String(address.stop)) + '<br>';
                    if (address.cidr) html += escapeHtml(String(address.cidr)) + '<br>';
                }
            });
            return html;
        } else if (pool.addresses && Array.isArray(pool.addresses)) {
            return pool.addresses.map(addr => escapeHtml(String(addr))).join('<br>');
        }
        return '-';
    }
    
    function formatPeerAddress(bgppeers) {
        if (bgppeers.type === 'cilium' && bgppeers.virtual_routers && Array.isArray(bgppeers.virtual_routers)) {
            let html = '';
            bgppeers.virtual_routers.forEach(router => {
                if (router.neighbors && Array.isArray(router.neighbors)) {
                    router.neighbors.forEach(neighbor => {
                        if (neighbor.peerAddress) {
                            html += escapeHtml(String(neighbor.peerAddress)) + '<br>';
                        }
                    });
                }
            });
            return html || '-';
        } else if (bgppeers.peerAddress) {
            return escapeHtml(String(bgppeers.peerAddress));
        }
        return '-';
    }
    
    function populateIPAddressPoolsTable(pools, selected, namespace) {
        const tbody = document.getElementById('ipaddresspool-tbody');
        if (!tbody) {
            console.error('ipaddresspool-tbody element not found');
            return;
        }
        
        if (!pools || !Array.isArray(pools) || pools.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No IP address pools found</td></tr>';
            return;
        }
        
        try {
            // Store pools data in a global object for access in event delegation
            if (!window.loadbalancerPoolsData) {
                window.loadbalancerPoolsData = {};
            }

            const rows = pools.map((pool, index) => {
                if (!pool || typeof pool !== 'object') {
                    return '';
                }
                const name = escapeHtml(pool.name || '');
                const type = escapeHtml(pool.type || '');
                const addresses = formatAddresses(pool);
                const isSelected = selected === pool.name;
                const rowClass = isSelected ? 'selected' : '';

                // Store pool data in global object
                const poolKey = `ipaddresspool_${index}_${name}`;
                try {
                    window.loadbalancerPoolsData[poolKey] = pool;
                } catch (e) {
                    console.warn('Error storing pool data:', e);
                }

                return `
                    <tr id="${name}" class="${rowClass}">
                        <td>${type}</td>
                        <td>
                            <form class="inline-form" action="/plugins/external-loadbalancer/data" method="POST" data-pool-key="${poolKey}" data-object-type="ipaddresspool">
                                <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                                <input type="hidden" name="object_type" value="ipaddresspool" />
                                <input type="hidden" name="ns_select" value="${escapeHtml(namespace || 'default')}" />
                                <a href="#" class="form-submit-link">${name}</a>
                            </form>
                        </td>
                        <td>${addresses}</td>
                    </tr>
                `;
            }).filter(row => row !== '').join('');
            
            tbody.innerHTML = rows;
            
            // Initialize DataTable after a short delay to ensure DOM is updated
            setTimeout(function() {
                safeInitDataTable('#ipaddresspoolTable', [1, "asc"]);
            }, 50);
        } catch (error) {
            console.error('Error populating IP address pools table:', error);
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Error loading data: ' + escapeHtml(error.message) + '</td></tr>';
        }
    }
    
    function populateL2AdvertisementsTable(advertisements, namespace) {
        const tbody = document.getElementById('l2advertisement-tbody');

        if (!advertisements || advertisements.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No L2 advertisements found</td></tr>';
            return;
        }

        const rows = advertisements.map(adv => {
            const name = escapeHtml(adv.name || '');
            const type = escapeHtml(adv.type || '');
            let poolsHtml = '-';
            if (adv.ipAddressPools && Array.isArray(adv.ipAddressPools)) {
                poolsHtml = adv.ipAddressPools.map(pool =>
                    `<a href="#" class="go-to-tab-link" data-tab-type="l2advertisement" data-tab-name="${escapeHtml(pool)}">${escapeHtml(pool)}</a>`
                ).join('<br>');
            }

            const advDataAttr = escapeHtml(JSON.stringify(adv));
            return `
                <tr>
                    <td>${type}</td>
                    <td>
                        <form class="inline-form" action="/plugins/external-loadbalancer/data" method="POST" data-object-type="l2advertisement" data-object-data='${advDataAttr}'>
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="object_type" value="l2advertisement" />
                            <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                            <a href="#" class="form-submit-link">${name}</a>
                        </form>
                    </td>
                    <td>${poolsHtml}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTable after a short delay to ensure DOM is updated
        setTimeout(function() {
            safeInitDataTable('#l2advertisementTable', [1, "asc"]);
        }, 50);
    }
    
    function populateBGPPeersTable(peers, namespace) {
        const tbody = document.getElementById('bgppeers-tbody');
        const tabContainer = document.getElementById('bgppeers-tab-container');
        
        if (!peers || peers.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No BGP peers found</td></tr>';
            if (tabContainer) tabContainer.style.display = 'none';
            return;
        }
        
        if (tabContainer) tabContainer.style.display = '';
        
        const rows = peers.map(peer => {
            const name = escapeHtml(peer.name || '');
            const type = escapeHtml(peer.type || '');
            const peerAddress = formatPeerAddress(peer);

            const peerDataAttr = escapeHtml(JSON.stringify(peer));
            return `
                <tr>
                    <td>${type}</td>
                    <td>
                        <form class="inline-form" action="/plugins/external-loadbalancer/data" method="POST" data-object-type="bgppeers" data-object-data='${peerDataAttr}'>
                            <input type="hidden" name="csrf_token" value="${escapeHtml(csrf_token)}">
                            <input type="hidden" name="object_type" value="bgppeers" />
                            <input type="hidden" name="ns_select" value="${escapeHtml(namespace)}" />
                            <a href="#" class="form-submit-link">${name}</a>
                        </form>
                    </td>
                    <td>${peerAddress}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTable after a short delay to ensure DOM is updated
        setTimeout(function() {
            safeInitDataTable('#bgppeersTable', [1, "asc"]);
        }, 50);
    }
    
    function populateBGPAdvertisementsTable(advertisements) {
        const tbody = document.getElementById('bgpadvertisement-tbody');
        
        if (!advertisements || advertisements.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No BGP advertisements found</td></tr>';
            return;
        }
        
        const rows = advertisements.map(adv => {
            const name = escapeHtml(adv.name || '');
            const type = escapeHtml(adv.type || '');
            let poolsHtml = '-';
            if (adv.ipAddressPools && Array.isArray(adv.ipAddressPools)) {
                poolsHtml = adv.ipAddressPools.map(pool =>
                    `<a href="#" class="go-to-tab-link" data-tab-type="bgpadvertisement" data-tab-name="${escapeHtml(pool)}">${escapeHtml(pool)}</a>`
                ).join('<br>');
            }

            return `
                <tr>
                    <td>${type}</td>
                    <td>${name}</td>
                    <td>${poolsHtml}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTable after a short delay to ensure DOM is updated
        setTimeout(function() {
            safeInitDataTable('#bgpadvertisementTable', [1, "asc"]);
        }, 50);
    }
    
    function goToTab(tabType, elementName) {
        if (tabType === 'l2advertisement' || tabType === 'bgpadvertisement') {
        $('#ipaddresspool-tab').tab('show');
            // Scroll to element if it exists
            setTimeout(function() {
                const element = document.getElementById(elementName);
                if (element) {
                    element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    element.classList.add('selected');
                }
            }, 300);
        }
    }
    
    async function loadIPAddressPools(namespace) {
        try {
            const apiUrl = `/api/v1/plugins/external-loadbalancer/ip-address-pools?namespace=${encodeURIComponent(namespace)}`;
            console.log('Loading IP address pools from:', apiUrl);
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                },
                credentials: 'same-origin'
            });
            console.log('IP address pools response status:', response.status);
            if (!response.ok) {
                const errorText = await response.text();
                console.error('IP address pools HTTP error:', response.status, errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            console.log('IP address pools data received:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load IP address pools');
            }
            
            populateIPAddressPoolsTable(data.data || [], selected, namespace);
        } catch (error) {
            console.error('Error loading IP address pools:', error);
            const tbody = document.getElementById('ipaddresspool-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Error loading IP address pools: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    async function loadL2Advertisements(namespace) {
        try {
            const apiUrl = `/api/v1/plugins/external-loadbalancer/l2-advertisements?namespace=${encodeURIComponent(namespace)}`;
            console.log('Loading L2 advertisements from:', apiUrl);
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                },
                credentials: 'same-origin'
            });
            console.log('L2 advertisements response status:', response.status);
            if (!response.ok) {
                const errorText = await response.text();
                console.error('L2 advertisements HTTP error:', response.status, errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            console.log('L2 advertisements data received:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load L2 advertisements');
            }
            
            populateL2AdvertisementsTable(data.data || [], namespace);
        } catch (error) {
            console.error('Error loading L2 advertisements:', error);
            const tbody = document.getElementById('l2advertisement-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Error loading L2 advertisements: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    async function loadBGPAdvertisements(namespace) {
        try {
            const apiUrl = `/api/v1/plugins/external-loadbalancer/bgp-advertisements?namespace=${encodeURIComponent(namespace)}`;
            console.log('Loading BGP advertisements from:', apiUrl);
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                },
                credentials: 'same-origin'
            });
            console.log('BGP advertisements response status:', response.status);
            if (!response.ok) {
                const errorText = await response.text();
                console.error('BGP advertisements HTTP error:', response.status, errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            console.log('BGP advertisements data received:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load BGP advertisements');
            }
            
            populateBGPAdvertisementsTable(data.data || []);
        } catch (error) {
            console.error('Error loading BGP advertisements:', error);
            const tbody = document.getElementById('bgpadvertisement-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Error loading BGP advertisements: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    async function loadBGPPeers(namespace) {
        try {
            const apiUrl = `/api/v1/plugins/external-loadbalancer/bgp-peers?namespace=${encodeURIComponent(namespace)}`;
            console.log('Loading BGP peers from:', apiUrl);
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                },
                credentials: 'same-origin'
            });
            console.log('BGP peers response status:', response.status);
            if (!response.ok) {
                const errorText = await response.text();
                console.error('BGP peers HTTP error:', response.status, errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            console.log('BGP peers data received:', data);
            
            if (data.error) {
                throw new Error(data.message || 'Failed to load BGP peers');
            }
            
            populateBGPPeersTable(data.data || [], namespace);
        } catch (error) {
            console.error('Error loading BGP peers:', error);
            const tbody = document.getElementById('bgppeers-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Error loading BGP peers: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data when page loads
    // Test if script is executing
    console.log('=== External LoadBalancer Script Loaded ===');
    
    // Try immediate execution first
    if (document.readyState === 'loading') {
        console.log('Document still loading, waiting for DOMContentLoaded...');
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOMContentLoaded fired!');
            initializePage();
        });
    } else {
        console.log('Document already loaded, initializing immediately...');
        // Document already loaded
        setTimeout(initializePage, 100);
    }
    
    function initializePage() {
        console.log('External LoadBalancer page initializing...');
        try {
            const namespace = getSelectedNamespace();
            console.log('Selected namespace:', namespace);
            
            // Load all data in parallel
            console.log('Starting to load all data...');
            loadIPAddressPools(namespace);
            loadL2Advertisements(namespace);
            loadBGPAdvertisements(namespace);
            loadBGPPeers(namespace);
        
            // Switch to the correct tab if a specific type was selected
            if (selected_type) {
                setTimeout(function() {
                    if (typeof $ !== 'undefined') {
                        const tabId = '#' + selected_type + '-tab';
                        $(tabId).tab('show');
                    }
                }, 200);
            }
            
            // Reload data when namespace changes
            const namespaceSelect = document.getElementById('inputGroupSelect04');
            if (namespaceSelect) {
                namespaceSelect.addEventListener('change', function() {
                    const newNamespace = this.value;
                    sessionStorage.setItem('ns_select', newNamespace);
                    loadIPAddressPools(newNamespace);
                    loadL2Advertisements(newNamespace);
                    loadBGPAdvertisements(newNamespace);
                    loadBGPPeers(newNamespace);
                });
            }
            
            // Note: DataTables are initialized automatically when data is loaded
            // in the populate*Table functions. No need to initialize empty tables.
            
            // Handle tab switching - DataTables will be initialized when data loads
            // This is just for edge cases where a table might need re-initialization
            if (typeof $ !== 'undefined') {
                $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                    // Only try to initialize if the table has data and isn't already initialized
                    setTimeout(function() {
                        let selector = null;
                        if (e.target.id === 'ipaddresspool-tab') {
                            selector = '#ipaddresspoolTable';
                        } else if (e.target.id === 'l2advertisement-tab') {
                            selector = '#l2advertisementTable';
                        } else if (e.target.id === 'bgppeers-tab') {
                            selector = '#bgppeersTable';
                        } else if (e.target.id === 'bgpadvertisement-tab') {
                            selector = '#bgpadvertisementTable';
                        }
                        
                        if (selector) {
                            const $table = $(selector);
                            // Only initialize if table has data rows and isn't already a DataTable
                            if ($table.length && $table.find('tbody tr').filter(function() {
                                return !$(this).find('td[colspan]').length;
                            }).length > 0) {
                                if (typeof $.fn.DataTable.isDataTable === 'function' && !$.fn.DataTable.isDataTable(selector)) {
                                    safeInitDataTable(selector, [1, "asc"]);
                                }
                            }
                        }
                    }, 100);
                });
            }
        } catch (error) {
            console.error('Error in initializePage:', error);
        }
    }

    // CSP-compliant event delegation for inline handlers
    document.addEventListener('click', function(e) {
        const link = e.target.closest('.form-submit-link');
        if (link) {
            e.preventDefault();
            const form = link.closest('form');
            if (form) form.submit();
            return;
        }

        const goTabLink = e.target.closest('.go-to-tab-link');
        if (goTabLink) {
            e.preventDefault();
            const tabType = goTabLink.getAttribute('data-tab-type');
            const tabName = goTabLink.getAttribute('data-tab-name');
            if (tabType && tabName) {
                goToTab(tabType, tabName);
            }
        }
    });

    document.addEventListener('submit', function(e) {
        const form = e.target.closest('.inline-form');
        if (form) {
            const objectType = form.getAttribute('data-object-type');
            const objectData = form.getAttribute('data-object-data');
            const poolKey = form.getAttribute('data-pool-key');

            if (poolKey && window.loadbalancerPoolsData && window.loadbalancerPoolsData[poolKey]) {
                sessionStorage.setItem('loadbalancer_object_data', JSON.stringify(window.loadbalancerPoolsData[poolKey]));
            } else if (objectData) {
                try {
                    sessionStorage.setItem('loadbalancer_object_data', objectData);
                } catch (parseError) {
                    console.warn('Error storing object data in sessionStorage:', parseError);
                }
            }

            if (objectType) {
                sessionStorage.setItem('loadbalancer_object_type', objectType);
            }
        }
    });
    } catch (error) {
        console.error('Error in External LoadBalancer script:', error);
        // Show error in UI
        const errorDiv = document.createElement('div');
        errorDiv.className = 'alert alert-danger';
        errorDiv.textContent = 'Error loading External LoadBalancer page: ' + error.message;
        document.body.insertBefore(errorDiv, document.body.firstChild);
    }
})();

    // Event delegation for form submission links (CSP-compliant)
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('form-submit-link')) {
            e.preventDefault();
            const form = e.target.closest('form');
            if (form) {
                form.submit();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('inline-form')) {
            const form = e.target;
            const inputs = form.querySelectorAll('input[type="hidden"]');
            inputs.forEach(input => {
                if (input.name && input.value) {
                    sessionStorage.setItem(input.name, input.value);
                }
            });
        }
    });
</script>
{% endblock %}

