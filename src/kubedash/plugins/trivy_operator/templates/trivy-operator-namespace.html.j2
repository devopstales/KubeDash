    async function loadReports(reportType, namespace) {
        try {
            const apiUrl = `/api/v1/plugins/trivy-operator/${reportType}?namespace=${encodeURIComponent(namespace)}`;
            console.log(`Loading ${reportType} from:`, apiUrl);
            
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                },
                credentials: 'same-origin'
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error(`HTTP error for ${reportType}:`, response.status, errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log(`${reportType} data received:`, data);
            
            if (data.error) {
                throw new Error(data.message || `Failed to load ${reportType}`);
            }
            
            const reports = data.data || [];
            
            switch(reportType) {
                case 'vulnerability-reports':
                    populateVulnerabilityTable(reports);
                    break;
                case 'config-audit-reports':
                    populateConfigAuditTable(reports);
                    break;
                case 'exposed-secret-reports':
                    populateExposedSecretTable(reports);
                    break;
                case 'rbac-assessment-reports':
                    populateRbacAssessmentTable(reports);
                    break;
                case 'sbom-reports':
                    populateSbomTable(reports);
                    break;
                case 'infra-assessment-reports':
                    populateInfraAssessmentTable(reports);
                    break;
            }
        } catch (error) {
            console.error(`Error loading ${reportType}:`, error);
            const tbodyId = reportType.replace(/-reports$/, '').replace(/-/g, '') + '-tbody';
            const tbody = document.getElementById(tbodyId);
            if (tbody) {
                tbody.innerHTML = `<tr><td class="text-center text-danger" colspan="10">Error loading ${reportType}: ${escapeHtml(error.message)}</td></tr>`;
            }
        }
    }
    
    function initializePage() {
        console.log('Trivy Operator namespace page initializing...');
        const namespace = getSelectedNamespace();
        console.log('Selected namespace:', namespace);
        
        // Load all reports in parallel
        loadReports('vulnerability-reports', namespace);
        loadReports('config-audit-reports', namespace);
        loadReports('exposed-secret-reports', namespace);
        loadReports('rbac-assessment-reports', namespace);
        loadReports('sbom-reports', namespace);
        loadReports('infra-assessment-reports', namespace);
        
        // Listen for namespace changes
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            topbarSelect.addEventListener('change', function() {
                const newNamespace = this.value || 'default';
                console.log('Namespace changed to:', newNamespace);
                initializePage();
            });
        }
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializePage);
    } else {
        setTimeout(initializePage, 100);
    }
})();
</script>
{% endblock %}
