<script>
(function() {
    'use strict';
    
    const escapeHtml = (text) => {
        if (text === null || text === undefined) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    };
    
    function getSelectedNamespace() {
        const topbarSelect = document.getElementById('inputGroupSelect04');
        if (topbarSelect) {
            return topbarSelect.value || 'default';
        }
        return 'default';
    }
    
    function updateBadgeCount(reportType, count) {
        const badge = document.getElementById(reportType + '-count');
        if (badge) {
            badge.textContent = count;
        }
    }
    
    function populateVulnerabilityTable(reports) {
        const tbody = document.getElementById('vulnerability-tbody');
        if (!reports || reports.length === 0) {
            tbody.innerHTML = '<tr><td class="text-center text-muted" colspan="8">No Vulnerability Reports found</td></tr>';
            updateBadgeCount('vulnerabilityreports', 0);
            return;
        }
        
        updateBadgeCount('vulnerabilityreports', reports.length);
        
        const rows = reports.map(report => {
            const resourceLink = `/plugins/trivy-operator/vulnerability/${escapeHtml(report.namespace)}/${escapeHtml(report.name)}`;
            return `
                <tr>
                    <td>
                        <a href="${resourceLink}">${escapeHtml(report.resource_kind)}/${escapeHtml(report.resource_name)}</a>
                        <br>
                        <small class="text-muted">${escapeHtml(report.namespace)}</small>
                    </td>
                    <td><code>${escapeHtml(report.container_name)}</code></td>
                    <td>${report.critical > 0 ? `<span class="badge bg-danger">${report.critical}</span>` : '<span class="badge bg-secondary">0</span>'}</td>
                    <td>${report.high > 0 ? `<span class="badge bg-warning text-dark">${report.high}</span>` : '<span class="badge bg-secondary">0</span>'}</td>
                    <td>${report.medium > 0 ? `<span class="badge bg-info">${report.medium}</span>` : '<span class="badge bg-secondary">0</span>'}</td>
                    <td>${report.low > 0 ? `<span class="badge bg-primary">${report.low}</span>` : '<span class="badge bg-secondary">0</span>'}</td>
                    <td><strong>${report.total}</strong></td>
                    <td>${escapeHtml(report.age)}</td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        setTimeout(() => {
            if ($.fn.DataTable && !$.fn.DataTable.isDataTable('#vulnerabilityTable')) {
                $('#vulnerabilityTable').DataTable({
                    "order": [[6, "desc"]],
                    "pageLength": 25
                });
            }
        }, 50);
    }
    
