{% extends "base2.html.j2" %}

{% block body_extra_class %}mcp-chat-body-no-scroll{% endblock %}

{% block add_head_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='/vendor/highlightjs@11.4.0/an-old-hope.min.css') }}">
<style nonce="{{ csp_nonce }}">
  /* Body must not scroll; be a flex container so the chat fills height and input bar stays visible */
  .mcp-chat-body-no-scroll {
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
  }
  /* Consistent spacing around the chat card on all sides */
  .mcp-chat-page-wrapper {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 1rem;
  }
  .mcp-chat-page-wrapper .mcp-chat-page {
    flex: 1;
    min-height: 0;
  }
  /* MCP Chat: edgy AI chatbot layout, theme-aware (no white in dark mode) */
  .mcp-chat-page {
    --mcp-accent: var(--cui-primary);
    --mcp-radius: 12px;
    --mcp-radius-sm: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .mcp-chat-page .card {
    background-color: var(--cui-body-bg);
    border: 1px solid var(--cui-border-color);
    border-radius: var(--mcp-radius);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  /* Card body: constrain height so pane scrolls and input bar stays visible */
  .mcp-chat-page .card-body.d-flex.flex-column {
    min-height: 0;
    overflow: hidden;
  }
  .mcp-chat-input-bar {
    flex-shrink: 0;
    padding: 1rem 1.25rem;
    background-color: var(--cui-tertiary-bg);
    border-top: 1px solid var(--cui-border-color);
  }
  [data-coreui-theme="dark"] .mcp-chat-page .card {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
  }
  .mcp-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background-color: var(--cui-tertiary-bg);
    border-bottom: 2px solid var(--mcp-accent);
    color: var(--cui-body-color);
  }
  .mcp-chat-header h6 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }
  .mcp-chat-header .mcp-chat-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--mcp-radius-sm);
    background: linear-gradient(135deg, var(--cui-primary), var(--cui-info));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 0.85rem;
  }
  .mcp-chat-page .btn-outline-secondary {
    border-radius: var(--mcp-radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .mcp-chat-pane {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1.25rem 1.5rem;
    background-color: var(--cui-body-bg);
    color: var(--cui-body-color);
  }
  .mcp-chat-page .mcp-msg {
    display: flex;
    margin-bottom: 1.25rem;
    max-width: 92%;
  }
  .mcp-chat-page .mcp-msg.mcp-msg-user {
    margin-left: auto;
    justify-content: flex-end;
  }
  .mcp-chat-page .mcp-bubble {
    padding: 0.875rem 1.125rem;
    border-radius: var(--mcp-radius);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .mcp-chat-page .mcp-bubble-user {
    background: linear-gradient(135deg, var(--cui-primary), #6261cc);
    color: #fff;
    border: none;
    box-shadow: 0 2px 12px rgba(88, 86, 214, 0.35);
    border-bottom-right-radius: 4px;
  }
  .mcp-chat-page .mcp-bubble-assistant {
    background-color: var(--cui-tertiary-bg);
    color: var(--cui-body-color);
    border: 1px solid var(--cui-border-color);
    border-left: 3px solid var(--mcp-accent);
    border-bottom-left-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }
  [data-coreui-theme="dark"] .mcp-chat-page .mcp-bubble-assistant {
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }
  .mcp-chat-page .mcp-bubble-assistant .table,
  .mcp-chat-page .mcp-assistant-content .table {
    --cui-table-bg: transparent;
    color: var(--cui-body-color);
    border-color: var(--cui-border-color);
  }
  .mcp-chat-page .mcp-bubble-assistant .table th,
  .mcp-chat-page .mcp-bubble-assistant .table td,
  .mcp-chat-page .mcp-assistant-content .table th,
  .mcp-chat-page .mcp-assistant-content .table td {
    background-color: transparent;
    border-color: var(--cui-border-color);
    color: var(--cui-body-color);
  }
  .mcp-chat-page .mcp-bubble-assistant code,
  .mcp-chat-page .mcp-assistant-content code {
    background-color: var(--cui-secondary-bg);
    color: var(--cui-code-color);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }
  .mcp-chat-page .mcp-raw-block {
    margin: 0.75rem 0;
    border-radius: var(--mcp-radius-sm);
    overflow: hidden;
    border: 1px solid var(--cui-border-color);
    background-color: var(--cui-secondary-bg);
  }
  .mcp-chat-page .mcp-raw-block pre {
    margin: 0;
    padding: 1rem;
    overflow: auto;
    max-height: 20rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    white-space: pre;
  }
  .mcp-chat-page .mcp-raw-block pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .mcp-chat-empty {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--cui-secondary-color);
  }
  .mcp-chat-empty .mcp-empty-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: var(--cui-tertiary-bg);
    border: 2px solid var(--cui-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cui-primary);
    font-size: 1.5rem;
  }
  .mcp-chat-empty p {
    margin-bottom: 0.35rem;
    font-size: 0.9375rem;
  }
  .mcp-chat-empty .mcp-empty-hint {
    font-size: 0.8125rem;
    opacity: 0.85;
  }
  .mcp-chat-input-wrap {
    display: flex;
    gap: 0.5rem;
    align-items: flex-end;
    background-color: var(--cui-body-bg);
    border: 1px solid var(--cui-border-color);
    border-radius: var(--mcp-radius);
    padding: 0.5rem 0.75rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .mcp-chat-input-wrap:focus-within {
    border-color: var(--mcp-accent);
    box-shadow: 0 0 0 3px rgba(88, 86, 214, 0.15);
  }
  .mcp-chat-page #mcp-chat-input {
    flex: 1;
    border: none !important;
    background: transparent !important;
    resize: none;
    min-height: 44px;
    padding: 0.5rem 0;
    font-size: 0.9375rem;
  }
  .mcp-chat-page #mcp-chat-input:focus {
    outline: none;
    box-shadow: none;
  }
  .mcp-chat-page .mcp-send-btn {
    border-radius: var(--mcp-radius-sm);
    padding: 0.5rem 1rem;
    font-weight: 500;
    flex-shrink: 0;
  }
  .mcp-chat-page #mcp-chat-error {
    color: var(--cui-danger);
    font-size: 0.8125rem;
    margin-top: 0.5rem;
    padding-left: 0.25rem;
  }
  /* Sidebar: find your precious chats (mcp-chat style). This div must not scroll. */
  .mcp-chat-layout {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    overflow-y: hidden;
  }
  .mcp-chat-sidebar {
    width: 260px;
    min-width: 260px;
    background-color: var(--cui-tertiary-bg);
    border-right: 1px solid var(--cui-border-color);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .mcp-chat-sidebar-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--cui-border-color);
    flex-shrink: 0;
  }
  .mcp-chat-sidebar-list {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 0;
  }
  .mcp-chat-sidebar-row {
    display: flex;
    align-items: center;
    width: 100%;
    border-left: 3px solid transparent;
    background: transparent;
    margin-bottom: 0;
  }
  .mcp-chat-sidebar-row:hover {
    background-color: var(--cui-secondary-bg);
  }
  .mcp-chat-sidebar-row.active {
    background-color: var(--cui-secondary-bg);
    border-left-color: var(--mcp-accent);
  }
  .mcp-chat-sidebar-item {
    display: block;
    flex: 1;
    width: 0;
    text-align: left;
    padding: 0.6rem 0.5rem 0.6rem 1rem;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--cui-body-color);
    font-size: 0.875rem;
    line-height: 1.35;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mcp-chat-sidebar-item:hover {
    background: transparent;
  }
  .mcp-chat-sidebar-row.active .mcp-chat-sidebar-item {
    font-weight: 500;
  }
  .mcp-chat-sidebar-item .mcp-chat-sidebar-date {
    display: block;
    font-size: 0.75rem;
    color: var(--cui-secondary-color);
    margin-top: 0.2rem;
  }
  .mcp-chat-sidebar-delete {
    flex-shrink: 0;
    padding: 0.35rem 0.5rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--cui-secondary-color);
    cursor: pointer;
    opacity: 0.7;
  }
  .mcp-chat-sidebar-delete:hover {
    color: var(--cui-danger);
    opacity: 1;
    background: rgba(220, 53, 69, 0.1);
  }
  .mcp-chat-sidebar-row:hover .mcp-chat-sidebar-delete {
    opacity: 1;
  }
  .mcp-chat-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .mcp-chat-sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 1020;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      box-shadow: 4px 0 12px rgba(0,0,0,0.1);
    }
    .mcp-chat-sidebar.open {
      transform: translateX(0);
    }
    .mcp-chat-main {
      width: 100%;
    }
  }
</style>
{% endblock %}

{% block topmenu %}
