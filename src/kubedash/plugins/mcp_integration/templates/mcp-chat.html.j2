{% block content %}
<div class="mcp-chat-page-wrapper d-flex flex-column flex-grow-1">
  <div class="mcp-chat-page card flex-grow-1 d-flex flex-column">
  <div class="mcp-chat-layout">
    <aside class="mcp-chat-sidebar" id="mcp-chat-sidebar" aria-label="Chat history">
      <div class="mcp-chat-sidebar-header">
        <button type="button" class="btn btn-primary btn-sm w-100" id="mcp-chat-new" title="New conversation"><i class="fas fa-plus me-1"></i> New chat</button>
      </div>
      <div class="mcp-chat-sidebar-list" id="mcp-chat-sidebar-list">
        <div class="text-muted small px-3 py-2" id="mcp-chat-sidebar-empty">No chats yet. Start one with &quot;New chat&quot;.</div>
      </div>
    </aside>
    <div class="mcp-chat-main d-flex flex-column">
      <header class="mcp-chat-header">
        <h6>
          <button type="button" class="btn btn-link btn-sm p-0 me-2 d-md-none" id="mcp-chat-sidebar-toggle" title="Open chat list" aria-label="Open chat list"><i class="fas fa-bars"></i></button>
          <span class="mcp-chat-icon" aria-hidden="true"><i class="fas fa-robot"></i></span>
          MCP Chat
        </h6>
      </header>
      <div class="card-body d-flex flex-column p-0" style="min-height: 0; flex: 1;">
        <div id="mcp-chat-messages" class="mcp-chat-pane d-flex flex-column">
          <div id="mcp-chat-empty" class="mcp-chat-empty">
            <div class="mcp-empty-icon" aria-hidden="true"><i class="fas fa-comment-dots"></i></div>
            <p class="mb-1">Ask about your cluster in plain language.</p>
            <p class="mcp-empty-hint mb-0">e.g. &quot;List all namespaces&quot; · &quot;List pods in default&quot; · &quot;Helm releases in my-namespace&quot;</p>
          </div>
        </div>
        <div class="mcp-chat-input-bar">
          <div class="mcp-chat-input-wrap">
            <textarea class="form-control" id="mcp-chat-input" rows="1" placeholder="Ask about your cluster..." maxlength="4096"></textarea>
            <button class="btn btn-primary mcp-send-btn" type="button" id="mcp-chat-send" title="Send"><i class="fas fa-paper-plane me-1"></i> Send</button>
          </div>
          <div id="mcp-chat-error" style="display: none;"></div>
        </div>
      </div>
    </div>
  </div>
  </div>
</div>
{% endblock %}

{% block add_tail_js %}
<script src="{{ url_for('static', filename='/vendor/highlightjs@11.4.0/highlight.min.js') }}"></script>
<script nonce="{{ csp_nonce }}">
(function() {
  const messagesEl = document.getElementById('mcp-chat-messages');
  const emptyEl = document.getElementById('mcp-chat-empty');
  const inputEl = document.getElementById('mcp-chat-input');
  const sendBtn = document.getElementById('mcp-chat-send');
  const newBtn = document.getElementById('mcp-chat-new');
  const errorEl = document.getElementById('mcp-chat-error');
  const sidebarListEl = document.getElementById('mcp-chat-sidebar-list');
  const sidebarEmptyEl = document.getElementById('mcp-chat-sidebar-empty');
  const sidebarEl = document.getElementById('mcp-chat-sidebar');
  const sidebarToggleBtn = document.getElementById('mcp-chat-sidebar-toggle');
  var currentConversationId = '';

  function csrfHeader() {
    var meta = document.querySelector('meta[name="csrf-token"]');
    return meta ? meta.getAttribute('content') || '' : '';
  }

  function hideEmpty() {
    if (emptyEl) emptyEl.style.display = 'none';
  }

  function showError(msg) {
    if (errorEl) {
      errorEl.textContent = msg || '';
      errorEl.style.display = msg ? 'block' : 'none';
    }
  }

  function escapeHtml(s) {
    var div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  function formatChatDate(iso) {
    if (!iso) return '';
    var d = new Date(iso);
    var now = new Date();
    var diff = (now - d) / 1000;
    if (diff < 60) return 'Just now';
    if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
    if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
    if (diff < 604800) return Math.floor(diff / 86400) + 'd ago';
    return d.toLocaleDateString();
  }

  function renderAssistantContent(text) {
    if (!text) return '';
    var parts = [];
    var lines = text.split('\n');
    var i = 0;
    while (i < lines.length) {
      var line = lines[i];
      if (line.trim().match(/^\|.+\|$/) && i + 1 < lines.length && lines[i + 1].indexOf('---') !== -1 && lines[i + 1].trim().match(/^\|.+\|$/)) {
        var headerCells = line.split('|').slice(1, -1).map(function(c) { return c.trim(); });
        i += 2;
        var rows = [];
        rows.push('<tr>' + headerCells.map(function(c) { return '<th scope="col">' + escapeHtml(c) + '</th>'; }).join('') + '</tr>');
        while (i < lines.length && lines[i].trim().match(/^\|.+\|$/)) {
          var cells = lines[i].split('|').slice(1, -1).map(function(c) { return c.trim(); });
          rows.push('<tr>' + cells.map(function(c) { return '<td>' + escapeHtml(c) + '</td>'; }).join('') + '</tr>');
          i++;
        }
        parts.push('<div class="table-responsive"><table class="table table-sm table-bordered mb-0">' + rows.join('') + '</table></div>');
        continue;
      }
      var fenceMatch = line.trim().match(/^```(\w*)\s*$/);
      if (fenceMatch) {
        var lang = (fenceMatch[1] || 'log').toLowerCase();
        if (lang === '') lang = 'log';
        i++;
        var codeLines = [];
        while (i < lines.length && !lines[i].trim().match(/^```\s*$/)) {
          codeLines.push(lines[i]);
          i++;
        }
        if (i < lines.length) i++;
        var codeContent = escapeHtml(codeLines.join('\n'));
        parts.push('<div class="mcp-raw-block"><pre><code class="language-' + escapeHtml(lang) + '">' + codeContent + '</code></pre></div>');
        continue;
      }
      if (line.trim().match(/^[-*]\s+/)) {
        var listItems = [];
        while (i < lines.length && lines[i].trim().match(/^[-*]\s+/)) {
          var bulletContent = lines[i].trim().replace(/^[-*]\s+/, '');
          bulletContent = escapeHtml(bulletContent).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/`([^`]+)`/g, '<code>$1</code>');
          listItems.push('<li>' + bulletContent + '</li>');
          i++;
        }
        if (listItems.length) parts.push('<ul class="mb-2 list-unstyled">' + listItems.join('') + '</ul>');
        continue;
      }
      var para = escapeHtml(line);
      para = para.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      para = para.replace(/`([^`]+)`/g, '<code>$1</code>');
      if (para) parts.push('<p class="mb-1">' + para + '</p>');
      i++;
    }
    return parts.join('');
  }

  function highlightCodeInElement(el) {
    if (typeof hljs === 'undefined') return;
    var blocks = el.querySelectorAll('pre code');
    for (var b = 0; b < blocks.length; b++) {
      try { hljs.highlightElement(blocks[b]); } catch (e) {}
    }
  }

  function addMessage(role, content, isPlaceholder) {
    hideEmpty();
    var wrap = document.createElement('div');
    wrap.className = 'mcp-msg' + (role === 'user' ? ' mcp-msg-user' : '');
    var bubble = document.createElement('div');
    bubble.className = role === 'user' ? 'mcp-bubble mcp-bubble-user' : 'mcp-bubble mcp-bubble-assistant';
    if (isPlaceholder) {
      bubble.id = 'mcp-chat-loading';
      bubble.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Thinking...';
    } else {
      if (role === 'assistant') {
        bubble.innerHTML = renderAssistantContent(content);
        bubble.classList.add('mcp-assistant-content');
      } else {
        bubble.textContent = content;
      }
    }
    wrap.appendChild(bubble);
    messagesEl.appendChild(wrap);
    if (!isPlaceholder && role === 'assistant') highlightCodeInElement(bubble);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return bubble;
  }

  function clearMessages() {
    while (messagesEl.lastChild) messagesEl.removeChild(messagesEl.lastChild);
    if (emptyEl) {
      messagesEl.appendChild(emptyEl);
      emptyEl.style.display = 'block';
    }
  }

  function removeLoading() {
    var loading = document.getElementById('mcp-chat-loading');
    if (loading && loading.closest) loading.closest('.mcp-msg').remove();
  }

  function fetchConversations() {
    return fetch('/api/v1/plugins/mcp-integration/chat/conversations?limit=50', {
      headers: { 'X-CSRFToken': csrfHeader() }
    }).then(function(res) {
      if (!res.ok) return { conversations: [] };
      return res.json().then(function(data) { return data || { conversations: [] }; }).catch(function() { return { conversations: [] }; });
    });
  }

  function deleteConversation(id, ev) {
    if (ev) ev.stopPropagation();
    if (!id) return;
    fetch('/api/v1/plugins/mcp-integration/chat/conversations/' + id, {
      method: 'DELETE',
      headers: { 'X-CSRFToken': csrfHeader() }
    })
      .then(function(res) {
        if (!res.ok) return res.json().then(function(data) { throw new Error(data.message || res.statusText); });
        return res.json();
      })
      .then(function() {
        if (currentConversationId === id) {
          currentConversationId = '';
          clearMessages();
        }
        refreshSidebarThen(function() {
          if (sidebarEmptyEl) sidebarEmptyEl.style.display = (window._mcpChatConversations || []).length ? 'none' : 'block';
        });
      })
      .catch(function(err) {
        showError(err.message || 'Failed to delete chat');
      });
  }

  function renderSidebar(conversations) {
    if (!sidebarListEl) return;
    if (sidebarEmptyEl) sidebarEmptyEl.style.display = conversations.length ? 'none' : 'block';
    sidebarListEl.querySelectorAll('.mcp-chat-sidebar-row').forEach(function(n) { n.remove(); });
    conversations.forEach(function(c) {
      var row = document.createElement('div');
      row.className = 'mcp-chat-sidebar-row' + (c.id === currentConversationId ? ' active' : '');
      row.setAttribute('data-conversation-id', c.id);

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'mcp-chat-sidebar-item';
      btn.innerHTML = '<span class="mcp-chat-sidebar-title">' + escapeHtml(c.title || 'New chat') + '</span><span class="mcp-chat-sidebar-date">' + formatChatDate(c.updated_at) + '</span>';
      btn.addEventListener('click', function() {
        var id = row.getAttribute('data-conversation-id');
        if (id === currentConversationId) return;
        selectConversation(id);
        if (sidebarEl && window.matchMedia('(max-width: 768px)').matches) sidebarEl.classList.remove('open');
      });

      var delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'mcp-chat-sidebar-delete';
      delBtn.title = 'Delete chat';
      delBtn.setAttribute('aria-label', 'Delete chat');
      delBtn.innerHTML = '<i class="fas fa-trash-alt"></i>';
      delBtn.addEventListener('click', function(e) {
        deleteConversation(c.id, e);
      });

      row.appendChild(btn);
      row.appendChild(delBtn);
      sidebarListEl.appendChild(row);
    });
  }

  function selectConversation(id) {
    if (id === currentConversationId) return;
    renderSidebar((window._mcpChatConversations || []).map(function(c) {
      return { id: c.id, title: c.title, updated_at: c.updated_at };
    }));
    fetch('/api/v1/plugins/mcp-integration/chat/conversations/' + id + '/messages', {
      headers: { 'X-CSRFToken': csrfHeader() }
    })
      .then(function(res) { return res.ok ? res.json() : null; })
      .then(function(data) {
        if (!data || !Array.isArray(data.messages)) return;
        currentConversationId = id;
        clearMessages();
        data.messages.forEach(function(m) {
          addMessage(m.role, m.content || '', false);
        });
        renderSidebar((window._mcpChatConversations || []).map(function(c) {
          return { id: c.id, title: c.title, updated_at: c.updated_at };
        }));
      })
      .catch(function() {});
  }

  function refreshSidebarThen(fn) {
    fetchConversations().then(function(data) {
      var convs = data.conversations || [];
      window._mcpChatConversations = convs;
      renderSidebar(convs);
      if (fn) fn();
    });
  }

  function sendMessage() {
    var text = (inputEl && inputEl.value || '').trim();
    if (!text) return;
    if (sendBtn) sendBtn.disabled = true;
    showError('');

    addMessage('user', text);
    if (inputEl) inputEl.value = '';
    addMessage('assistant', '', true);

    fetch('/api/v1/plugins/mcp-integration/chat/message', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrfHeader()
      },
      body: JSON.stringify({ content: text, conversation_id: currentConversationId })
    })
      .then(function(res) {
        return res.text().then(function(body) {
          if (!res.ok) throw new Error(res.statusText || body.slice(0, 100) || 'Request failed');
          var data;
          try { data = body ? JSON.parse(body) : {}; } catch (parseErr) { throw new Error('Invalid response'); }
          return data;
        });
      })
      .then(function(data) {
        removeLoading();
        if (data && data.conversation_id) currentConversationId = data.conversation_id;
        var content = (data && data.message && data.message.content) ? data.message.content : (data && data.message) || 'No response.';
        addMessage('assistant', content, false);
        refreshSidebarThen();
      })
      .catch(function(err) {
        removeLoading();
        addMessage('assistant', 'Error: ' + (err.message || 'Could not get response.'), false);
        showError(err.message || 'Request failed');
      })
      .finally(function() {
        if (sendBtn) sendBtn.disabled = false;
      });
  }

  if (sendBtn) sendBtn.addEventListener('click', sendMessage);
  if (inputEl) {
    inputEl.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
  }
  if (newBtn) {
    newBtn.addEventListener('click', function() {
      currentConversationId = '';
      clearMessages();
      showError('');
      refreshSidebarThen(function() {
        if (sidebarEmptyEl) sidebarEmptyEl.style.display = 'block';
      });
      if (sidebarEl && window.matchMedia('(max-width: 768px)').matches) sidebarEl.classList.remove('open');
    });
  }
  if (sidebarToggleBtn && sidebarEl) {
    sidebarToggleBtn.addEventListener('click', function() {
      sidebarEl.classList.toggle('open');
    });
  }

  refreshSidebarThen(function() {
    var convs = window._mcpChatConversations || [];
    if (convs.length > 0 && !currentConversationId) {
      selectConversation(convs[0].id);
    }
  });
})();
</script>
{% endblock %}
