{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex" style="margin: 0.5rem 0 !important;">
    <div class="container-fluid" style="padding-left: 1rem; padding-right: 1rem;">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><a href="/plugins/app-catalog/settings">Applications</a></li>
          <li class="breadcrumb-item active"><span>{{ app_name }}</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<style>
    /* Remove padding from body content area for iframe */
    .body.flex-grow-1 {
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        overflow: hidden !important;
        height: 100% !important;
        max-height: 100vh !important;
    }
    /* Prevent wrapper from causing scroll */
    .wrapper {
        overflow: hidden !important;
        height: 100vh;
    }
    /* Make iframe fill available space */
    #app-iframe {
        width: 100%;
        border: none;
        display: block;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }
    /* Hide footer for iframe pages */
    footer.footer {
        display: none !important;
    }
    /* Prevent html/body scroll for this page only */
    html, body {
        height: 100vh;
        overflow: hidden;
    }
</style>
{% if embed_mode and app_url %}
<iframe 
    id="app-iframe"
    src="{{ app_url }}" 
    sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation"
    title="{{ app_name }}"
></iframe>
<script>
    function resizeIframe() {
        const iframe = document.getElementById('app-iframe');
        if (!iframe) return;
        
        // Get all elements that take up vertical space
        const header = document.querySelector('header.header');
        const body = document.querySelector('.body.flex-grow-1');
        const wrapper = document.querySelector('.wrapper');
        
        if (header && body) {
            // Calculate using the body element's position
            const bodyRect = body.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            const bodyTop = bodyRect.top;
            const availableHeight = viewportHeight - bodyTop;
            
            // Set iframe height to fill available space
            iframe.style.height = Math.max(availableHeight, 100) + 'px';
        } else {
            // Fallback: use header height
            const headerHeight = header ? header.offsetHeight : 0;
            const viewportHeight = window.innerHeight;
            iframe.style.height = (viewportHeight - headerHeight) + 'px';
        }
    }
    
    // Use requestAnimationFrame for smoother updates
    function scheduleResize() {
        requestAnimationFrame(resizeIframe);
    }
    
    // Resize on load
    window.addEventListener('load', scheduleResize);
    // Resize on window resize
    window.addEventListener('resize', scheduleResize);
    // Resize immediately (in case DOM is already loaded)
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleResize);
    } else {
        scheduleResize();
    }
    
    // Also resize after a short delay to catch any late-loading elements
    setTimeout(scheduleResize, 100);
</script>
{% elif app_url %}
<div class="p-4 text-center">
    <p class="mb-3">This application is configured to open in a new tab.</p>
    <a href="{{ app_url }}" target="_blank" rel="noopener" class="btn btn-primary">
        Open {{ app_name }} in New Tab
    </a>
</div>
{% else %}
<div class="p-4 text-center">
    <p class="text-danger">Application not found or not configured.</p>
</div>
{% endif %}
{% endblock %}

