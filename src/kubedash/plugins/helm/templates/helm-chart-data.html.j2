{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Plugins</span></li>
          <li class="breadcrumb-item"><a href="/plugins/helm-chart">Helm Charts</a></li>
          <li class="breadcrumb-item active"><span id="chart-name-breadcrumb">Loading...</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div id="chart-data-loading" class="text-center p-4">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p class="mt-2">Loading helm chart data...</p>
</div>

<div id="chart-data-content" style="display: none;">
<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Chart Data</h6>
    </div>
    <div class="card-body">
        <!-- Chart releases -->
        <ul class="nav nav-tabs" id="nav-tab" role="tablist">
            <li class="nav-item">
                    <a class="nav-link active" id="nav-release-tab" data-bs-toggle="tab" href="#nav-release" role="tab" aria-controls="nav-release" aria-selected="true">Release</a>
            </li>
            <li class="nav-item">
                    <a class="nav-link" id="nav-values-tab" data-bs-toggle="tab" href="#nav-values" role="tab" aria-controls="nav-values" aria-selected="false">Values</a>
            </li>
            <li class="nav-item">
                    <a class="nav-link" id="nav-manifests-tab" data-bs-toggle="tab" href="#nav-manifests" role="tab" aria-controls="nav-manifests" aria-selected="false">Manifests</a>
            </li>
            <li class="nav-item">
                    <a class="nav-link" id="nav-resources-tab" data-bs-toggle="tab" href="#nav-resources" role="tab" aria-controls="nav-resources" aria-selected="false">Resources</a>
            </li>
        </ul>

        <div class="tab-content" id="nav-tabContent">
            <!-- release -->
            <div class="tab-pane fade show active" id="nav-release" role="tabpanel" aria-labelledby="nav-release-tab">
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="releaseInfoTable" width="100%" cellspacing="0">
                                    <tbody id="release-info-tbody">
                            <tr>
                                            <td colspan="2" class="text-center">Loading...</td>
                            </tr>
                                    </tbody>
                            </table>
                            </div>
                    </div>
                </div>
            </div>
            <!-- Values -->
                <div class="tab-pane fade" id="nav-values" role="tabpanel" aria-labelledby="nav-values-tab">
                <div id="accordion">
                    <div class="card shadow mb-4">
                        <div class="card-body">
                            <h3>Values</h3>
                            <div class="table-responsive">
                                    <pre id="values-code"><code class="language-yaml">Loading...</code></pre>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Manifests -->
                <div class="tab-pane fade" id="nav-manifests" role="tabpanel" aria-labelledby="nav-manifests-tab">
                <div id="accordion">
                    <div class="card shadow mb-4">
                        <div class="card-body">
                            <h3>Manifests</h3>
                            <div class="table-responsive">
                                    <pre id="manifests-code"><code class="language-yaml">Loading...</code></pre>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- resources -->
                <div class="tab-pane fade" id="nav-resources" role="tabpanel" aria-labelledby="nav-resources-tab">
                <div id="accordion">
                    <div class="card shadow mb-4">
                        <div class="card-body">
                            <h3>Resources</h3>
                            <div class="table-responsive">
                                    <table class="table table-bordered" id="resourcesTable" width="100%" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Resource Type</th>
                                            <th>Name</th>
                                        </tr>
                                    </thead>
                                        <tbody id="resources-tbody">
                                            <tr>
                                                <td colspan="2" class="text-center">Loading...</td>
                                            </tr>
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="chart-data-error" style="display: none;" class="alert alert-danger">
    <h4>Error Loading Chart Data</h4>
    <p id="error-message"></p>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% include "segments/components/highlight_snippet.html.j2"%}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    // Helper function to escape HTML
    function escapeHtml(text) {
        if (text == null) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    // Get parameters from URL query string or sessionStorage
    function getChartParams() {
        const urlParams = new URLSearchParams(window.location.search);
        let releaseName = urlParams.get('release_name');
        let releaseVersion = urlParams.get('release_version');
        let namespace = urlParams.get('namespace');
        
        // Fallback to sessionStorage
        if (!releaseName) {
            releaseName = sessionStorage.getItem('helm_release_name');
        }
        if (!releaseVersion) {
            releaseVersion = sessionStorage.getItem('helm_release_version');
        }
        if (!namespace) {
            namespace = sessionStorage.getItem('ns_select');
        }
        
        // Fallback to topbar selector
        if (!namespace) {
            const topbarSelect = document.getElementById('inputGroupSelect04');
            if (topbarSelect && topbarSelect.value) {
                namespace = topbarSelect.value;
            }
        }
        
        // Final fallback
        if (!namespace) {
            namespace = 'default';
        }
        
        return { releaseName, releaseVersion, namespace };
    }
    
    // Load helm chart data from API
    async function loadChartData() {
        const { releaseName, releaseVersion, namespace } = getChartParams();
        
        if (!releaseName || !releaseVersion) {
            showError('Missing required parameters: release_name and release_version');
            return;
        }
        
        const loadingDiv = document.getElementById('chart-data-loading');
        const contentDiv = document.getElementById('chart-data-content');
        const errorDiv = document.getElementById('chart-data-error');
        
        try {
            const apiUrl = `/api/v1/plugins/helm/charts/${encodeURIComponent(releaseName)}/${releaseVersion}/data?namespace=${encodeURIComponent(namespace)}`;
            console.log('Fetching helm chart data from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                const errorData = await response.json().catch(() => ({ message: `HTTP error! status: ${response.status}` }));
                throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            console.log('Helm chart data API response:', result);
            console.log('Chart data keys:', result.data ? Object.keys(result.data) : 'No data');
            console.log('Deployments:', result.data?.deployments);
            console.log('Daemonset:', result.data?.daemonset);
            console.log('Statefulsets:', result.data?.statefulsets);
            console.log('Services:', result.data?.services);
            
            if (result.data) {
                populateChartData(result.data, releaseName, namespace);
                loadingDiv.style.display = 'none';
                contentDiv.style.display = 'block';
            } else {
                throw new Error(result.message || 'No chart data returned');
            }
        } catch (error) {
            console.error('Error loading helm chart data:', error);
            loadingDiv.style.display = 'none';
            contentDiv.style.display = 'none';
            showError(error.message);
        }
    }
    
    // Show error message
    function showError(message) {
        const errorDiv = document.getElementById('chart-data-error');
        const errorMessage = document.getElementById('error-message');
        errorMessage.textContent = message;
        errorDiv.style.display = 'block';
    }
    
    // Populate chart data in all tabs
    function populateChartData(chartData, releaseName, namespace) {
        // Update breadcrumb
        const breadcrumb = document.getElementById('chart-name-breadcrumb');
        if (breadcrumb) {
            breadcrumb.textContent = releaseName;
        }
        
        // Populate Release tab
        populateReleaseTab(chartData, releaseName, namespace);
        
        // Populate Values tab
        populateValuesTab(chartData);
        
        // Populate Manifests tab
        populateManifestsTab(chartData);
        
        // Populate Resources tab
        populateResourcesTab(chartData, namespace);
    }
    
    // Populate Release tab
    function populateReleaseTab(chartData, releaseName, namespace) {
        const tbody = document.getElementById('release-info-tbody');
        const statusClass = chartData.status === 'deployed' 
            ? 'text-bg-success' 
            : 'text-bg-danger';
        
        tbody.innerHTML = `
            <tr>
                <th>Name:</th>
                <td>${escapeHtml(releaseName)}</td>
            </tr>
            <tr>
                <th>Namespace:</th>
                <td>
                    <a href="/cluster/namespace?namespace=${encodeURIComponent(namespace)}">${escapeHtml(namespace)}</a>
                </td>
            </tr>
            <tr>
                <th>Status:</th>
                <td>
                    <span class="badge text-bg-tag ${statusClass}">${escapeHtml(chartData.status || 'unknown')}</span>
                </td>
            </tr>
            <tr>
                <th>Revision:</th>
                <td>${chartData.release_version || ''}</td>
            </tr>
            <tr>
                <th>Chart Version:</th>
                <td>${escapeHtml(chartData.chart_name || '')}-${escapeHtml(chartData.chart_version || '')}</td>
            </tr>
            <tr>
                <th>App Version:</th>
                <td>${escapeHtml(chartData.app_version || '')}</td>
            </tr>
            <tr>
                <th>Created:</th>
                <td>${escapeHtml(chartData.updated || '')}</td>
            </tr>
        `;
    }
    
    // Populate Values tab
    function populateValuesTab(chartData) {
        const codeElement = document.getElementById('values-code').querySelector('code');
        if (chartData.values) {
            codeElement.textContent = chartData.values;
            codeElement.className = 'language-yaml';
            
            // Apply syntax highlighting
            setTimeout(function() {
                if (typeof hljs !== 'undefined') {
                    hljs.highlightElement(codeElement);
                }
            }, 100);
        } else {
            codeElement.textContent = 'No values available';
        }
    }
    
    // Populate Manifests tab
    function populateManifestsTab(chartData) {
        const codeElement = document.getElementById('manifests-code').querySelector('code');
        if (chartData.manifests) {
            codeElement.textContent = chartData.manifests;
            codeElement.className = 'language-yaml';
            
            // Apply syntax highlighting
            setTimeout(function() {
                if (typeof hljs !== 'undefined') {
                    hljs.highlightElement(codeElement);
                }
            }, 100);
        } else {
            codeElement.textContent = 'No manifests available';
        }
    }
    
    // Populate Resources tab
    function populateResourcesTab(chartData, namespace) {
        const tbody = document.getElementById('resources-tbody');
        let resourcesHtml = '';
        
        console.log('Populating resources tab with chartData:', chartData);
        
        // Helper function to create resource row
        function addResourceRow(resourceType, resourceName, resourceUrl) {
            resourcesHtml += `
                <tr>
                    <td>${escapeHtml(resourceType)}</td>
                    <td>
                        <a href="${escapeHtml(resourceUrl)}?namespace=${encodeURIComponent(namespace)}&selected=${encodeURIComponent(resourceName)}">${escapeHtml(resourceName)}</a>
                    </td>
                </tr>
            `;
        }
        
        // Helper function to add resources from array
        function addResourcesFromArray(resourceType, resourceArray, resourceUrl) {
            if (resourceArray && Array.isArray(resourceArray) && resourceArray.length > 0) {
                console.log(`Adding ${resourceArray.length} ${resourceType}:`, resourceArray);
                resourceArray.forEach(name => {
                    if (name) {
                        addResourceRow(resourceType, name, resourceUrl);
                    }
                });
            } else {
                console.log(`No ${resourceType} found or empty array:`, resourceArray);
            }
        }
        
        // Add all resources
        addResourcesFromArray('Deployment', chartData.deployments, '/workload/deployments');
        addResourcesFromArray('Daemonset', chartData.daemonset, '/workload/daemonsets');
        addResourcesFromArray('Stateful Set', chartData.statefulsets, '/workload/statefulsets');
        addResourcesFromArray('Service', chartData.services, '/network/service');
        addResourcesFromArray('Ingress', chartData.ingresses, '/network/ingress');
        addResourcesFromArray('Service Account', chartData.service_accounts, '/cluster-permission/service-account');
        addResourcesFromArray('Secret', chartData.secrets, '/security/secret');
        addResourcesFromArray('Configmap', chartData.configmaps, '/storage/configmap');
        addResourcesFromArray('Persistent Volume Claim', chartData.persistent_volume_claims, '/storage/pvc');
        
        console.log('Total resources HTML length:', resourcesHtml.length);
        
        if (resourcesHtml === '') {
            console.warn('No resources found via label selector. This may mean resources use different labels.');
            console.warn('You can check the Manifests tab to see all resources created by this Helm release.');
            tbody.innerHTML = `
                <tr>
                    <td colspan="2" class="text-center">
                        <p>No resources found via label selector.</p>
                        <p class="text-muted small">
                            Resources may use different labels than expected.<br>
                            Check the <strong>Manifests</strong> tab to see all resources created by this Helm release.
                        </p>
                    </td>
                </tr>
            `;
        } else {
            tbody.innerHTML = resourcesHtml;
        }
    }
    
    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
        loadChartData();
    });
</script>
{% endblock %}
