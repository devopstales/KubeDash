{% extends "base2.html.j2" %}

{% block topmenu %}
<ul class="header-nav d-lg-flex m-3">
    <div class="container-fluid px-4">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb my-0">
          <li class="breadcrumb-item"><span>Plugins</span></li>
          <li class="breadcrumb-item"><a href="/plugins/registry">Registry</a></li>
          <li class="breadcrumb-item active"><span>Images</span></li>
        </ol>
      </nav>
    </div>
</ul>
<ul class="header-nav ms-auto"></ul>
<ul class="header-nav d-lg-flex">
{% include "segments/partials/topmenu.html.j2" %}
{% endblock %}

{% block content %}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Image List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                      <th>Image</th>
                    </tr>
                </thead>
                <tbody id="images-tbody">
                    <tr>
                        <td colspan="1" class="text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-2">Loading images...</span>
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>
{% endblock %}

{% block add_head_css %}
{% include "segments/components/datatable_snippet.html.j2" %}
{% endblock %}

{% block add_tail_js %}
<script nonce="{{ csp_nonce }}">
    // IMMEDIATE: Prevent datatables-demo.js from initializing on loading row
    (function() {
        function setupOverride() {
            if (typeof $ !== 'undefined' && $.fn && !window._datatableOverrideSetup) {
                window._datatableOverrideSetup = true;
                
                const originalDataTable = $.fn.DataTable;
                $.fn.DataTable = function(options) {
                    const table = this[0];
                    if (table && table.id === 'dataTable') {
                        const tbody = table.querySelector('tbody');
                        if (tbody) {
                            const rows = tbody.querySelectorAll('tr');
                            const hasColspanRow = Array.from(rows).some(row => {
                                const cells = row.querySelectorAll('td');
                                return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                            });
                            if (hasColspanRow) {
                                console.log('Blocked DataTable initialization on loading row');
                                return this;
                            }
                        }
                    }
                    return originalDataTable.apply(this, arguments);
                };
                
                Object.setPrototypeOf($.fn.DataTable, originalDataTable);
                Object.keys(originalDataTable).forEach(key => {
                    $.fn.DataTable[key] = originalDataTable[key];
                });
            }
        }
        
        setupOverride();
        setTimeout(setupOverride, 0);
        setTimeout(setupOverride, 50);
        setTimeout(setupOverride, 100);
        setTimeout(setupOverride, 200);
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupOverride);
        } else {
            setupOverride();
        }
    })();
    
    // Escape HTML helper
    function escapeHtml(text) {
        if (!text) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.toString().replace(/[&<>"']/g, m => map[m]);
    }
    
    // Get registry server URL from sessionStorage or URL params
    function getRegistryServerUrl() {
        // Try URL query parameter first (most reliable)
        const urlParams = new URLSearchParams(window.location.search);
        const fromUrl = urlParams.get('registry_server_url');
        if (fromUrl) {
            // Store in sessionStorage for consistency
            sessionStorage.setItem('registry_server_url', fromUrl);
            return fromUrl;
        }
        
        // Try sessionStorage (set by previous page)
        const fromStorage = sessionStorage.getItem('registry_server_url');
        if (fromStorage) {
            return fromStorage;
        }
        
        return null;
    }
    
    // Populate images table
    function populateImagesTable(images, selectedImage, registryServerUrl) {
        const tbody = document.getElementById('images-tbody');
        const table = document.getElementById('dataTable');
        
        // Destroy existing DataTable if it exists
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            try {
                const $table = $('#dataTable');
                if ($table.length && typeof $.fn.DataTable.isDataTable === 'function' && $.fn.DataTable.isDataTable('#dataTable')) {
                    $table.DataTable().destroy();
                }
            } catch (e) {
                console.warn('Error destroying DataTable:', e);
            }
        }
        
        if (!images || images.length === 0) {
            tbody.innerHTML = '<tr><td colspan="1" class="text-center">No images found</td></tr>';
            return;
        }
        
        const rows = images.map(image => {
            const imageName = image.name || image;
            const imageNameEscaped = escapeHtml(imageName);
            const isSelected = selectedImage === imageName;
            const rowClass = isSelected ? 'selected' : '';
            
            // Encode image name for use in query parameter
            const imageNameEncoded = encodeURIComponent(imageName);
            const registryUrlEncoded = encodeURIComponent(registryServerUrl);
            
            return `
                <tr class="${rowClass}">
                    <td>
                        <a href="#" class="nav-link" data-image-name="${imageNameEscaped}" data-registry-url="${registryServerUrl}" data-image-name-encoded="${imageNameEncoded}" data-registry-url-encoded="${registryUrlEncoded}">${imageNameEscaped}</a>
                    </td>
                </tr>
            `;
        }).join('');
        
        tbody.innerHTML = rows;
        
        // Initialize DataTables after a short delay
        setTimeout(function() {
            const finalTable = document.getElementById('dataTable');
            if (finalTable && typeof $ !== 'undefined' && $.fn.DataTable) {
                try {
                    const $table = $('#dataTable');
                    
                    if (typeof $.fn.DataTable.isDataTable === 'function' && $.fn.DataTable.isDataTable('#dataTable')) {
                        $table.DataTable().destroy();
                    }
                    
                    // Verify table structure
                    const tbody = finalTable.querySelector('tbody');
                    if (tbody) {
                        const rows = tbody.querySelectorAll('tr');
                        let hasValidRows = false;
                        for (const row of rows) {
                            const cells = row.querySelectorAll('td');
                            if (cells.length === 1) {
                                hasValidRows = true;
                                break;
                            }
                        }
                        
                        if (hasValidRows) {
                            const validRowCount = Array.from(rows).filter(row => {
                                const cells = row.querySelectorAll('td');
                                return cells.length === 1;
                            }).length;
                            
                            if (validRowCount > 0) {
                                $('#dataTable').DataTable({
                                    responsive: true,
                                    pageLength: 25,
                                    destroy: true
                                });
                                console.log('DataTables initialized successfully with', validRowCount, 'rows');
                            }
                        }
                    }
                } catch (e) {
                    console.warn('Error initializing DataTable:', e);
                }
            }
        }, 100);
    }
    
    // Load images from API
    async function loadImages() {
        try {
            const registryServerUrl = getRegistryServerUrl();
            
            if (!registryServerUrl) {
                throw new Error('Registry server URL not found. Please select a registry server first.');
            }
            
            // Store in sessionStorage for consistency
            sessionStorage.setItem('registry_server_url', registryServerUrl);
            
            // Encode the URL for the API path
            const encodedUrl = encodeURIComponent(registryServerUrl);
            const apiUrl = `/api/v1/plugins/registry/${encodedUrl}/images`;
            console.log('Fetching images from:', apiUrl);
            
            const response = await fetch(apiUrl);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            console.log('Images API response:', result);
            
            if (result.error) {
                throw new Error(result.message || 'Failed to load images');
            }
            
            const images = result.data || [];
            const selectedImage = new URLSearchParams(window.location.search).get('selected');
            // Use registryServerUrl from metadata if available, otherwise use the one we already have
            const finalRegistryUrl = result.metadata?.registry_server_url || registryServerUrl;
            
            populateImagesTable(images, selectedImage, finalRegistryUrl);
            
        } catch (error) {
            console.error('Error loading images:', error);
            const tbody = document.getElementById('images-tbody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="1" class="text-center text-danger">Error loading images: ' + escapeHtml(error.message) + '</td></tr>';
            }
        }
    }
    
    // Load data on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Destroy any auto-initialized DataTable instance
        const table = document.getElementById('dataTable');
        if (table && typeof $ !== 'undefined' && $.fn.DataTable) {
            if ($.fn.DataTable.isDataTable && $.fn.DataTable.isDataTable(table)) {
                const tbody = table.querySelector('tbody');
                if (tbody) {
                    const rows = tbody.querySelectorAll('tr');
                    const hasColspanRow = Array.from(rows).some(row => {
                        const cells = row.querySelectorAll('td');
                        return Array.from(cells).some(cell => cell.hasAttribute('colspan'));
                    });
                    if (hasColspanRow) {
                        console.log('Destroying auto-initialized DataTable instance on loading row');
                        $(table).DataTable().destroy();
                    }
                }
            }
        }
        
        loadImages();

        // Event delegation for navigation links
        document.addEventListener('click', function(e) {
            const navLink = e.target.closest('.nav-link');
            if (navLink) {
                e.preventDefault();
                const imageName = navLink.getAttribute('data-image-name');
                const registryUrl = navLink.getAttribute('data-registry-url');
                const imageNameEncoded = navLink.getAttribute('data-image-name-encoded');
                const registryUrlEncoded = navLink.getAttribute('data-registry-url-encoded');
                if (imageName && registryUrl) {
                    sessionStorage.setItem('image_name', imageName);
                    sessionStorage.setItem('registry_server_url', registryUrl);
                    window.location.href = '/plugins/registry/image/tags?registry_server_url=' + registryUrlEncoded + '&image_name=' + imageNameEncoded;
                }
            }
        });
    });
</script>
{% endblock %}