+                      <CTable bordered small className="mb-0">
+                        <thead>
+                          <tr>
+                            <th>Key</th>
+                            <th>Value</th>
+                          </tr>
+                        </thead>
+                        <tbody>
+                          {annotations.map(([key, value]) => (
