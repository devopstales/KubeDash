+test('data-renders-detail', async () => {
+  const urls: string[] = []
+  let searchParams = new URLSearchParams()
+  server.use(
+    http.get('*/api/v1/clusters/1/resources/limitranges', ({ request }) => {
+      const u = new URL(request.url)
