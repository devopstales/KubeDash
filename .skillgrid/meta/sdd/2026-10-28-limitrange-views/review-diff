+const limitsSnake = {
+  ...limits,
+  spec: {
+    limits: [
+      {
+        type: 'Container',
+        max: { cpu: '2', memory: '4Gi' },
+        min: { cpu: '500m', memory: '1Gi' },
+        default: { cpu: '1', memory: '2Gi' },
+        default_request: { cpu: '250m', memory: '512Mi' },
+        max_limit_request_ratio: { cpu: '2', memory: '4' },
+      },
+    ],
+  },
+}
